load("//:build/wd_test.bzl", "wd_test")
load("//src/pyodide/tests:py_wd_test.bzl", "py_wd_test")

# The bundled D1 Worker runs these tests too.
exports_files(
    ["d1-api-test-common.js"],
    visibility = ["//src/workerd/server/tests/d1:__pkg__"],
)

wd_test(
    src = "d1-api-test-jsrpc-contract.wd-test",
    args = ["--experimental"],
    data = [
        "d1-api-test-jsrpc-contract.js",
        "d1-mock.js",
    ],
)

wd_test(
    size = "large",
    src = "d1-api-test.wd-test",
    args = ["--experimental"],
    data = glob(
        ["*.js"],
        exclude = ["d1-api-test-with-sessions.js"],
    ) + ["//src/cloudflare/internal/test:instrumentation-test-helper.js"],
)

wd_test(
    size = "large",
    src = "d1-api-test-jsrpc.wd-test",
    args = ["--experimental"],
    data = glob(
        ["*.js"],
        exclude = ["d1-api-test-with-sessions.js"],
    ) + ["//src/cloudflare/internal/test:instrumentation-test-helper.js"],
)

wd_test(
    size = "enormous",
    src = "d1-api-test-with-sessions.wd-test",
    args = ["--experimental"],
    data = glob(["*.js"]),
)

wd_test(
    size = "enormous",
    src = "d1-api-test-with-sessions-jsrpc.wd-test",
    args = ["--experimental"],
    data = glob(["*.js"]),
)

py_wd_test(
    size = "large",
    src = "python-d1-api-test.wd-test",
    args = ["--experimental"],
    data = glob([
        "*.py",
        "*.js",
    ]),
    make_snapshot = False,
    use_snapshot = None,
)
