using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "hyperdrive-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "hyperdrive-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "rpc"],
        bindings = [
          ( name = "HYPERDRIVE_PG",
            wrapped = (
              moduleName = "cloudflare-internal:hyperdrive-postgres-api",
              innerBindings = [
                (name = "fetcher", service = "hyperdrive-mock"),
              ],
            )
          ),
          ( name = "HYPERDRIVE_MYSQL",
            wrapped = (
              moduleName = "cloudflare-internal:hyperdrive-mysql-api",
              innerBindings = [
                (name = "fetcher", service = "hyperdrive-mock"),
              ],
            )
          ),
          ( name = "RECEIVER",
            service = (name = "hyperdrive-test", entrypoint = "Receiver") ),
        ],
      )
    ),
    ( name = "hyperdrive-mock",
      worker = (
        modules = [
          (name = "worker", esModule = embed "hyperdrive-mock.js")
        ],
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
  ],
);
