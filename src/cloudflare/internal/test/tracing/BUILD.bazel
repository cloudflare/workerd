load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@otel_api_1_10__links//:defs.bzl", link_api_1_10 = "npm_link_imported_package")
load("@otel_api_1_9__links//:defs.bzl", link_api_1_9 = "npm_link_imported_package")
load("//:build/wd_test.bzl", "wd_test")

# Bundle independent real API copies to exercise their global/version handshake with the runtime.
# Links are local to this test package and cannot change another fixture's optional peers.
link_api_1_9()

link_api_1_10()

[
    esbuild(
        name = "opentelemetry-api-" + version,
        entry_point = "opentelemetry-api-" + version + "-entry.js",
        format = "esm",
        output = "opentelemetry-api-" + version + ".0.js",
        sourcemap = False,
        target = "esnext",
        deps = [":node_modules/@opentelemetry/api-" + version],
    )
    for version in [
        "1.9",
        "1.10",
    ]
]

esbuild(
    name = "opentelemetry-api-1.11",
