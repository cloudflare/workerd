load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("//:build/wd_test.bzl", "wd_test")

# Bundle independent real API copies to exercise their global/version handshake with the runtime.
# Tarballs are declared only in the standalone module; downstream builds exclude their consumers.
# Links are local to this test package and cannot change another fixture's optional peers.
# These targets rely on tag filters in embedders: tools that ignore the filters, such as
# bazel query 'deps(...)' or :all-targets, will fail on the standalone-only repository labels.
[
    npm_link_package(
        name = "node_modules/@opentelemetry/api-" + version,
        src = "@otel_api_" + version.replace(".", "_") + "//:pkg",
        package = "@opentelemetry/api-" + version,
        tags = ["no-downstream"],
        version = version + ".0",
    )
    for version in [
        "1.9",
        "1.10",
    ]
]

[
    esbuild(
        name = "opentelemetry-api-" + version,
        entry_point = "opentelemetry-api-" + version + "-entry.js",
        format = "esm",
        output = "opentelemetry-api-" + version + ".0.js",
        sourcemap = False,
        tags = ["no-downstream"],
        target = "esnext",
        deps = [":node_modules/@opentelemetry/api-" + version],
    )
    for version in [
        "1.9",
        "1.10",
    ]
]

esbuild(
    name = "opentelemetry-api-1.11",
    config = "opentelemetry-incompatible-api.esbuild.mjs",
    entry_point = "opentelemetry-api-1.10-entry.js",
    format = "esm",
    output = "opentelemetry-api-1.11.0.js",
    sourcemap = False,
    tags = ["no-downstream"],
    target = "esnext",
    deps = [":node_modules/@opentelemetry/api-1.10"],
)

OTEL_API_BUNDLES = [
    ":opentelemetry-api-1.9",
    ":opentelemetry-api-1.10",
    ":opentelemetry-api-1.11",
]

# Entry points are esbuild inputs, never embedded test modules. Exclude them so ESLint does
# not register copy actions that conflict with the no-downstream bundles' copies.
TEST_JS = glob(
    ["*.js"],
    exclude = ["*-entry.js"],
)

wd_test(
    src = "opentelemetry-roots-test.wd-test",
    args = ["--experimental"],
    data = TEST_JS + OTEL_API_BUNDLES,
    tags = ["no-downstream"],
)

wd_test(
    src = "opentelemetry-http-policy-test.wd-test",
    args = ["--experimental"],
    data = TEST_JS + OTEL_API_BUNDLES + ["//src/cloudflare/internal/test:instrumentation-test-helper.js"],
    tags = ["no-downstream"],
)

