using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "opentelemetry-test", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-test.js")],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat", "streams_enable_constructors"],
      streamingTails = ["tail"],
      bindings = [
        (name = "fetchTarget", service = "mock"),
        (name = "serviceWorker", service = "service-worker"),
        (name = "newServiceWorker", service = "new-service-worker"),
      ],
    )),
    ( name = "without-node-compat", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-no-node-test.js")],
      compatibilityFlags = ["opentelemetry_api"],
      streamingTails = ["tail"],
    )),
    ( name = "mock", worker = (
      modules = [(name = "worker", esModule = embed "tracing-hierarchy-mock.js")],
    )),
    ( name = "untraced", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-untraced-test.js")],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat"],
    )),
    ( name = "new-registry", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-no-node-test.js")],
      compatibilityFlags = ["opentelemetry_api", "new_module_registry"],
      streamingTails = ["tail"],
    )),
    ( name = "service-worker", worker = (
      serviceWorkerScript = embed "opentelemetry-service-worker-test.js",
      compatibilityFlags = ["opentelemetry_api"],
      bindings = [(name = "expectedRegistration", json = "false")],
    )),
    ( name = "new-service-worker", worker = (
      serviceWorkerScript = embed "opentelemetry-service-worker-test.js",
      compatibilityFlags = ["opentelemetry_api", "new_module_registry"],
      bindings = [(name = "expectedRegistration", json = "true")],
    )),
    ( name = "real-api", worker = (
      modules = [
        (name = "worker", esModule = embed "opentelemetry-real-api-test.js"),
        (name = "@opentelemetry/api", esModule = embed "opentelemetry-api-1.10.0.js"),
      ],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat"],
      streamingTails = ["tail"],
    )),
    ( name = "real-api-1.9", worker = (
      modules = [
        (name = "worker", esModule = embed "opentelemetry-real-api-test.js"),
        (name = "@opentelemetry/api", esModule = embed "opentelemetry-api-1.9.0.js"),
      ],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat"],
      streamingTails = ["tail"],
    )),
    ( name = "overlapping", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-do-test.js")],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat", "streams_enable_constructors"],
      streamingTails = ["tail"],
      durableObjectNamespaces = [(className = "Overlapping", uniqueKey = "otel-overlap")],
      durableObjectStorage = (inMemory = void),
      bindings = [(name = "OVERLAPPING", durableObjectNamespace = "Overlapping")],
    )),
    ( name = "disabled", worker = (
      modules = [
        (name = "worker", esModule = embed "opentelemetry-disable-test.js"),
        (name = "@opentelemetry/api", esModule = embed "opentelemetry-api-1.10.0.js"),
      ],
      compatibilityFlags = ["opentelemetry_api", "nodejs_compat"],
    )),
    ( name = "tail", worker = (
      modules = [
        (name = "worker", esModule = embed "opentelemetry-instrumentation-test.js"),
        (name = "instrumentation-test-helper", esModule = embed "../instrumentation-test-helper.js"),
      ],
      compatibilityFlags = ["nodejs_compat"],
    )),
    ( name = "unregistered", worker = (
      modules = [(name = "worker", esModule = "export const noRegistration = { test() { if (globalThis[Symbol.for('opentelemetry.js.api.1')] !== undefined) throw new Error('unexpected registration'); } };" )],
    )),
  ],
);
