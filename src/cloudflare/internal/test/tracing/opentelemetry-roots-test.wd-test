using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    (name = "driver", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-roots-driver.js")],
      compatibilityFlags = ["nodejs_compat"],
      bindings = [(name = "ON", service = "http-on"), (name = "BUFFERED", service = "http-buffered"), (name = "UNTRACED", service = "http-untraced")],
    )),
    (name = "on", worker = (
      modules = .modules,
      compatibilityFlags = ["nodejs_compat", "opentelemetry_api", "rpc"],
