      bindings = [(name = "CALLEE", service = "callee")],
    )),
    (name = "buffered", worker = (
      modules = .modules,
      compatibilityFlags = ["nodejs_compat", "opentelemetry_api"],
      tails = ["buffered-tail"],
      globalOutbound = "http-echo",
    )),
    (name = "untraced", worker = (
      modules = .modules,
      compatibilityFlags = ["nodejs_compat", "opentelemetry_api"],
      globalOutbound = "http-echo",
    )),
    (name = "callee", worker = (
      modules = .modules,
      compatibilityFlags = ["nodejs_compat", "opentelemetry_api", "rpc"],
      streamingTails = ["tail"],
    )),
    (name = "echo", worker = (modules = [(name = "worker", esModule = "export default { fetch(r) { return Response.json(Object.fromEntries(r.headers)); } };")])),
    (name = "tail", worker = (
      modules = [(name = "worker", esModule = embed "opentelemetry-roots-tail.js")],
      compatibilityFlags = ["nodejs_compat"],
    )),
    (name = "buffered-tail", worker = (modules = [(name = "worker", esModule = "export default { tail() {} };")])),
    (name = "http-on", external = (address = "loopback:roots-on", http = ())),
    (name = "http-buffered", external = (address = "loopback:roots-buffered", http = ())),
    (name = "http-untraced", external = (address = "loopback:roots-untraced", http = ())),
    (name = "http-echo", external = (address = "loopback:roots-echo", http = ())),
  ],
  sockets = [
    (name = "on", address = "loopback:roots-on", http = (), service = "on"),
    (name = "buffered", address = "loopback:roots-buffered", http = (), service = "buffered"),
    (name = "untraced", address = "loopback:roots-untraced", http = (), service = "untraced"),
    (name = "echo", address = "loopback:roots-echo", http = (), service = "echo"),
