    (name = "http-on", external = (address = "loopback:otel-http-on", http = ())),
    (name = "http-off", external = (address = "loopback:otel-http-off", http = ())),
    (name = "http-untraced", external = (address = "loopback:otel-http-untraced", http = ())),
    (name = "http-echo", external = (address = "loopback:otel-http-echo", http = ())),
    (name = "tail", worker = (
      modules = [
        (name = "worker", esModule = embed "opentelemetry-http-tail.js"),
        (name = "instrumentation-test-helper", esModule = embed "../instrumentation-test-helper.js"),
