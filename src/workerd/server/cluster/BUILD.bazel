load("//:build/wd_capnp_library.bzl", "wd_capnp_library")
load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

# Durable Objects whose shared state is a bucket, S3-compatible or Cloud
# Storage. Pure Rust: the server (//src/workerd/server/server) drives it.
wd_rust_crate(
    name = "cluster",
    proc_macro_deps = ["@crates_vendor//:async-trait"],
    # A throwaway service account key, for the Cloud Storage client's tests.
    test_compile_data = ["google_auth-test.pem"],
    # The capture's tests drive a real SQLite; the bucket client's tests
    # talk to a hyper server.
    test_deps = [
        "@crates_vendor//:hyper",
        "@sqlite3",
    ],
    # The alarm simulation and the log tests outrun a medium test's 15 s
    # under ASan.
    test_size = "large",
    # The capture's tests hand SQLite Rust callbacks, which a downstream
    # build's cfi-icall rejects.
    test_tags = ["no-downstream"],
    visibility = ["//src/workerd/server:__subpackages__"],
    deps = [
        ":frames_capnp_rust",
        "//src/workerd/server:workerd_capnp_rust",
        "//src/workerd/server/cluster/logic:cluster-logic",
        "@crates_vendor//:base64",
        "@crates_vendor//:bytes",
        "@crates_vendor//:capnp",
        "@crates_vendor//:flate2",
        "@crates_vendor//:futures",
        "@crates_vendor//:http",
        "@crates_vendor//:http-body",
        "@crates_vendor//:httpdate",
        "@crates_vendor//:hyper-util",
        "@crates_vendor//:nix",
        "@crates_vendor//:ring",
        "@crates_vendor//:rustls",
        "@crates_vendor//:rustls-platform-verifier",
        "@crates_vendor//:serde",
        "@crates_vendor//:serde_json",
        "@crates_vendor//:thiserror",
        "@crates_vendor//:tokio",
        "@crates_vendor//:tokio-rustls",
        "@crates_vendor//:tower-service",
        "@crates_vendor//:tracing",
    ],
)

# The format of an object's log in the bucket.
wd_capnp_library(src = "frames.capnp")
