load("//:build/kj_test.bzl", "kj_test")
load("//:build/linking.bzl", "CC_LIBRARY_LINKSTATIC")
load("//:build/wd_cc_library.bzl", "wd_cc_library")

package(default_visibility = ["//src/workerd/server:__subpackages__"])

# The REPL's JavaScript API (the `workerd` global and the loaded-config handle), which the workerd
# API isolate registers (//src/workerd/server:workerd-api).
wd_cc_library(
    name = "repl-api",
    srcs = ["repl-api.c++"],
    hdrs = ["repl-api.h"],
    deps = [
        "//src/workerd/io",
        "//src/workerd/jsg",
    ],
)

# The environment REPL input is evaluated in, and the servers of the configs it loads.
wd_cc_library(
    name = "repl-environment",
    srcs = [
        "repl-environment.c++",
        "repl-server.c++",
    ],
    hdrs = [
        "repl-environment.h",
        "repl-server.h",
    ],
    deps = [
        ":repl-api",
        "//src/rust/cxx/kj-rs",
        "//src/workerd/api:memory-cache",
        "//src/workerd/io",
        "//src/workerd/io:bundle-fs",
        "//src/workerd/jsg",
        "//src/workerd/server:workerd-api",
        "//src/workerd/server:workerd_capnp",
        "//src/workerd/server/factory:single-tenant-policy",
        "//src/workerd/server/factory:worker-factory",
        "//src/workerd/server/server:bridge.rs@cxx",
        "@capnp-cpp//src/capnp/compat:http-over-capnp",
        "@capnp-cpp//src/kj/compat:kj-http",
    ],
)

# The declarations the command line's REPL bridge (//src/workerd/server:cli/repl/bridge.rs) needs.
# Header-only: the bridge library depends on it, and :repl depends on the bridge library.
wd_cc_library(
    name = "repl-hdrs",
    hdrs = ["repl.h"],
    deps = [
        "//src/rust/cxx/kj-rs",
        "@capnp-cpp//src/kj:kj-async-core",
    ],
)

# The C++ half of `workerd repl`, which the command line (//src/workerd/server:workerd-cli) links.
wd_cc_library(
    name = "repl",
    srcs = ["repl.c++"],
    linkstatic = CC_LIBRARY_LINKSTATIC,
    deps = [
        ":repl-environment",
        ":repl-hdrs",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-io:kj-rs-io-lib",
        "//src/rust/cxx/kj-rs-tokio:kj-rs-tokio-lib",
        "//src/workerd/jsg",
        "//src/workerd/server:cli/repl/bridge.rs@cxx",
        "//src/workerd/server:v8-platform-impl",
        "//src/workerd/util:autogate",
        "//src/workerd/util:entropy",
    ],
)

kj_test(
    size = "large",
    src = "repl-environment-test.c++",
    deps = [
        ":repl-environment",
        "//src/workerd/server/server:workerd-server",
        "//src/workerd/util:autogate",
        "//src/workerd/util:entropy",
    ],
)
