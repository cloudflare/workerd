load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//:build/wd_test.bzl", "wd_test")

wd_test(
    src = "ratelimit-test.wd-test",
    args = ["--experimental"],
    data = ["ratelimit-test.js"],
)

# `workerd serve` of a wrangler.jsonc's ratelimits.
# Large: it may wait up to 5 s for a minute's last seconds to pass.
js_test(
    name = "ratelimit-wrangler-test",
    size = "large",
    data = [
        "//src/workerd/server:workerd",
        "//src/workerd/server/tests:wrangler-serve_js_lib",
    ],
    entry_point = "ratelimit-wrangler-test.mjs",
    env = {"WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)"},
    tags = ["js-test"],
)
