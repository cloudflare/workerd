const unitTests :Workerd.Config = (
  services = [
    ( name = "pywavelets-vendor-test",
      worker = (
        %COMPAT_DATE,
        modules = [
          (name = "main.py", pythonModule = embed "pywavelets.py"),
          %PYTHON_VENDORED_MODULES%
        ],
        compatibilityFlags = [%PYTHON_FEATURE_FLAGS, "disable_python_no_global_handlers"],
      )
    ),
  ],
);
