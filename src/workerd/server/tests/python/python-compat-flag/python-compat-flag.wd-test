  services = [
    ( name = "python-compat-flag",
      worker = (
        %COMPAT_DATE,
        modules = [
          (name = "worker.py", pythonModule = embed "worker.py"),
        ],
        compatibilityFlags = [%PYTHON_FEATURE_FLAGS, "python_workflows", "disable_python_no_global_handlers"],
      )
    ),
  ],
);
