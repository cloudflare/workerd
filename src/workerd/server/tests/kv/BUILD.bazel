load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//:build/wd_test.bzl", "wd_test")

# Waits out the real blob grace period, seconds at a time.
wd_test(
    size = "large",
    src = "kv-test.wd-test",
    args = ["--experimental"],
    data = ["kv-test.js"],
    env = {"WORKERD_KV_TEST_CLOCK": "1"},
)

# `workerd serve` of a wrangler.jsonc's kv_namespaces.
js_test(
    name = "kv-wrangler-test",
    data = ["//src/workerd/server:workerd"],
    entry_point = "kv-wrangler-test.mjs",
    env = {"WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)"},
    tags = ["js-test"],
)
