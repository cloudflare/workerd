load("//:build/wd_js_test.bzl", "wd_js_test")
load("//:build/wd_test.bzl", "wd_test")

wd_test(
    src = "queues-test.wd-test",
    args = ["--experimental"],
    data = ["queues-test.js"],
)

# `workerd serve` of the queues module, killed and started again.
wd_js_test(
    name = "queues-restart-test",
    size = "medium",
    data = ["//src/workerd/server:workerd"],
    entry_point = "queues-restart-test.mjs",
    env = {"WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)"},
    tags = ["js-test"],
)

# `workerd serve --threads=4` of the queues module: messages sent through
# every thread, shards on threads but the first.
wd_js_test(
    name = "queues-threads-test",
    size = "large",
    data = ["//src/workerd/server:workerd"],
    entry_point = "queues-threads-test.mjs",
    env = {"WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)"},
    tags = ["js-test"],
)
