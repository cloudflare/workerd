load("//:build/wd_js_test.bzl", "wd_js_test")
load("//:build/wd_test.bzl", "wd_test")

wd_test(
    src = "d1-test.wd-test",
    args = ["--experimental"],
    data = [
        "d1-export-test.js",
        "d1-miniflare-test.js",
        "d1-test.js",
        "//src/cloudflare/internal/test/d1:d1-api-test-common.js",
    ],
)

# `workerd serve` of a wrangler.jsonc's d1_databases.
wd_js_test(
    name = "d1-wrangler-test",
    data = ["//src/workerd/server:workerd"],
    entry_point = "d1-wrangler-test.mjs",
    env = {"WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)"},
    tags = ["js-test"],
)
