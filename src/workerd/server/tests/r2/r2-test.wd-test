using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "TEST_TMPDIR", disk = (writable = true) ),
    ( name = "r2-test",
      worker = (
        modules = [ ( name = "worker", esModule = embed "r2-test.js" ) ],
        compatibilityFlags = ["nodejs_compat", "streams_enable_constructors"],
        bindings = [
          ( name = "BUCKET", r2Bucket = "test" ),
          ( name = "SAME", r2Bucket = "test" ),
          ( name = "OTHER", r2Bucket = "other" ),
          ( name = "R2", service = "test" ),
        ],
      )
    ),
    # Each bucket's objects in a local store in TEST_TMPDIR/r2/.
    ( name = "test",
      bucket = ( path = "r2/test", localDisk = "TEST_TMPDIR", r2 = true ) ),
    ( name = "other",
      bucket = ( path = "r2/other", localDisk = "TEST_TMPDIR", r2 = true ) ),
  ],
);
