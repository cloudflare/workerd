using Workerd = import "/workerd/workerd.capnp";

# A Worker whose top-level code throws. The zygote fails before anything is recorded or
# serialized, and the Worker starts without a snapshot, evaluating its top level itself, which
# reports the error. See startup-snapshot-console-test.mjs for what the output must look like.

const unitTests :Workerd.Config = (
  services = [
    ( name = "throws",
      worker = (
        modules = [(name = "worker", esModule = embed "throws.js")],
        compatibilityDate = "2025-09-01",
        compatibilityFlags = [
          "nodejs_compat",
          "typescript_implemented_streams",
          "experimental",
        ],
      )
    ),
  ],
  # typescript_implemented_streams needs the per-isolate bootstrap.
  autogates = [
    "workerd-autogate-startup-snapshot",
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
