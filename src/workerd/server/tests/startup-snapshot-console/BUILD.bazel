load("@aspect_rules_js//js:defs.bzl", "js_test")

# Top-level console output across the startup-snapshot zygote: `workerd test` is run on the
# config and its stdout/stderr are checked for every line to appear exactly once.
js_test(
    name = "startup-snapshot-console-test",
    data = [
        ":fallback.js",
        ":startup-snapshot-console.wd-test",
        ":used.js",
        "//src/workerd/server:workerd",
    ],
    entry_point = "startup-snapshot-console-test.mjs",
    env = {
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
        "WD_TEST_CONFIG": "$(rootpath :startup-snapshot-console.wd-test)",
    },
)
