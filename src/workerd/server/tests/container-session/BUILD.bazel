load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//build/bazelflare:exec_properties.bzl", "test_exec_properties")
load("//images/container-client-test:images.bzl", "CONTAINER_TEST_IMAGES")

_TAGS = [
    "js-test",
    "requires-container-engine",
    "requires-network",  # Accesses unix:///var/run/docker.sock
]

js_test(
    name = "container-session-test",
    size = "enormous",
    data = [
        ":config.capnp",
        ":worker.mjs",
        "//src/workerd/server:workerd",
        "//src/workerd/server/tests:server-harness_js_lib",
    ] + CONTAINER_TEST_IMAGES,
    entry_point = "test.mjs",
    env = {
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
        "WORKERD_CONFIG": "$(rootpath :config.capnp)",
    },
    exec_properties = test_exec_properties("enormous", _TAGS),
    tags = _TAGS,
)
