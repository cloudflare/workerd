using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "cache-test",
      worker = (
        modules = [ ( name = "worker", esModule = embed "cache-test.js" ) ],
        compatibilityFlags = ["nodejs_compat", "streams_enable_constructors"],
        cacheApiOutbound = "cache",
        bindings = [
          ( name = "CACHE", service = "cache" ),
          ( name = "DISK", service = "TEST_TMPDIR" ),
        ],
      )
    ),
    # The Cache API Worker, its entries on the disk the runner gives as -dTEST_TMPDIR.
    ( name = "cache",
      worker = (
        modules = [ ( name = "cache.js", bundled = "/workerd/cache.js" ) ],
        compatibilityFlags = ["streams_enable_constructors", "transformstream_enable_standard_constructor"],
        bindings = [
          ( name = "STORE", service = "TEST_TMPDIR" ),
          ( name = "TEST_CLOCK", json = "true" ),
        ],
      )
    ),
    ( name = "TEST_TMPDIR", disk = ( writable = true ) ),
  ],
);
