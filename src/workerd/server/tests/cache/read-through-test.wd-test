using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "read-through-test",
      worker = (
        modules = [ ( name = "worker", esModule = embed "read-through-test.js" ) ],
        compatibilityFlags = ["nodejs_compat"],
        bindings = [
          ( name = "CACHED", service = ( name = "TEST_TMPDIR", entrypoint = "ReadThrough" ) ),
          ( name = "ORIGIN", service = "origin" ),
        ],
      )
    ),
    # The Worker behind the cache, which counts its runs and purges.
    ( name = "origin",
      worker = (
        modules = [ ( name = "worker", esModule = embed "read-through-origin.js" ) ],
        compatibilityFlags = ["nodejs_compat"],
        cacheApiOutbound = "TEST_TMPDIR",
      )
    ),
    # The entries, in the directory the runner gives as -dTEST_TMPDIR, and Workers Caching in
    # front of `origin`.
    ( name = "TEST_TMPDIR", cache = ( userWorker = "origin" ) ),
  ],
);
