using Workerd = import "/workerd/workerd.capnp";

# The Workflow "flow", class `Flow` of "workflows-test", on the engine
# "workflows".
const flow :Workerd.ServiceDesignator = (
  name = "workflows",
  entrypoint = "WorkflowBinding",
  props = ( json = "{\"workflow\": \"flow\"}" ),
);

const unitTests :Workerd.Config = (
  services = [
    ( name = "TEST_TMPDIR", disk = (writable = true) ),
    ( name = "workflows-test",
      worker = (
        modules = [ ( name = "worker", esModule = embed "workflows-test.js" ) ],
        compatibilityFlags = ["nodejs_compat", "rpc", "streams_enable_constructors"],
        bindings = [
          ( name = "FLOW",
            wrapped = (
              moduleName = "cloudflare-internal:workflows-api",
              innerBindings = [ ( name = "fetcher", service = .flow ) ],
            ) ),
          ( name = "WORKFLOWS", service = "workflows" ),
        ],
        workflowsEngine = (
          actorClass = ( name = "workflows", entrypoint = "Engine" ),
          workflows = [
            ( className = "Flow", name = "flow", bindingService = .flow ) ],
        ),
      )
    ),
    ( name = "workflows",
      worker = (
        modules = [
          ( name = "workflows.js", bundled = "/workerd/workflows.js" ) ],
        compatibilityFlags = ["rpc", "streams_enable_constructors"],
        bindings = [
          ( name = "flow",
            durableObjectNamespace = (
              className = "miniflare-workflows-flow",
              serviceName = "workflows-test",
            ) ),
          ( name = "WORKFLOWS",
            json = "{\"flow\": {\"steps\": 3, \"retention\": {\"success\": \"2 days\"}}}" ),
          ( name = "TEST_CLOCK", json = "true" ),
        ],
        durableObjectStorage = ( localDisk = "TEST_TMPDIR" ),
      )
    ),
  ],
);
