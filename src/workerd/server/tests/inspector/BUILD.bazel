load("@aspect_rules_js//js:defs.bzl", "js_test")

js_test(
    name = "inspector-test",
    size = "large",
    data = [
        ":config.capnp",
        ":index.mjs",
        ":inspector-test-harness.mjs",
        "//:node_modules/chrome-remote-interface",
        "//src/workerd/server:workerd",
        "//src/workerd/server/tests:server-harness_js_lib",
    ],
    entry_point = "driver.mjs",
    env = {
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
        "WORKERD_CONFIG": "$(rootpath :config.capnp)",
    },
    tags = ["js-test"],
)

js_test(
    name = "inspector-profiler-test",
    size = "large",
    data = [
        ":config.capnp",
        ":index.mjs",
        ":inspector-test-harness.mjs",
        "//:node_modules/chrome-remote-interface",
        "//src/workerd/server:workerd",
        "//src/workerd/server/tests:server-harness_js_lib",
    ],
    entry_point = "profiler-driver.mjs",
    env = {
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
