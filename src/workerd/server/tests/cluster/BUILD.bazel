load("@aspect_rules_js//js:defs.bzl", "js_test")

# Two takeovers wait out a dead owner's 20 s lease. Downstream caps
# "eternal" at 240 s; add takeovers to the simulations instead. The tests
# run in shards that each stay well under that.
#
# The tests of deployments, whose names say "deploy", run in a target of their
# own. Each test runs a fake S3 and up to three nodes: on a loaded machine, a
# node starved for 12 s lets its lease lapse and leaves the cluster.
[js_test(
    name = name,
    size = "large",
    timeout = "eternal",
    data = [
        ":cluster-deployment.wd-test",
        ":cluster-node.wd-test",
        ":cluster-on-hibernate-worker.js",
        ":cluster-test.wd-test",
        ":cluster-worker.js",
        ":fake-s3.js",
        ":fake-s3.wd-test",
        "//src/workerd/server:workerd",
    ],
    entry_point = "cluster-test.mjs",
    env = {
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
        "WD_TEST_CONFIG": "$(rootpath :cluster-test.wd-test)",
        "FAKE_S3_CONFIG": "$(rootpath :fake-s3.wd-test)",
        "NODE_CONFIG": "$(rootpath :cluster-node.wd-test)",
        "DEPLOYMENT_CONFIG": "$(rootpath :cluster-deployment.wd-test)",
        "NODE_OPTIONS": "--test-{}-pattern=deploy".format(which),
    },
    shard_count = shards,
    tags = [
        "cpu:4",
        "js-test",
    ],
) for name, which, shards in [
    ("cluster-test", "skip", 3),
    ("cluster-deploy-test", "name", 1),
]]
