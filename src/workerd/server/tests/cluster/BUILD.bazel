load("//:build/wd_js_test.bzl", "wd_js_test")

# One suite, split by test name: cluster-test, and cluster-cron-test, whose
# config runs a cron trigger. Each runs in shards, each of which should take
# well under 20 s: each test starts a cluster of its own, which takes a
# second under TSan, the takeovers wait out a dead owner's lease, a quarter
# of the default in cluster-test.wd-test, and the drain tests wait out stop
# deadlines. `COSTS` in cluster-test.mjs spreads those evenly across the
# shards. Add takeovers to the simulations instead.
[wd_js_test(
    name = name,
    size = "large",
    data = [
        ":cluster-broken-deployments.wd-test",
        ":cluster-broken-node.wd-test",
        ":cluster-cache-worker.js",
        ":cluster-cron.wd-test",
        ":cluster-deployment.wd-test",
        ":cluster-node.wd-test",
        ":cluster-on-hibernate-worker.js",
        ":cluster-router.js",
        ":cluster-test.wd-test",
        ":cluster-worker.js",
        ":fake-s3.mjs",
        "//src/workerd/server:workerd",
    ],
    entry_point = "cluster-test.mjs",
    env = {
        "CLUSTER_TESTS": tests,
        "WORKERD_BINARY": "$(rootpath //src/workerd/server:workerd)",
        "WD_TEST_CONFIG": "$(rootpath :%s)" % config,
        "NODE_CONFIG": "$(rootpath :cluster-node.wd-test)",
        "DEPLOYMENT_CONFIG": "$(rootpath :cluster-deployment.wd-test)",
        "BROKEN_NODE_CONFIG": "$(rootpath :cluster-broken-node.wd-test)",
        "BROKEN_DEPLOYMENTS_CONFIG": "$(rootpath :cluster-broken-deployments.wd-test)",
    },
    shard_count = shards,
    tags = ["js-test"],
) for name, tests, config, shards in [
    ("cluster-test", "^(?!cluster: a cron)", "cluster-test.wd-test", 16),
    ("cluster-cron-test", "^cluster: a cron", "cluster-cron.wd-test", 2),
]]
