# A deployment: services only. Its Durable Objects are stored on the disk the node's config
# (cluster-node.wd-test) defines, which it names.

using Workerd = import "/workerd/workerd.capnp";

const deployment :Workerd.Config = (
  services = [
    ( name = "main",
      worker = (
        modules = [
          ( name = "cluster-worker.js", esModule = embed "cluster-worker.js" ),
        ],
        compatibilityDate = "2026-01-01",
        compatibilityFlags = ["nodejs_compat", "allow_irrevocable_stub_storage"],
        bindings = [
          ( name = "COUNTER", durableObjectNamespace = "Counter" ),
        ],
        durableObjectNamespaces = [
          ( className = "Counter", uniqueKey = "deployed-counter-namespace" ),
        ],
        durableObjectStorage = ( localDisk = "do-storage" ),
      )
    ),
  ],
);
