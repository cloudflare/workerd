# The bucket for cluster-test: fake-s3.js on an ephemeral port, in memory.

using Workerd = import "/workerd/workerd.capnp";

const config :Workerd.Config = (
  services = [
    ( name = "s3",
      worker = (
        modules = [
          ( name = "fake-s3.js", esModule = embed "fake-s3.js" ),
        ],
        compatibilityDate = "2026-01-01",
        bindings = [
          ( name = "BUCKET", durableObjectNamespace = "Bucket" ),
        ],
        durableObjectNamespaces = [
          ( className = "Bucket", uniqueKey = "fake-s3-bucket" ),
        ],
        durableObjectStorage = ( inMemory = void ),
      )
    ),
  ],

  sockets = [
    ( name = "http", address = "*:0", http = (), service = "s3" ),
  ],
);
