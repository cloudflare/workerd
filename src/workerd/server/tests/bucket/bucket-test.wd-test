  services = [
    ( name = "TEST_TMPDIR", disk = (writable = true) ),
    ( name = "bucket-test",
      worker = (
        modules = [ ( name = "worker", esModule = embed "bucket-test.js" ) ],
        compatibilityFlags = ["nodejs_compat", "streams_enable_constructors"],
        bindings = [
          ( name = "BUCKET", service = "objects" ),
          ( name = "SMALL", service = "small-parts" ),
        ],
      )
    ),
    # Without a cluster, both in TEST_TMPDIR.
    ( name = "objects", bucket = ( path = "objects", localDisk = "TEST_TMPDIR" ) ),
    ( name = "small-parts",
      bucket = ( path = "small", localDisk = "TEST_TMPDIR", minPartSize = 4 ) ),
  ],
);
