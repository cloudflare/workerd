using Workerd = import "/workerd/workerd.capnp";

# The Secrets Store module over a KV Worker, and Miniflare's Secrets Store
# tests (packages/miniflare/test/plugins/secret-store) against it.
const unitTests :Workerd.Config = (
  services = [
    ( name = "TEST_TMPDIR", disk = (writable = true) ),
    ( name = "secrets-store-test", worker = .testWorker ),
    ( name = "secrets-store",
      worker = (
        modules = [ ( name = "secrets-store.js", bundled = "/workerd/secrets-store.js" ) ],
        compatibilityFlags = ["rpc"],
        bindings = [
          ( name = "store:test_store_id",
            kvNamespace = ( name = "kv", props = ( json = "{\"namespace\": \"test_store_id\"}" ) ) ),
          ( name = "store:test_store_id_1",
            kvNamespace = ( name = "kv", props = ( json = "{\"namespace\": \"test_store_id_1\"}" ) ) ),
          ( name = "store:test_store_id_2",
            kvNamespace = ( name = "kv", props = ( json = "{\"namespace\": \"test_store_id_2\"}" ) ) ),
          ( name = "store:admin_store",
            kvNamespace = ( name = "kv", props = ( json = "{\"namespace\": \"admin_store\"}" ) ) ),
          ( name = "ADMIN", json = "true" ),
          ( name = "env:overridden", text = "from-env" ),
          # As a `fromEnvironment` binding is when its variable is not set.
          ( name = "env:unset", json = "null" ),
        ],
      )
    ),
    # As a wrangler.json config has it: no ADMIN.
    ( name = "secrets-store-get-only",
      worker = (
        modules = [ ( name = "secrets-store.js", bundled = "/workerd/secrets-store.js" ) ],
        compatibilityFlags = ["rpc"],
        bindings = [
          ( name = "store:test_store_id",
            kvNamespace = ( name = "kv", props = ( json = "{\"namespace\": \"test_store_id\"}" ) ) ),
        ],
      )
    ),
    # Its objects and large values both in TEST_TMPDIR.
    ( name = "kv",
      worker = (
        modules = [ ( name = "kv.js", bundled = "/workerd/kv.js" ) ],
        compatibilityFlags = ["rpc"],
        bindings = [
          ( name = "SHARD", durableObjectNamespace = "KVNamespace" ),
          ( name = "BLOBS", service = "TEST_TMPDIR" ),
        ],
        durableObjectNamespaces = [
          ( className = "KVNamespace", uniqueKey = "SecretsStoreKV", enableSql = true ),
        ],
        durableObjectStorage = ( localDisk = "TEST_TMPDIR" ),
      )
    ),
  ],
);

const testWorker :Workerd.Worker = (
  modules = [ ( name = "worker", esModule = embed "secrets-store-test.js" ) ],
  # `get()` is the secret's, not Fetcher's old HTTP shortcut.
  compatibilityFlags = ["nodejs_compat", "rpc", "fetcher_no_get_put_delete"],
  bindings = [
    ( name = "SECRET", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"secret_name\"}" ) ) ),
    ( name = "SECRET1", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_1\", \"secret_name\": \"secret_name_a\"}" ) ) ),
    ( name = "SECRET2", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_1\", \"secret_name\": \"secret_name_b\"}" ) ) ),
    ( name = "SECRET3", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_2\", \"secret_name\": \"secret_name_a\"}" ) ) ),
    ( name = "OVERRIDDEN", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"overridden\"}" ) ) ),
    ( name = "UNSET", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"unset\"}" ) ) ),
    ( name = "ADMIN", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"admin_store\", \"secret_name\": \"admin\"}" ) ) ),
    ( name = "GET_ONLY", service = ( name = "secrets-store-get-only",
        entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"get_only\"}" ) ) ),
    ( name = "WRITER", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"get_only\"}" ) ) ),
  ],
);
