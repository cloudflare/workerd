using Workerd = import "/workerd/workerd.capnp";

# The Secrets Store module, and Miniflare's Secrets Store tests
# (packages/miniflare/test/plugins/secret-store) against it.
const unitTests :Workerd.Config = (
  services = [
    ( name = "secrets-store-test", worker = .testWorker ),
    # Text bindings in place of cli/wrangler.rs's `fromEnvironment` ones.
    ( name = "secrets-store",
      worker = (
        modules = [ ( name = "secrets-store.js", bundled = "/workerd/secrets-store.js" ) ],
        compatibilityFlags = ["rpc"],
        bindings = [
          ( name = "env:secret_name", text = "example" ),
          ( name = "env:secret_name_a", text = "example_a" ),
          ( name = "env:secret_name_b", text = "example_b" ),
          # As a `fromEnvironment` binding is when its variable is not set.
          ( name = "env:unset", json = "null" ),
        ],
      )
    ),
  ],
);

const testWorker :Workerd.Worker = (
  modules = [ ( name = "worker", esModule = embed "secrets-store-test.js" ) ],
  # `get()` is the secret's, not Fetcher's old HTTP shortcut.
  compatibilityFlags = ["nodejs_compat", "rpc", "fetcher_no_get_put_delete"],
  bindings = [
    ( name = "SECRET", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"secret_name\"}" ) ) ),
    ( name = "SECRET1", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_1\", \"secret_name\": \"secret_name_a\"}" ) ) ),
    ( name = "SECRET2", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_1\", \"secret_name\": \"secret_name_b\"}" ) ) ),
    ( name = "SECRET3", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id_2\", \"secret_name\": \"secret_name_a\"}" ) ) ),
    ( name = "UNSET", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"unset\"}" ) ) ),
    ( name = "MISSING", service = ( name = "secrets-store", entrypoint = "SecretsStoreSecret",
        props = ( json = "{\"store_id\": \"test_store_id\", \"secret_name\": \"missing\"}" ) ) ),
  ],
);
