load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Runs `workerd test` on tests that pass and fail, and checks the verdicts and what neither a
# wd-test nor a tail worker sees: the async trace and the exceptions logged.
sh_test(
    name = "test-event-test",
    size = "medium",
    srcs = ["test-event-test.sh"],
    args = [
        "$(location //src/workerd/server:workerd)",
        "$(location test-event.wd-test)",
    ],
    data = [
        "modules.js",
        "service-worker.js",
        "test-event.wd-test",
        "//src/workerd/server:workerd",
    ],
)

# Checks that the test event has the Perfetto spans of WorkerEntrypoint::test().
sh_test(
    name = "test-event-perfetto-test",
    size = "medium",
    srcs = ["test-event-perfetto-test.sh"],
    args = [
        "$(location //src/workerd/server:workerd)",
        "$(location test-event.wd-test)",
    ],
    data = [
        "modules.js",
        "service-worker.js",
        "test-event.wd-test",
        "//src/workerd/server:workerd",
    ],
    target_compatible_with = select({
        "//src/workerd/util:really_use_perfetto": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
