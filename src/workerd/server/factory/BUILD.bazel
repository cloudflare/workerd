# The declarations both bridges (the command line's and the server's) need from :bootstrap.
# Header-only, since the bridge libraries cannot depend on the C++ that includes their headers.
wd_cc_library(
    name = "bootstrap-hdrs",
    hdrs = ["bootstrap.h"],
    deps = [
        "//src/rust/cxx/kj-rs",
        "@capnp-cpp//src/kj",
    ],
)

# The declarations of :per-process the server crate's bridge needs (it holds a `ProcessState`).
# Header-only, like :worker-factory-hdrs.
wd_cc_library(
    name = "per-process-hdrs",
    hdrs = ["per-process.h"],
    deps = [
        ":worker-factory-hdrs",
        "//src/rust/cxx/kj-rs",
        "@capnp-cpp//src/kj",
    ],
)

# What a workerd process sets up once (tracing, tcmalloc, autogates, the test and bench modes,
# V8), and the worker factories built on it.
wd_cc_library(
    name = "per-process",
    srcs = ["per-process.c++"],
    # The process starts tcmalloc's background thread when the binary links tcmalloc.
    local_defines = select({
        "//src/workerd/server:really_use_tcmalloc": ["WORKERD_USE_TCMALLOC"],
        "//conditions:default": [],
    }),
    deps = [
        ":per-process-hdrs",
        ":worker-factory",
        "//src/workerd/io",
        "//src/workerd/io:async-trace",
        "//src/workerd/jsg",
        "//src/workerd/server:v8-platform-impl",
        "//src/workerd/util:autogate",
        "//src/workerd/util:perfetto",
        "//src/workerd/util:thread-scopes",
        "@capnp-cpp//src/capnp",
        "@capnp-cpp//src/kj",
    ] + select({
        "//src/workerd/server:really_use_tcmalloc": ["@tcmalloc//tcmalloc:malloc_extension"],
        "//conditions:default": [],
    }),
)

# The C++ half of a command: the process's logging, and the bridge functions that set up the
# process (:per-process) on the Rust-owned event loop and build the worker factory the Rust server
# runs.
wd_cc_library(
    name = "bootstrap",
    srcs = ["bootstrap.c++"],
    linkstatic = CC_LIBRARY_LINKSTATIC,
    deps = [
        ":bootstrap-hdrs",
        ":per-process",
        ":worker-factory",
        "//src/pyodide:pyodide_extra_capnp",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-io:kj-rs-io-lib",
        "//src/rust/cxx/kj-rs-tokio:kj-rs-tokio-lib",
        "//src/workerd/server:json-logger",
        "//src/workerd/server:workerd_capnp",
        "//src/workerd/server/server:bridge.rs@cxx",
        "//src/workerd/util:entropy",
        # :bootstrap exists only for the workerd binary, so it links the binary's kj::setupAsyncIo()
        # (the inspector and fallback-service threads' loops).
        "//src/workerd/util:setup-async-io",
        "@capnp-cpp//src/kj:kj-async-core",
        "@capnp-cpp//src/kj:kj-async-io",
    ],
    # The C++ root of the workerd binary is linked eagerly, as a cc_binary's own sources would be.
    # Bazel places it ahead of everything it depends on, and from an eager object the linker
    # resolves the rest of the C++ in that order. Left lazy, the Rust side's references would reach
    # it only after every library had been registered, and the linker would then find the C++ by a
    # depth-first walk of symbol references. That walk decides which copy of a template the binary
    # keeps when two libraries carry different ones: V8 is built without exceptions, and its copy
    # of libc++'s std::regex parser aborts where workerd's throws.
    alwayslink = True,
)

# Links the Rust server, whose bridge the factory calls, as server-test does.
kj_test(
    src = "worker-factory-rpc-test.c++",
    deps = [
        ":worker-factory",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-io:kj-rs-io-lib",
        "//src/workerd/jsg",
        "//src/workerd/server:workerd_capnp",
        "//src/workerd/server/server:workerd-server",
        "@capnp-cpp//src/capnp:capnp-rpc",
        "@capnp-cpp//src/kj:kj-async-io",
    ],
)
