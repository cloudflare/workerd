load("//:build/kj_test.bzl", "kj_test")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_compile_test.bzl", "wd_rust_compile_test")
load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

# The IoContext of the current request, for APIs implemented in Rust. A package of its own
# because //src/workerd/io depends on jsg.
wd_rust_crate(
    name = "io-context",
    srcs = [
        "ffi.rs",
        "lib.rs",
        "lib-test.rs",
        "trace.rs",
    ],
    cxx_bridge_deps = [
        "//src/rust/jsg",
        "//src/rust/kj",
        "//src/rust/worker:bridge",
        "//src/workerd/io",
    ],
    cxx_bridge_hdrs = ["ffi.h"],
    cxx_bridge_src = "ffi.rs",
    # The entrypoint crate's bridge names IncomingRequest.
    cxx_bridge_visibility = ["//src/workerd/io/entrypoint:__pkg__"],
    link_deps = [":ffi"],
    proc_macro_deps = ["//src/rust/jsg-macros"],
    test_deps = ["//src/rust/jsg-test"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/jsg",
        "//src/rust/kj",
        "//src/rust/worker",
    ],
)

wd_cc_library(
    name = "ffi",
    srcs = ["ffi.c++"],
    hdrs = ["ffi.h"],
    # The entrypoint crate's shims hand C++ IncomingRequests to Rust.
    visibility = ["//src/workerd/io/entrypoint:__pkg__"],
    deps = [
        ":current-with-id",
        ":ffi.rs@cxx",
        "//src/rust/jsg:ffi",
        "//src/rust/worker:bridge",
        "//src/workerd/io",
        "//src/workerd/jsg:inspector",
        "//src/workerd/util:perfetto",
    ],
)

# The IoContext that an `io_context::IoContext` stands for, by its id. A library of its own so that
# the per-type and per-method shims of API crates, which take that id, need not depend on :ffi.
wd_cc_library(
    name = "current-with-id",
    srcs = ["current-with-id.c++"],
    hdrs = ["current-with-id.h"],
    visibility = ["//src/workerd/api:__subpackages__"],
    deps = ["//src/workerd/io"],
)

# Snippets that must not compile against io-context (each annotates the errors it expects) and
# snippets that must (no annotations). See build/wd_rust_compile_test.bzl.
wd_rust_compile_test(
    name = "compile-tests",
    srcs = glob(["compile-tests/*.rs"]),
    proc_macro_deps = ["//src/rust/jsg-macros"],
    deps = [
        ":io-context",
        "//src/rust/jsg",
    ],
)

# Checked by //src/rust/jsg:cpp-jsg-allowlist-test.
exports_files([
    "ffi.c++",
    "ffi.h",
])

# The Rust half of io-context-test and request-ops-test.
wd_rust_crate(
    name = "io-context-test-bridge",
    testonly = True,
    srcs = ["test_bridge.rs"],
    crate_root = "test_bridge.rs",
    cxx_bridge_deps = [
        ":ffi",
        "//src/rust/jsg",
        "//src/workerd/api/channel-interop:ffi.rs@cxx",
    ],
    cxx_bridge_hdrs = ["test-bridge.h"],
    cxx_bridge_src = "test_bridge.rs",
    link_deps = [":test-bridge"],
    proc_macro_deps = ["//src/rust/jsg-macros"],
    deps = [
        ":io-context",
        "//src/rust/jsg",
        "//src/rust/jsg-cpp",
        "//src/rust/kj",
        "//src/workerd/api/channel-interop",
        "@crates_vendor//futures",
    ],
)

# The C++ functions test_bridge.rs calls, and what they record. Every binary that links the
# bridge crate needs them, including its generated io-context-test-bridge_test.
wd_cc_library(
    name = "test-bridge",
    testonly = True,
    srcs = ["test-bridge.c++"],
    hdrs = ["test-bridge-state.h"],
    deps = [
        ":ffi",
        ":test_bridge.rs@cxx",
        "//src/workerd/io",
    ],
)

# io-context inside a request of a real worker and in a Durable Object, and the IoContext that
# Rust builtin modules see when a request resolves them. Large: most of its cases start a worker
# of their own, which with every autogate on adds up to more than the moderate timeout in a debug
# build.
kj_test(
    size = "large",
    src = "io-context-test.c++",
    deps = [
        ":ffi",
        ":io-context-test-bridge",
        ":test-bridge",
        "//src/rust/jsg:bridge",
        "//src/workerd/tests:test-fixture-expose-gc",
    ],
)

# The operations behind ctx.waitUntil(), ctx.passThroughOnException() and ctx.abort(), compared
# with the C++ ExecutionContext in the requests of a real worker.
kj_test(
    src = "request-ops-test.c++",
    deps = [
        ":ffi",
        ":io-context-test-bridge",
        "//src/rust/jsg:ffi",
        "//src/workerd/tests:test-fixture",
    ],
)
