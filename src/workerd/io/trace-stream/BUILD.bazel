load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

# The Rust half of trace-stream.c++: the JavaScript values a streaming tail worker receives for its
# tail events. A package of its own because //src/workerd/io depends on it, and it on jsg.
wd_rust_crate(
    name = "trace-stream",
    srcs = [
        "ffi.rs",
        "ids.rs",
        "ids-test.rs",
        "keys.rs",
        "lib.rs",
        "lib-test.rs",
        "to_js.rs",
        "to_js-test.rs",
    ],
    cxx_bridge_deps = ["//src/rust/jsg"],
    cxx_bridge_src = "ffi.rs",
    cxx_bridge_visibility = ["//src/workerd/io:__pkg__"],
    test_deps = [
        "//src/rust/jsg-test",
        "@crates_vendor//capnp",
    ],
    visibility = ["//src/workerd/io:__pkg__"],
    deps = [
        "//src/rust/jsg",
        "//src/workerd/io:outcome_capnp_rust",
        "//src/workerd/io:script-version_capnp_rust",
        "//src/workerd/io:trace_capnp_rust",
        "//src/workerd/io:worker-interface_capnp_rust",
        "@crates_vendor//capnp",
    ],
)
