load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

# The segment cipher behind crypto.SegmentEncryptionStream and SegmentDecryptionStream
# (../segment-stream.c++): the layout, key schedule and segment framing are Rust, and the
# primitives they compose are BoringSSL's, called through primitives.h.
wd_rust_crate(
    name = "segment-cipher",
    srcs = glob(["*.rs"]),
    cxx_bridge_deps = [":primitives"],
    cxx_bridge_hdrs = ["primitives.h"],
    cxx_bridge_src = "lib.rs",
    cxx_bridge_visibility = ["//src/workerd/io:__pkg__"],
    link_deps = [":primitives"],
    visibility = ["//src/workerd/io:__pkg__"],
)

wd_cc_library(
    name = "primitives",
    srcs = ["primitives.c++"],
    hdrs = ["primitives.h"],
    deps = [
        "//src/rust/cxx",
        "@capnp-cpp//src/kj",
        "@capnp-cpp//src/kj/compat:kj-http",
        "@ssl",
    ],
)
