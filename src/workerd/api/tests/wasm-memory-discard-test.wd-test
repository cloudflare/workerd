          (name = "worker", esModule = embed "wasm-memory-discard-test.js"),
          (name = "test.wasm", wasm = embed "wasm-memory-discard.wasm")
        ],
        compatibilityFlags = ["nodejs_compat", "experimental", "wasm_memory_discard"],
      )
    ),
    ( name = "wasm-memory-discard-disabled-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "wasm-memory-discard-disabled-test.js")
        ],
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
  ],
);
