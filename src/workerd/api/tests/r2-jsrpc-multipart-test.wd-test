using Workerd = import "/workerd/workerd.capnp";

# Checks the multipart JSRPC client against R2BindingEntrypoint, a fake gateway that asserts the
# exact arguments the client sends. It uses the same struct mode as the other R2 JSRPC configs;
# the multipart wire inputs do not depend on property presence, so one mode is enough.
# r2-jsrpc-test.wd-test and r2-jsrpc-legacy-list-test.wd-test run r2MultipartApiTests through
# the passthrough to a native binding.
const unitTests :Workerd.Config = (
  services = [
    ( name = "gateway",
      worker = (
        modules = [
          (name = "worker", esModule = "export { R2BindingEntrypoint, jsrpcGatewayMultipartContractTests } from './r2-test.js';"),
          (name = "r2-test.js", esModule = embed "r2-test.js"),
        ],
        bindings = [
          (name = "BUCKET", r2Bucket = (name = "gateway", entrypoint = "R2BindingEntrypoint")),
          (name = "R2_TRANSPORT", text = "jsrpc"),
        ],
        compatibilityFlags = ["experimental", "nodejs_compat", "service_binding_extra_handlers",
                              "streams_enable_constructors", "r2_binding_jsrpc", "disable_fast_jsg_struct"],
      ),
    ),
  ],
);
