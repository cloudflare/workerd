using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    (name = "websocket-send-before-open-test", worker = .pedanticWorker),
    (name = "websocket-send-before-open-legacy-test", worker = .legacyWorker),
  ],
);

const pedanticWorker :Workerd.Worker = (
  compatibilityFlags = ["nodejs_compat", "pedantic_wpt"],
  modules = [(name = "worker", esModule = embed "websocket-send-before-open-test.js")],
  bindings = [(name = "pedantic", json = "true")],
);

const legacyWorker :Workerd.Worker = (
  compatibilityFlags = ["nodejs_compat"],
  modules = [(name = "worker", esModule = embed "websocket-send-before-open-test.js")],
  bindings = [(name = "pedantic", json = "false")],
);
