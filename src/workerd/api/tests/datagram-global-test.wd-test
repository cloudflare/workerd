using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    (
      name = "datagram-disabled",
      worker = (
        modules = [(name = "worker", esModule = embed "datagram-global-test.js")],
        compatibilityFlags = ["nodejs_compat"],
        bindings = [(name = "EXPERIMENTAL", json = "false")],
      ),
    ),
    (
      name = "datagram-enabled",
      worker = (
        modules = [(name = "worker", esModule = embed "datagram-global-test.js")],
        compatibilityFlags = ["nodejs_compat", "experimental"],
        bindings = [(name = "EXPERIMENTAL", json = "true")],
      ),
    ),
  ],
);
