using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "timeout-bookkeeping-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "timeout-bookkeeping-test.js")
        ],
        # setImmediate() needs nodejs_compat_v2; keep workerd's own timer globals.
        compatibilityFlags = ["nodejs_compat_v2", "no_nodejs_global_timers"],
      )
    ),
  ],
);
