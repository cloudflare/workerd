using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "commonjs-module-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "commonjs-module-test.js"),
          (name = "foo",
           commonJsModule = "exports.foo = 1",
           namedExports = ["foo", "bar"]),
          (name = "bad-require", commonJsModule = "require('../dep')"),
          (name = "require-process",
           commonJsModule = "module.exports = { bare: require('process'), prefixed: require('node:process') };")
        ],
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
  ],
);
