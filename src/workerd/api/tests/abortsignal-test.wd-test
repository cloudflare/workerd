using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "abortsignal-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "abortsignal-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "enable_abortsignal_rpc", "experimental", "spec_compliant_dispatch_exceptions"],
        bindings = [
          (name = "RpcRemoteEnd", service = (name = "abortsignal-test", entrypoint = "RpcRemoteEnd")),
          (name = "CALLEE", service = (name = "callee", entrypoint = "Callee")),
          (name = "RESULTS", service = (name = "results", entrypoint = "Results")),
          (name = "ACTOR", durableObjectNamespace = (className = "CalleeActor", serviceName = "callee")),
        ]
      )
    ),
    # Serves Callee and CalleeActor. The "results" tail worker reports the outcome of each of its
    # invocations, which shows whether an AbortSignal sent to it kept its session open.
    ( name = "callee",
      worker = (
        modules = [
          (name = "worker", esModule = embed "abortsignal-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "enable_abortsignal_rpc", "experimental", "spec_compliant_dispatch_exceptions"],
        durableObjectNamespaces = [(className = "CalleeActor", uniqueKey = "callee-actor")],
        durableObjectStorage = (inMemory = void),
        tails = ["results"],
      )
    ),
    # Records each callee invocation's outcome and exception messages by RPC method name.
    ( name = "results",
      worker = (
        modules = [
          (name = "worker", esModule = embed "abortsignal-test-tail.js")
        ],
      )
    ),
  ],
  v8Flags = ["--expose-gc"]
);
