using Workerd = import "/workerd/workerd.capnp";

# The worker is instantiated twice so that the bindings below cross an isolate boundary.
# Only the first service's test() runs; see the filter argument in BUILD.bazel.
const unitTests :Workerd.Config = (
  services = [
    ( name = "response-used-body-test", worker = .worker ),
    ( name = "response-used-body-test-target", worker = .worker ),
  ],
);

const worker :Workerd.Worker = (
  modules = [
    (name = "worker", esModule = embed "response-used-body-test.js")
  ],
  compatibilityFlags = ["nodejs_compat_v2", "streams_enable_constructors"],
  bindings = [
    (name = "subrequest", service = "response-used-body-test-target")
  ]
);
