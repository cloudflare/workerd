using Workerd = import "/workerd/workerd.capnp";
using Passthrough = import "r2-jsrpc-passthrough.capnp";

# Compatibility-sensitive coverage for list() before r2_list_honor_include. This lives separately
# because a future compatibility date necessarily enables the behavior under test.
#
# The canonical and shared suites run through the passthrough in r2-jsrpc-passthrough.capnp, with
# the flag disabled for both the JSRPC client and the native binding.
const unitTests :Workerd.Config = (
  services = [
    ( name = "user",
      worker = (
        modules = Passthrough.userModules,
        bindings = [
          ( name = "BUCKET",
            r2Bucket = (name = "r2-test", entrypoint = "ObservedR2Binding") ),
          ( name = "R2_TRANSPORT", text = "jsrpc" ),
          ( name = "R2_LIST_HONOR_INCLUDE", text = "false" ),
        ],
        compatibilityFlags = ["experimental", "nodejs_compat", "service_binding_extra_handlers",
                              "streams_enable_constructors", "r2_binding_jsrpc"],
      )
    ),
    ( name = "r2-test", worker = Passthrough.passthroughLegacyListWorker ),
  ],
);
