using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "connect-handler-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-test.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2"],
        bindings = [
          (name = "TARGET", service = (
            name = "connect-handler-test-local-address-endpoint",
            entrypoint = "LocalAddressEndpoint")),
          (name = "SIDECAR_HOSTNAME", fromEnvironment = "SIDECAR_HOSTNAME"),
          (name = "CONNECT_HANDLER_PORT", fromEnvironment = "CONNECT_HANDLER_PORT"),
          (name = "CONNECT_PROXY_PORT", fromEnvironment = "CONNECT_PROXY_PORT"),
        ],
      )
    ),
    ( name = "connect-handler-test-local-address-endpoint",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-test-proxy.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2"],
      )
    ),
    ( name = "connect-handler-starttls-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-starttls-test.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2", "connect_handler_starttls"],
        bindings = [
          (name = "STARTTLS_TARGET", service = (
            name = "connect-handler-test-starttls-endpoint",
            entrypoint = "StartTlsEndpoint")),
          (name = "SIDECAR_HOSTNAME", fromEnvironment = "SIDECAR_HOSTNAME"),
          (name = "STARTTLS_PORT", fromEnvironment = "STARTTLS_PORT"),
        ],
      )
    ),
    ( name = "connect-handler-test-starttls-endpoint",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-test-proxy.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2", "connect_handler_starttls"],
      )
    ),
    ( name = "connect-handler-test-proxy",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-test-proxy.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2", "experimental"],
        bindings = [
          (name = "SIDECAR_HOSTNAME", fromEnvironment = "SIDECAR_HOSTNAME"),
          (name = "CONNECT_ENDPOINT_PORT", fromEnvironment = "CONNECT_ENDPOINT_PORT"),
        ],
      )
    ),
    ( name = "connect-handler-test-endpoint",
      worker = (
        modules = [
          (name = "worker", esModule = embed "connect-handler-test-proxy.js"),
        ],
        compatibilityFlags = ["nodejs_compat_v2"],
      )
    ),
    ( name = "internet", network = ( allow = ["private"],
        tlsOptions = (
          trustedCertificates = [
            embed "connect-handler-server.pem",
          ],
        ),
      )
    )
  ],
  # BUILD.bazel's listen_port_bindings replaces each address with a port assigned when the test
  # runs.
  sockets = [
    (name = "connect-handler", address = "127.0.0.1:0", tcp = (), service = "connect-handler-test"),
    (name = "connect-proxy", address = "127.0.0.1:0", tcp = (), service = (name = "connect-handler-test-proxy", entrypoint = "ConnectProxy")),
    (name = "connect-endpoint", address = "127.0.0.1:0", tcp = (), service = (name = "connect-handler-test-endpoint", entrypoint = "ConnectEndpoint")),
    # A keypair with tlsMode = startTls is what lets the handler on the other end of this socket
    # accept a startTls() upgrade; the matching certificate is the one the `internet` service
    # trusts above.
    (name = "connect-starttls", address = "127.0.0.1:0", tcp = (
      tlsOptions = (
        keypair = (
          privateKey = embed "connect-handler-server.key",
          certificateChain = embed "connect-handler-server.pem",
        ),
      ),
      tlsMode = startTls,
    ), service = "connect-handler-starttls-test")
  ]
);
