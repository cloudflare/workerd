using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "text-encoder-global-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "text-encoder-global-test.js")
        ],
        compatibilityFlags = ["nodejs_compat"]
      )
    ),
    # Under this flag the global scope has its own property for each class. No test variant
    # enables it.
    ( name = "text-encoder-global-test-spec-compliant",
      worker = (
        modules = [
          (name = "worker", esModule = embed "text-encoder-global-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "spec_compliant_property_attributes"]
      )
    ),
  ],
);
