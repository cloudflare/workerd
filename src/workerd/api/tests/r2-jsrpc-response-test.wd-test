using Workerd = import "/workerd/workerd.capnp";

# Response decoding must report internal errors with either struct-wrapping implementation.
const unitTests :Workerd.Config = (
  services = [
    ( name = "fast-structs",
      worker = (
        modules = [
          (name = "worker", esModule = "import { R2JsrpcResponseEntrypoint, testInvalidR2Responses } from './r2-test.js'; export { R2JsrpcResponseEntrypoint }; export const InvalidR2ResponseTests = { test: testInvalidR2Responses };"),
          (name = "r2-test.js", esModule = embed "r2-test.js"),
        ],
        bindings = [
          (name = "BUCKET", r2Bucket = (name = "fast-structs", entrypoint = "R2JsrpcResponseEntrypoint")),
        ],
        compatibilityFlags = ["experimental", "nodejs_compat", "service_binding_extra_handlers",
                              "streams_enable_constructors", "r2_binding_jsrpc", "enable_fast_jsg_struct"],
      ),
    ),
    ( name = "slow-structs",
      worker = (
        modules = [
          (name = "worker", esModule = "import { R2JsrpcResponseEntrypoint, testInvalidR2Responses } from './r2-test.js'; export { R2JsrpcResponseEntrypoint }; export const InvalidR2ResponseTests = { test: testInvalidR2Responses };"),
          (name = "r2-test.js", esModule = embed "r2-test.js"),
        ],
        bindings = [
          (name = "BUCKET", r2Bucket = (name = "slow-structs", entrypoint = "R2JsrpcResponseEntrypoint")),
        ],
        compatibilityFlags = ["experimental", "nodejs_compat", "service_binding_extra_handlers",
                              "streams_enable_constructors", "r2_binding_jsrpc", "disable_fast_jsg_struct"],
      ),
    ),
  ],
);
