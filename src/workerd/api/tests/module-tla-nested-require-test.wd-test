using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "module-tla-nested-require-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "module-tla-nested-require-test.js"),

          # Regression coverage for a V8 fatal CHECK (status() >= kEvaluatingAsync). "entry"
          # statically imports a top-level-await module ("leaf") and then a CommonJS module
          # ("pump"). leaf suspends and becomes an async child while entry is still
          # kEvaluating; pump's nested require('trivial') then drained the microtask queue,
          # running leaf's fulfillment callback too early and aborting the process in
          # GatherAvailableAncestors -> GetCycleRoot.
          (name = "entry",
           esModule = "import { v } from 'leaf';\nimport 'pump';\nexport default v;\n"),
          (name = "leaf",
           esModule = "await Promise.resolve();\nexport const v = 1;\n"),
          (name = "pump", commonJsModule = "require('trivial'); exports.ok = true;"),
          (name = "trivial", commonJsModule = "exports.ok = true;"),

          # Same crash, reached through an inline nested dynamic import instead of require().
          # dyn-entry statically imports the TLA leaf (giving leaf an async-parent link to the
          # still-kEvaluating dyn-entry) and then dyn-pump, whose top level dynamically imports
          # a TLA module. With no active IoContext that instantiation runs inline at non-zero
          # evaluation depth, so it must not drain either.
          (name = "dyn-entry",
           esModule = "import { v } from 'dyn-leaf';\nimport 'dyn-pump';\nexport default v;\n"),
          # A dedicated leaf: once a leaf is kEvaluated it can no longer form the
          # async-child-of-a-still-kEvaluating-parent link, so sharing one would leave only the
          # first graph able to reproduce the crash.
          (name = "dyn-leaf", esModule = "await Promise.resolve();\nexport const v = 1;\n"),
          (name = "dyn-pump", esModule = "import('dyn-tla');\nexport const ok = 1;\n"),
          (name = "dyn-tla",
           esModule = "await Promise.resolve();\nexport const d = 1;\n"),

          # Dynamic import runs at evaluation depth 0, so the drain that settles this
          # top-level await must still happen.
          (name = "dynamic-tla",
           esModule = "await Promise.resolve();\nexport const value = 42;\n"),

          # A nested dynamic import whose target statically imports the importer, which is
          # still kEvaluating. Linking that graph inline aborted the process in V8 15.8
          # ("Module in unexpected status Evaluating"), so the import must wait until the
          # importer has finished evaluating.
          (name = "cyc-entry",
           esModule = "export const a = 1;\nexport const chunk = import('cyc-chunk');\n"),
          (name = "cyc-chunk",
           esModule = "import { a } from 'cyc-entry';\nexport const b = a + 1;\n"),

          # The same, where the deferred module then suspends on a top-level await.
          (name = "cyc-tla-entry",
           esModule = "export const a = 1;\nexport const chunk = import('cyc-tla-chunk');\n"),
          (name = "cyc-tla-chunk",
           esModule = "import { a } from 'cyc-tla-entry';\nawait 0;\nexport const b = a + 2;\n"),

          # Deferred imports that fail. The import must reject with the module's own error: the
          # failure from the first, deferred link attempt must not leak out instead.
          (name = "cyc-throw-entry",
           esModule = "export const chunk = import('cyc-throw-chunk');\n"),
          (name = "cyc-throw-chunk",
           esModule = "import 'cyc-throw-entry';\nthrow new Error('deferred boom');\n"),
          (name = "cyc-tla-throw-entry",
           esModule = "export const chunk = import('cyc-tla-throw-chunk');\n"),
          (name = "cyc-tla-throw-chunk",
           esModule = "import 'cyc-tla-throw-entry';\nawait 0;\nthrow new Error('tla boom');\n"),
          # The retried link fails too, here because the importer lacks the export.
          (name = "cyc-link-entry",
           esModule = "export const chunk = import('cyc-link-chunk');\n"),
          (name = "cyc-link-chunk",
           esModule = "import { nope } from 'cyc-link-entry';\nexport const v = nope;\n"),

          # The same cycle through a nested require(), which is synchronous and so cannot wait:
          # it must fail the require() rather than abort the process.
          (name = "req-cyc-entry", esModule = "import 'req-cyc-cjs';\nexport default 1;\n"),
          (name = "req-cyc-cjs", commonJsModule = "require('req-cyc-esm');"),
          (name = "req-cyc-esm", esModule = "import 'req-cyc-entry';\nexport const x = 1;\n"),

          # Top-level await that never settles.
          (name = "never-settles",
           esModule = "await new Promise(() => {});\nexport const nope = 1;\n"),

          # Throws during evaluation; proves the RAII depth scope does not leak.
          # A nested require() of a module whose top-level await never settles cannot be
          # chained on (require is synchronous), so it must report the unsettled top-level
          # await rather than hand back a half-evaluated namespace.
          (name = "req-entry", esModule = "import 'req-pump';\nexport default 1;\n"),
          # Deliberately a separate module from never-settles: a failed instantiation leaves
          # the module kEvaluating, and instantiateModule() early-returns for that status, so
          # sharing it would mask the other test's expected failure.
          (name = "req-pump", commonJsModule = "module.exports = require('req-never-settles');"),
          (name = "req-never-settles",
           esModule = "await new Promise(() => {});\nexport const x = 1;\n"),

          (name = "boom", esModule = "throw new Error('boom');\n"),
        ],
        # The cyclic cases cover how the legacy registry handles a nested import that cycles back
        # to a module that is still evaluating. The new registry rejects such cycles outright.
        compatibilityFlags = ["nodejs_compat", "legacy_module_registry"]
      )
    ),
  ],
);
