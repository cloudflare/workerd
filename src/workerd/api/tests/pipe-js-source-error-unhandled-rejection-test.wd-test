using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "pipe-js-source-error-unhandled-rejection-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "pipe-js-source-error-unhandled-rejection-test.js")
        ],
        compatibilityFlags = [
          "nodejs_compat",
          "streams_enable_constructors",
          # The rejections fixed here were reported only when unhandled rejections are
          # processed in a microtask, which races with promise adoption.
          "no_unhandled_rejection_after_microtask_checkpoint",
        ],
      )
    ),
  ],
);
