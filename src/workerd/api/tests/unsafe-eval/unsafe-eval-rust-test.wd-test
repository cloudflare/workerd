using Workerd = import "/workerd/workerd.capnp";
using Base = import "unsafe-eval-test.wd-test";
using TestExtension = import "extension.capnp";

# The tests of unsafe-eval-test.wd-test, against the Rust internal:unsafe-eval, so that each
# variant of this target (compatibility dates, GC stress) covers it.
const unitTests :Workerd.Config = (
  services = Base.services,
  extensions = [ TestExtension.extension ],
  autogates = ["workerd-autogate-rust-unsafe-modules"],
);
