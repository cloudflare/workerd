using Workerd = import "/workerd/workerd.capnp";

# Node.js API objects across a startup snapshot; see startup-snapshot-node-test.js. The runner's
# test() fetches every case service and asserts its report. The @all-autogates variant turns the
# startup-snapshot autogate on, so every service here goes through the zygote; the @ variant runs
# them as plain Workers.

const compatibilityFlags :List(Text) = [
  "nodejs_compat",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
];

const caseModules :List(Workerd.Worker.Module) = [
  (name = "worker.js", esModule = embed "startup-snapshot-node-case-test.js"),
];

const unitTests :Workerd.Config = (
  services = [
    ( name = "runner",
      worker = (
        modules = [
          (name = "worker.js", esModule = embed "startup-snapshot-node-test.js"),
        ],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "als", service = "als"),
          (name = "als-default", service = "als-default"),
          (name = "diagnostics-channel", service = "diagnostics-channel"),
        ],
      )
    ),
    ( name = "als",
      worker = (
        modules = .caseModules,
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"als\""),
        ],
      )
    ),
    ( name = "als-default",
      worker = (
        modules = .caseModules,
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"als-default\""),
        ],
      )
    ),
    ( name = "diagnostics-channel",
      worker = (
        modules = .caseModules,
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"diagnostics-channel\""),
        ],
      )
    ),
  ],
  # typescript_implemented_streams needs the per-isolate bootstrap in every variant.
  autogates = ["workerd-autogate-per-isolate-javascript-bootstrap"],
);
