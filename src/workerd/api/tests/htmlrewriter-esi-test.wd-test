using Workerd = import "/workerd/workerd.capnp";

# htmlrewriter-esi-test.js under the C++ HTMLRewriter, with and without
# html_rewriter_treats_esi_include_as_void_tag.

const unitTests :Workerd.Config = (
  services = [
    ( name = "htmlrewriter-esi",
      worker = (
        modules = [(name = "worker", esModule = embed "htmlrewriter-esi-test.js")],
        compatibilityFlags = ["nodejs_compat", "experimental"],
        bindings = [
          (name = "ESI_INCLUDE_IS_VOID", json = "false"),
          (name = "USING_TS_REWRITER", json = "false"),
        ],
      )
    ),
    ( name = "htmlrewriter-esi-void",
      worker = (
        modules = [(name = "worker", esModule = embed "htmlrewriter-esi-test.js")],
        compatibilityFlags = [
          "nodejs_compat",
          "experimental",
          "html_rewriter_treats_esi_include_as_void_tag",
        ],
        bindings = [
          (name = "ESI_INCLUDE_IS_VOID", json = "true"),
          (name = "USING_TS_REWRITER", json = "false"),
        ],
      )
    ),
  ],
);
