{
  "extends": "../../../../tools/base.tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "webworker"],
    "paths": {
      "@workerd/*": ["../../../bazel-bin/src/workerd/*"]
    },
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["@types/node"]
  },
  "include": ["**/*.ts"],
  // r2-binding-service and embedder-bootstrap have projects of their own; the other entries
  // repeat the base config's exclude, which this one replaces.
  "exclude": [
    "node_modules",
    "**/*.mjs",
    "r2-binding-service",
    "embedder-bootstrap"
  ]
}
