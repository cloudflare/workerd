using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "crypto-shared-buffer-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "crypto-shared-buffer-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "webcrypto_modern_algorithms", "pedantic_wpt"],
      )
    ),
    ( name = "crypto-shared-buffer-non-pedantic-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "crypto-shared-buffer-non-pedantic-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "non_pedantic_wpt"],
      )
    ),
  ],
);
