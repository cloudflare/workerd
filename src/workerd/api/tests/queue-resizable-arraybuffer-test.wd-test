using Workerd = import "/workerd/workerd.capnp";

# The consumer runs as a second service from the same worker definition so that messages cross
# an isolate boundary. Only the producer's test() runs; see the filter argument in BUILD.bazel.
const unitTests :Workerd.Config = (
  services = [
    ( name = "queue-resizable-arraybuffer-test", worker = .worker ),
    ( name = "queue-resizable-arraybuffer-test-target", worker = .worker ),
  ],
);

const worker :Workerd.Worker = (
  modules = [
    (name = "worker", esModule = embed "queue-resizable-arraybuffer-test.js")
  ],
  bindings = [
    ( name = "QUEUE", queue = "queue-resizable-arraybuffer-test-target" ),
  ],
  compatibilityFlags = ["nodejs_compat", "queues_json_messages"],
);
