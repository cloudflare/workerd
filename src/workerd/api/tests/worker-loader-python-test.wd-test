using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  # Tiering Pyodide up to TurboFan costs these short tests more CPU than it saves.
  v8Flags = ["--liftoff-only"],
  services = [
    ( name = "worker-loader-python-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "worker-loader-python-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "experimental"],
        bindings = [
          (name = "loader", workerLoader = ()),
        ],
      )
    ),
  ],
);
