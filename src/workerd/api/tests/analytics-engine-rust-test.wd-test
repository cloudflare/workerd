using Workerd = import "/workerd/workerd.capnp";
using Base = import "analytics-engine-test.wd-test";

# The tests of analytics-engine-test.wd-test, against the Rust AnalyticsEngine, so that each
# variant of this target (compatibility dates, GC stress) covers it. The TEST_WORKERD autogate
# tells the tests that the Rust AnalyticsEngine runs, as it does in the @all-autogates variant.
const unitTests :Workerd.Config = (
  services = Base.services,
  autogates = ["workerd-autogate-rust-analytics-engine", "workerd-autogate-test-workerd"],
);
