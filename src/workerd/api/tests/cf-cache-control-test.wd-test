using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "cf-cache-control-test",
      worker = (
        modules = [
          ( name = "worker", esModule = embed "cf-cache-control-test.js" )
        ],
        bindings = [
          ( name = "CACHE_ENABLED", json = "false" ),
        ],
        compatibilityFlags = ["nodejs_compat", "cache_option_disabled"],
      )
    ),
    ( name = "cf-cache-control-test-cache-enabled",
      worker = (
        modules = [
          ( name = "worker-cache-enabled", esModule = embed "cf-cache-control-test.js" )
        ],
        bindings = [
          ( name = "CACHE_ENABLED", json = "true" ),
          ( name = "SERVICE", service = "cf-cache-control-test-cache-enabled" ),
          ( name = "CACHE_OPTION_PRESERVES_CACHE_CONTROL", json = "false" ),
        ],
        compatibilityFlags = ["nodejs_compat", "cache_option_enabled", "cache_no_cache_enabled",
                              "cache_option_overrides_cache_control"],
      )
    ),
    ( name = "cf-cache-control-test-cache-option-preserves-cache-control",
      worker = (
        modules = [
          ( name = "worker-cache-option-preserves-cache-control",
            esModule = embed "cf-cache-control-test.js" )
        ],
        bindings = [
          ( name = "CACHE_ENABLED", json = "true" ),
          ( name = "SERVICE", service = "cf-cache-control-test-cache-option-preserves-cache-control" ),
          ( name = "CACHE_OPTION_PRESERVES_CACHE_CONTROL", json = "true" ),
        ],
        compatibilityFlags = ["nodejs_compat", "cache_option_enabled", "cache_no_cache_enabled",
                              "cache_option_preserves_cache_control"],
      )
    ),
  ],
);
