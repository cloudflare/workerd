using Workerd = import "/workerd/workerd.capnp";

# Top-level code that touches what V8 adds to a context only when it is not building a startup
# snapshot (RESTORE_TIME_GLOBALS in jsg/setup.h). The runner's test() fetches every case service and
# asserts its report; see startup-snapshot-globals-test.js. The @all-autogates variant turns the
# startup-snapshot autogate on, so every service here goes through the zygote; the @ variant runs
# them as plain Workers.

const compatibilityFlags :List(Text) = [
  "nodejs_compat",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
];

const temporalCompatibilityFlags :List(Text) = [
  "nodejs_compat",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
  "temporal",
];

const nodeCompatV2Flags :List(Text) = [
  "nodejs_compat",
  "nodejs_compat_v2",
  "enable_nodejs_process_v2",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
];

# The variants' oldest compatibility date predates expose_global_message_channel. The case compares
# the globals with what node:worker_threads hands out.
const messageChannelFlags :List(Text) = [
  "nodejs_compat",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
  "expose_global_message_channel",
  "enable_nodejs_worker_threads_module",
];

const unitTests :Workerd.Config = (
  services = [
    ( name = "runner",
      worker = (
        modules = [(name = "worker", esModule = embed "startup-snapshot-globals-test.js")],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"runner\""),
          (name = "control", service = "control"),
          (name = "stl-set", service = "stl-set"),
          (name = "stl-save-raise-restore", service = "stl-save-raise-restore"),
          (name = "stl-delete", service = "stl-delete"),
          (name = "stl-nonconfigurable", service = "stl-nonconfigurable"),
          (name = "error-frozen", service = "error-frozen"),
          (name = "iter-assign", service = "iter-assign"),
          (name = "iter-define", service = "iter-define"),
          (name = "wasm-probe", service = "wasm-probe"),
          (name = "wasm-probe-caught", service = "wasm-probe-caught"),
          (name = "wasm-assign", service = "wasm-assign"),
          (name = "wasm-assign-caught", service = "wasm-assign-caught"),
          (name = "iter-polyfill-caught", service = "iter-polyfill-caught"),
          (name = "wasm-use", service = "wasm-use"),
          (name = "sab-probe", service = "sab-probe"),
          (name = "wasm-delete", service = "wasm-delete"),
          (name = "temporal-probe", service = "temporal-probe"),
          (name = "temporal-polyfill", service = "temporal-polyfill"),
          (name = "date-frozen", service = "date-frozen"),
          (name = "temporal-on-control", service = "temporal-on-control"),
          (name = "temporal-on-probe", service = "temporal-on-probe"),
          (name = "process-assign", service = "process-assign"),
          (name = "buffer-assign", service = "buffer-assign"),
          (name = "process-env", service = "process-env"),
          (name = "process-stdout", service = "process-stdout"),
          (name = "message-channel", service = "message-channel"),
          (name = "message-channel-read", service = "message-channel-read"),
        ],
      )
    ),
    ( name = "control",
      worker = (
        modules = [(name = "worker", esModule = embed "startup-snapshot-globals-test.js")],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"control\""),
        ],
      )
    ),
    ( name = "stl-set",
      worker = (
        modules = [(name = "worker", esModule = embed "startup-snapshot-globals-test.js")],
