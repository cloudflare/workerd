using Workerd = import "/workerd/workerd.capnp";

# The worker is instantiated twice so that the bindings below cross an isolate boundary.
# Only the first service's test() runs; see the filter argument in BUILD.bazel.
const unitTests :Workerd.Config = (
  services = [
    ( name = "fetch-redirect-test", worker = .worker ),
    ( name = "fetch-redirect-test-target", worker = .worker )
  ]
);

const worker :Workerd.Worker = (
  modules = [
    (name = "worker", esModule = embed "fetch-redirect-test.js" )
  ],
  compatibilityFlags = ["nodejs_compat", "strip_authorization_on_cross_origin_redirect", "experimental"],
  bindings = [
    (name = "Server", service = (name = "fetch-redirect-test-target", entrypoint = "Server")),
    (name = "defaultExport", service = "fetch-redirect-test-target"),
  ]
);
