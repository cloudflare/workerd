using Workerd = import "/workerd/workerd.capnp";

# Runs dom-exception-test.js against the C++ DOMException (jsg/dom-exception.h).

const unitTests :Workerd.Config = (
  services = [
    ( name = "dom-exception-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "dom-exception-test.js")
        ],
        compatibilityFlags = ["nodejs_compat"],
        bindings = [(name = "USING_TS_IMPL", json = "false")],
      )
    ),
  ],
);
