        compatibilityFlags = ["nodejs_compat", "experimental", "unsafe_module"],
        durableObjectNamespaces = [
          ( className = "LoaderHolder", uniqueKey = "loader-holder" ),
        ],
        durableObjectStorage = ( localDisk = "TEST_TMPDIR" ),
        bindings = [
          ( name = "LOADER", workerLoader = () ),
          ( name = "HOLDER", durableObjectNamespace = "LoaderHolder" ),
        ],
      )
    ),
  ],
);
