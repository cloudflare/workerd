using Workerd = import "/workerd/workerd.capnp";

# Module identity across a startup snapshot; see startup-snapshot-modules-test.js. The runner's
# test() fetches every case service and asserts its report. The @all-autogates variant turns the
# startup-snapshot autogate on, so every service here goes through the zygote; the other
# variants run them as plain Workers.

const compatibilityFlags :List(Text) = [
  "nodejs_compat",
  "nodejs_compat_v2",
  "enable_nodejs_process_v2",
  "typescript_implemented_streams",
  "experimental",
  "unsafe_module",
];

const unitTests :Workerd.Config = (
  services = [
    ( name = "runner",
      worker = (
        modules = [
          (name = "worker.js", esModule = embed "startup-snapshot-modules-test.js"),
          (name = "lib.js", esModule = "globalThis.__libEvaluations = (globalThis.__libEvaluations ?? 0) + 1; export const token = {};"),
          (name = "data.json", json = "{\"answer\": 42}"),
        ],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"runner\""),
          (name = "case", service = "case"),
          (name = "case-cjs", service = "case-cjs"),
        ],
      )
    ),
    ( name = "case",
      worker = (
        modules = [
          (name = "worker.js", esModule = embed "startup-snapshot-modules-test.js"),
          (name = "lib.js", esModule = "globalThis.__libEvaluations = (globalThis.__libEvaluations ?? 0) + 1; export const token = {};"),
          (name = "data.json", json = "{\"answer\": 42}"),
        ],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"case\""),
        ],
      )
    ),
    ( name = "case-cjs",
      worker = (
        modules = [
          (name = "main.js", esModule = embed "startup-snapshot-modules-cjs-test.js"),
          (name = "worker.js", esModule = embed "startup-snapshot-modules-test.js"),
          (name = "lib.js", esModule = "globalThis.__libEvaluations = (globalThis.__libEvaluations ?? 0) + 1; export const token = {};"),
          (name = "data.json", json = "{\"answer\": 42}"),
          (name = "cjs.js", commonJsModule = "module.exports = { token: {} };"),
        ],
        compatibilityFlags = .compatibilityFlags,
        bindings = [
          (name = "MODE", json = "\"case-cjs\""),
        ],
      )
    ),
  ],
  # typescript_implemented_streams needs the per-isolate bootstrap in every variant.
  autogates = ["workerd-autogate-per-isolate-javascript-bootstrap"],
);
