using Workerd = import "/workerd/workerd.capnp";

# The worker is instantiated twice so that the bindings below cross an isolate boundary.
# Only the first service's test() runs; see the filter argument in BUILD.bazel.
const unitTests :Workerd.Config = (
  services = [
    ( name = "queue-metrics-sentinel-test", worker = .worker ),
    ( name = "queue-metrics-sentinel-test-target", worker = .worker ),
  ],
);

const worker :Workerd.Worker = (
  modules = [
    ( name = "worker", esModule = embed "queue-metrics-sentinel-test.js" )
  ],
  bindings = [
    ( name = "QUEUE", queue = "queue-metrics-sentinel-test-target" ),
  ],
  compatibilityFlags = ["nodejs_compat", "queues_json_messages", "capture_async_api_throws"],
);
