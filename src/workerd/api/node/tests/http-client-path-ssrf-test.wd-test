using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "http-client-path-ssrf-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "http-client-path-ssrf-test.js")
        ],
        # url_standard gives the WHATWG URL parser that production Workers
        # use, which strips leading control characters and spaces and removes
        # tabs and newlines. The legacy parser does neither.
        compatibilityFlags = ["nodejs_compat", "nodejs_compat_v2", "experimental", "enable_nodejs_http_modules", "url_standard"],
      )
    ),
  ],
);
