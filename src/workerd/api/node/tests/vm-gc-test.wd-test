      compatibilityFlags = [
        "nodejs_compat", "nodejs_compat_v2", "enable_nodejs_vm_module", "enable_nodejs_vm_context",
        "allow_insecure_inefficient_logged_eval", "enable_weak_ref", "experimental"
      ]
    )
  )],
);
