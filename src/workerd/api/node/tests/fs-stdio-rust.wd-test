using Workerd = import "/workerd/workerd.capnp";

# Runs fs-stdio-test.js against the Rust virtual file system (io/vfs, under the
# RUST_VFS autogate).

const unitTests :Workerd.Config = (
  services = [
    ( name = "fs-stdio-rust",
      worker = (
        modules = [
          (name = "worker", esModule = embed "fs-stdio-test.js")
        ],
        compatibilityFlags = ["nodejs_compat", "experimental", "enable_nodejs_fs_module"],
        bindings = [(name = "USING_TS_IMPL", json = "false")],
      )
    ),
  ],
  autogates = ["workerd-autogate-rust-vfs"],
);
