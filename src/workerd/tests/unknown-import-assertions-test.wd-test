using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "unknown-import-assertions-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "unknown-import-assertions-test.js"),
          (name = "static-attr-root", esModule = "export * from './static-attr-dep';"),
          (name = "static-attr-sibling", esModule = "export * from './static-attr-dep';"),
          (name = "static-attr-dep",
           esModule = "export { default } from './static-attr-leaf' with { a: 'b' };"),
          (name = "static-attr-leaf", esModule = "export default 1;"),
        ],
        compatibilityFlags = [
          "nodejs_compat",
          "throw_on_unrecognized_import_assertion",
        ]
      )
    ),
  ],
);
