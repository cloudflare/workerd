load("//:build/kj_test.bzl", "kj_test")
load("//:build/wd_cc_benchmark.bzl", "wd_cc_benchmark")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_test.bzl", "wd_test")

wd_cc_library(
    name = "bench-tools",
    hdrs = ["bench-tools.h"],
    defines = select({
        "//src/workerd/server:really_use_tcmalloc": ["WD_USE_TCMALLOC"],
        "//conditions:default": [],
    }),
    tags = ["workerd-benchmark"],
    visibility = ["//visibility:public"],
    deps = [
        "@capnp-cpp//src/kj:kj-test",
        "@google_benchmark//:benchmark",
    ] + select({
        # tcmalloc is only available on Linux and when use_tcmalloc is enabled.
        # We use the malloc_extension API to configure tcmalloc for deterministic benchmarks.
        "//src/workerd/server:really_use_tcmalloc": ["@tcmalloc//tcmalloc:malloc_extension"],
        "//conditions:default": [],
    }),
)

# Calls kj::setupAsyncIo(). The I/O backend is meant to be the BINARY's choice (kj_test and
# wd_cc_benchmark link //src/workerd/util:setup-async-io into every test binary; libraries do not
# carry it), but this one still does, so that binaries outside this repo which link the fixture
# without naming a backend keep linking.
# TODO(cleanup): drop the :setup-async-io dep here once every downstream binary that links
# :test-fixture depends on //src/workerd/util:setup-async-io (or @capnp-cpp//src/kj:kj-async)
# itself. Until then a downstream binary that also links kj-async-os gets two definitions of
# kj::setupAsyncIo / kj::UnixEventPort and the linker keeps whichever archive it meets first.
wd_cc_library(
    name = "test-fixture",
    srcs = ["test-fixture.c++"],
    hdrs = ["test-fixture.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/workerd/io",
        "//src/workerd/io:worker-entrypoint",
        "//src/workerd/jsg",
        "//src/workerd/server:workerd-api",
        "//src/workerd/util:autogate",
        "//src/workerd/util:capnp-util",
        "//src/workerd/util:setup-async-io",
        "@capnp-cpp//src/kj:kj-async-core",
        "@capnp-cpp//src/kj:kj-async-io",
    ],
)

kj_test(
    src = "test-fixture-test.c++",
    deps = [":test-fixture"],
)

