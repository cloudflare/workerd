load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_test.bzl", "wd_rust_test")
load("//src/rust/cxx/tools/bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")

wd_cc_library(
    name = "kj-rs-io-lib",
    srcs = glob(
        ["*.c++"],
        exclude = ["peer-filter.c++"],
    ),
    hdrs = glob(
        ["*.h"],
        exclude = ["peer-filter.h"],
    ),
    include_prefix = "kj-rs-io",
    # notify's FSEvents backend (watcher.rs on macOS) calls CoreServices; the crate's own
    # `#[link(kind = "framework")]` is not carried into Bazel's final link, so name it here, where
    # every binary linking kj-rs-io (C++ tests and the Rust test alike) picks it up.
    linkopts = select({
        "@platforms//os:macos": ["-framework CoreServices"],
        "//conditions:default": [],
    }),
    linkstatic = select({
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    strip_include_prefix = "/src/rust/cxx/kj-rs-io",
    visibility = ["//visibility:public"],
    deps = [
        ":bridge",
        ":peer-filter-lib",
        "//src/rust/cxx/kj-rs-tokio:kj-rs-tokio-lib",
    ],
)

wd_cc_library(
    name = "peer-filter-lib",
    srcs = ["peer-filter.c++"],
    hdrs = ["peer-filter.h"],
    include_prefix = "kj-rs-io",
    strip_include_prefix = "/src/rust/cxx/kj-rs-io",
    visibility = ["//visibility:public"],
    deps = [
        "@capnp-cpp//src/kj:kj-async-io",
    ],
)

# The dependencies of whichever I/O backend --//:io_backend selects, in one place. The two
# libraries with a WORKERD_RUST_IO_BACKEND_RUST arm (//src/workerd/util:setup-async-io and
# //src/workerd/server:cli-io-backend) depend on this instead of spelling the select out:
#   * rust (default): kj-rs-io + its cxx bridge and C++ adapter, the Rust runtime shims, and the
#     ABSTRACT kj async layers they implement (Promise machinery, streams / Network, plus the
#     declaration-only view of kj::UnixEventPort that the setupAsyncIo() shim defines inertly).
#     kj-async-os -- kj's own event loop and sockets -- is deliberately not here.
#   * cxx: kj's full async stack (the :kj-async umbrella, which brings kj-async-os).
wd_cc_library(
    name = "active-backend",
    visibility = ["//visibility:public"],
    deps = select({
        "//:io_backend_rust": [
            ":bridge",
            ":kj-rs-io",
            ":kj-rs-io-lib",
            "//deps:rust_runtime",
            "@capnp-cpp//src/kj:kj-async-core",
            "@capnp-cpp//src/kj:kj-async-io",
            "@capnp-cpp//src/kj:kj-async-os-hdrs",
        ],
        "//conditions:default": ["@capnp-cpp//src/kj:kj-async"],
    }),
)

rust_library(
    name = "kj-rs-io",
    srcs = glob(["*.rs"]),
    compile_data = glob(["*.h"]),
    edition = "2024",
    link_deps = [
        ":bridge",
        ":kj-rs-io-lib",
    ],
    target_compatible_with = select({
        "@//build/config:no_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/cxx",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-tokio",
        "@crates_vendor//:dns-lookup",
        "@crates_vendor//:libc",
        "@crates_vendor//:nix",
        "@crates_vendor//:notify",
        "@crates_vendor//:socket2",
        "@crates_vendor//:tokio",
    ] + select({
        "@platforms//os:windows": ["@crates_vendor//:windows-sys"],
        "//conditions:default": [],
    }),
)

wd_rust_test(
    name = "kj-rs-io_test",
    crate = "kj-rs-io",
    edition = "2024",
    deps = ["@crates_vendor//:static_assertions"],
)

rust_cxx_bridge(
    name = "bridge",
    src = "ffi.rs",
    hdrs = ["bridge.h"],
    include_prefix = "kj-rs-io",
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/cxx/kj-rs",
        "@capnp-cpp//src/kj:kj",
        # kj-rs-io IS the kj-side implementation of the rust I/O backend: it derives from the
        # abstract kj::AsyncIoStream / kj::Network / kj::LowLevelAsyncIoProvider interfaces and
        # reuses portable helpers (kj::newOneWayPipe, kj::CidrRange, the AsyncInputStream /
        # AsyncOutputStream default-method vtable slots). Those live in the ABSTRACT layers
        # :kj-async-core (Promise machinery) + :kj-async-io (abstract streams / Network / CIDR;
        # no event loop). It does NOT call kj::setupAsyncIo / kj::UnixEventPort, so it never
        # needs :kj-async-os (the concrete OS event loop) -- the tokio-backed EventPort
        # (kj-rs-tokio) replaces it. A stray setupAsyncIo would be an undefined-symbol link
        # error, the intended backstop.
        "@capnp-cpp//src/kj:kj-async-core",
        "@capnp-cpp//src/kj:kj-async-io",
        "//src/rust/cxx:core",
    ],
)
