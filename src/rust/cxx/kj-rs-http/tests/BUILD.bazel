# C++ <-> Rust <-> C++ round-trip tests for the kj-rs-http HttpHeaders / HttpService
# FFI bridge. Migrated verbatim from workerd's src/rust/kj/tests.

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//src/rust/cxx/tools/bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")

rust_library(
    name = "tests",
    srcs = glob(["*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates_vendor//:async-trait"],
    target_compatible_with = select({
        "@//build/config:no_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":bridge",
        "//src/rust/cxx",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-http",
    ],
)

rust_cxx_bridge(
    name = "bridge",
    src = "lib.rs",
    include_prefix = "kj-rs-http/tests",
    deps = [
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-http:ffi",
    ],
)

cc_test(
    name = "ffi-test",
    size = "small",
    srcs = ["ffi-test.c++"],
    linkstatic = select({
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    target_compatible_with = select({
        "@//build/config:no_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":bridge",
        ":tests",
        "//src/rust/cxx/kj-rs-http:ffi",
        "//src/rust/cxx/third-party:runtime",
        "@capnp-cpp//src/kj:kj-test",
        "@capnp-cpp//src/kj/compat:kj-http",
    ],
)
