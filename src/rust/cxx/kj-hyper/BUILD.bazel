# kj-hyper: kj's HTTP interfaces over hyper, rustls and tungstenite's frame codec (the rust I/O
# backend).

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_test.bzl", "wd_rust_test")
load("//src/rust/cxx/tools/bazel:rust_cxx_bridge.bzl", "rust_cxx_bridge")

rust_library(
    name = "kj-hyper",
    srcs = glob(["*.rs"]),
    crate_name = "kj_hyper",
    edition = "2024",
    link_deps = [
        ":bridge",
        ":cc",
    ],
    target_compatible_with = select({
        "@//build/config:no_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/cxx",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-http",
        "//src/rust/cxx/kj-rs-io",
        "//src/rust/cxx/kj-rs-tokio",
        "@crates_vendor//:base64",
        "@crates_vendor//:bytes",
        "@crates_vendor//:flate2",
        "@crates_vendor//:futures",
        "@crates_vendor//:http",
        "@crates_vendor//:http-body",
        "@crates_vendor//:http-body-util",
        "@crates_vendor//:hyper",
        "@crates_vendor//:hyper-util",
        "@crates_vendor//:rand",
        "@crates_vendor//:rustls",
        "@crates_vendor//:rustls-native-certs",
        "@crates_vendor//:rustls-platform-verifier",
        "@crates_vendor//:sha1",
        "@crates_vendor//:tokio",
        "@crates_vendor//:tokio-rustls",
        "@crates_vendor//:tokio-tungstenite",
        "@crates_vendor//:tower-service",
    ],
)

wd_rust_test(
    name = "kj-hyper_test",
    crate = "kj-hyper",
    edition = "2024",
)

rust_cxx_bridge(
    name = "bridge",
    src = "ffi.rs",
    hdrs = [
        "hyper-http.h",
        "kj-hyper.h",
    ],
    include_prefix = "kj-hyper",
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/cxx:core",
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx/kj-rs-http:ffi-hdr",
        "//src/rust/cxx/kj-rs-io:kj-rs-io-lib",
        "@capnp-cpp//src/kj:kj",
        "@capnp-cpp//src/kj:kj-async-core",
        "@capnp-cpp//src/kj:kj-async-io",
        "@capnp-cpp//src/kj/compat:kj-http-types",
    ],
)

wd_cc_library(
    name = "cc",
    srcs = ["kj-hyper.c++"],
    include_prefix = "kj-hyper",
    linkstatic = select({
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    strip_include_prefix = "/src/rust/cxx/kj-hyper",
    visibility = ["//visibility:public"],
    deps = [
        ":bridge",
        "//src/rust/cxx/kj-rs-http:ffi",
        "//src/rust/cxx/kj-rs-io",
        "//src/rust/cxx/kj-rs-io:kj-rs-io-lib",
        "@capnp-cpp//src/kj",
        "@capnp-cpp//src/kj/compat:kj-http-types",
    ],
)
