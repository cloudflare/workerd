load("//:build/linking.bzl", "CC_LIBRARY_LINKSTATIC")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_compile_test.bzl", "wd_rust_compile_test")
load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

wd_rust_crate(
    name = "kj",
    cxx_bridge_deps = [
        "@capnp-cpp//src/kj/compat:kj-http",
    ],
    cxx_bridge_srcs = [
        "http.rs",
        "io.rs",
    ],
    link_deps = [
        ":ffi",
    ],
    proc_macro_deps = [
        "@crates_vendor//async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates_vendor//futures",
        "@crates_vendor//static_assertions",
    ],
)

# Snippets that must not compile against kj; each annotates the errors it expects. See
# build/wd_rust_compile_test.bzl.
wd_rust_compile_test(
    name = "compile-tests",
    srcs = glob(["compile-tests/*.rs"]),
    deps = [":kj"],
)

wd_cc_library(
    name = "ffi",
    srcs = [
        "ffi.c++",
    ],
    hdrs = [
        "ffi.h",
    ],
    linkstatic = CC_LIBRARY_LINKSTATIC,
    visibility = ["//visibility:public"],
    deps = [
        ":http.rs@cxx",
        "//src/rust/cxx-integration",
        "@capnp-cpp//src/kj",
        "@capnp-cpp//src/kj/compat:kj-http",
    ],
)
