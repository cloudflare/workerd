load("//:build/linking.bzl", "CC_LIBRARY_LINKSTATIC")
load("//:build/wd_cc_library.bzl", "wd_cc_library")
load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

# What the tests of Rust code over SQLite (`//src/rust/sqlite-rs`) need: workerd's metering allocator,
# which only a binary's startup installs, and a check that nothing was logged at ERROR.
wd_rust_crate(
    name = "sqlite-rs-testing",
    testonly = True,
    cxx_bridge_src = "lib.rs",
    link_deps = [
        ":ffi",
    ],
    visibility = ["//visibility:public"],
)

wd_cc_library(
    name = "ffi",
    testonly = True,
    srcs = [
        "ffi.c++",
    ],
    linkstatic = CC_LIBRARY_LINKSTATIC,
    deps = [
        ":lib.rs@cxx",
        "//src/workerd/util:sqlite-metering",
        "@capnp-cpp//src/kj",
    ],
)
