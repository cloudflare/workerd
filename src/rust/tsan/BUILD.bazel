load("//:build/wd_rust_test.bzl", "wd_rust_test")

wd_rust_test(
    name = "race",
    srcs = ["race.rs"],
    edition = "2024",
    target_compatible_with = select({
        "//build/platforms:sanitizer_thread": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

wd_rust_test(
    name = "clone_fd",
    srcs = ["clone_fd.rs"],
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@crates_vendor//:libc"],
)

wd_rust_test(
    name = "tokio_test",
    srcs = ["tokio_test.rs"],
    edition = "2024",
    deps = ["@crates_vendor//:tokio"],
)
