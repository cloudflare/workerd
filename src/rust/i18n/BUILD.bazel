load("//:build/wd_rust_crate.bzl", "wd_rust_crate")

wd_rust_crate(
    name = "i18n",
    cxx_bridge_deps = [
        "//src/rust/jsg",
        "@simdutf",
        "@workerd-v8//:v8",
    ],
    cxx_bridge_src = "ffi.rs",
    # ICU, which rust_icu_sys binds to, is linked through V8.
    link_deps = ["@workerd-v8//:v8"],
    # rust_icu_sys's `versioned_function!` expands in this crate and reads the ICU version from
    # here. Keep it synchronized with the rust_icu_sys annotation in build/deps/rust.MODULE.bazel.
    rustc_env = {"RUST_ICU_MAJOR_VERSION_NUMBER": "78"},
    test_deps = ["//src/rust/jsg-test"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/rust/jsg",
        "@crates_vendor//:rust_icu_sys",
        "@crates_vendor//:thiserror",
    ],
)
