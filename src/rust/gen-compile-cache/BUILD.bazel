load("@workerd//:build/linking.bzl", "CC_LIBRARY_LINKSTATIC")
load("@workerd//:build/wd_cc_library.bzl", "wd_cc_library")
load("@workerd//:build/wd_rust_binary.bzl", "wd_rust_binary")

wd_rust_binary(
    name = "gen-compile-cache",
    cxx_bridge_src = "main.rs",
    link_deps = [
        ":cxx-bridge",
        ":strip-debug",
    ],
    test_size = "large",
    visibility = ["//visibility:public"],
    deps = [
        "@crates_vendor//:clap",
    ],
)

# Links gen-compile-cache without debug info, which is most of the binary and of the link's work,
# and which every compile cache action would fetch. A build tool has little use for it: symbol
# names still identify the frames of a crash's stack trace.
wd_cc_library(
    name = "strip-debug",
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--strip-debug"],
        "@platforms//os:macos": ["-Wl,-S"],
        "//conditions:default": [],
    }),
)

wd_cc_library(
    name = "cxx-bridge",
    srcs = [
        "cxx-bridge.c++",
    ],
    hdrs = [
        "cxx-bridge.h",
    ],
    linkstatic = CC_LIBRARY_LINKSTATIC,
    deps = [
        ":gen-compile-cache@cxx",
        "//src/rust/cxx-integration",
        "//src/workerd/jsg",
        "//src/workerd/jsg:compile-cache",
        "@capnp-cpp//src/kj",
    ],
)
