using Workerd = import "/workerd/workerd.capnp";

const unitTests :Workerd.Config = (
  services = [
    ( name = "crypto-key-parity-test",
      worker = (
        modules = [
          (name = "worker", esModule = embed "crypto-key-parity-test.js"),
          (name = "crypto-key-parity-expected.js",
           esModule = embed "crypto-key-parity-expected.js"),
        ],
        compatibilityFlags = ["nodejs_compat"],
        bindings = [
          (name = "variant", text = "classic"),
          (name = "key", cryptoKey = (
            raw = "0123456789abcdef0123456789abcdef",
            algorithm = (json = "{\"name\": \"HMAC\", \"hash\": \"SHA-256\"}"),
            usages = [sign, verify],
          )),
        ],
      )
    ),
    ( name = "crypto-key-parity-test-spec",
      worker = (
        modules = [
          (name = "worker", esModule = embed "crypto-key-parity-test.js"),
          (name = "crypto-key-parity-expected.js",
           esModule = embed "crypto-key-parity-expected.js"),
        ],
        compatibilityFlags = ["nodejs_compat", "webcrypto_modern_algorithms", "spec_compliant_property_attributes", "immutable_api_prototypes", "experimental"],
        bindings = [
          (name = "variant", text = "spec"),
          (name = "key", cryptoKey = (
            raw = "0123456789abcdef0123456789abcdef",
            algorithm = (json = "{\"name\": \"HMAC\", \"hash\": \"SHA-256\"}"),
            usages = [sign, verify],
          )),
        ],
      )
    ),
  ],
);
