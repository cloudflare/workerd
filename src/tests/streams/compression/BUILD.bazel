load("//:build/wd_test.bzl", "wd_test")

# The compression streams suite runs the same test modules under two
# configs: compression-cpp against the C++ implementation, compression-ts
# against the TypeScript implementation.

compression_suite_srcs = glob(["*.js"]) + ["compression-modules.capnp"]

wd_test(
    size = "large",
    src = "compression-cpp.wd-test",
    data = compression_suite_srcs,
)

wd_test(
    size = "large",
    src = "compression-ts.wd-test",
    args = ["--experimental"],
    data = compression_suite_srcs,
)

# Legacy (pre-flag) regression guard, C++ implementation only. The
# @all-compat-flags variant is disabled: at the 2999-12-31 date the flags
# the cell deliberately omits would all turn on.
wd_test(
    src = "compression-cpp-legacy.wd-test",
    data = compression_suite_srcs,
    generate_all_compat_flags_variant = False,
)
