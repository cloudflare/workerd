using Workerd = import "/workerd/workerd.capnp";
using ScalingModules = import "scaling-modules.capnp";

# Runs the queue scaling suite against the TypeScript implementation, with
# byte-for-byte the same modules as scaling-cpp.wd-test. The flags pinned
# there are deliberately absent: the TypeScript implementation hard-codes
# the modern behaviors, and the `@` / `@all-compat-flags` variants verify
# that indifference with the flags all off and all on.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-scaling-ts",
      worker = (
        modules = ScalingModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "typescript_implemented_streams",
          "experimental",
        ],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
