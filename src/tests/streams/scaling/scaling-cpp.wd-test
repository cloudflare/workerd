using Workerd = import "/workerd/workerd.capnp";
using ScalingModules = import "scaling-modules.capnp";

# Runs the queue scaling suite against the C++ implementation;
# scaling-ts.wd-test runs the identical modules against the TypeScript
# implementation.
#
# No compatibilityDate: the wd_test variants supply the date axis and the
# tests must hold at both extremes. Date-gated semantics are pinned by flag:
# - streams_enable_constructors: the tests build their streams with
#   `new ReadableStream` / `new WritableStream`.
# - streams_byob_reader_detaches_buffer: modern BYOB semantics (the passed
#   buffer is detached; the result view is over the transferred buffer).
# - internal_stream_byob_return_view: a BYOB read at EOF returns a
#   zero-length view rather than undefined.
# - workers_api_getters_setters_on_prototype: prototype accessors.
# - set_tostring_tag: Symbol.toStringTag branding.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-scaling-cpp",
      worker = (
        modules = ScalingModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "streams_enable_constructors",
          "streams_byob_reader_detaches_buffer",
          "internal_stream_byob_return_view",
          "workers_api_getters_setters_on_prototype",
          "set_tostring_tag",
        ],
      )
    ),
  ],
);
