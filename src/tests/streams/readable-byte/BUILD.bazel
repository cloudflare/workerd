load("//:build/wd_test.bzl", "wd_test")

# The readable-byte streams suite runs the same test modules under two
# configs: readable-byte-cpp against the C++ implementation,
# readable-byte-ts against the TypeScript implementation.

readable_byte_suite_srcs = glob(["*.js"]) + ["readable-byte-modules.capnp"]

wd_test(
    src = "readable-byte-cpp.wd-test",
    data = readable_byte_suite_srcs,
)

wd_test(
    src = "readable-byte-ts.wd-test",
    args = ["--experimental"],
    data = readable_byte_suite_srcs,
)

# The main C++ cell plus the dateless opt-in pedantic_wpt flag; probed to
# produce no observable deltas on this suite's surface, so the shared
# modules run unbranched.
wd_test(
    src = "readable-byte-cpp-pedantic.wd-test",
    data = readable_byte_suite_srcs,
)
