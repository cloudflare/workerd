load("//:build/wd_test.bzl", "wd_test")

# The piping suite runs the same test modules under two configs:
# piping-cpp against the C++ implementation, piping-ts against the
# TypeScript implementation.

piping_suite_srcs = glob(["*.js"]) + ["piping-modules.capnp"]

wd_test(
    src = "piping-cpp.wd-test",
    data = piping_suite_srcs,
)

wd_test(
    src = "piping-ts.wd-test",
    args = ["--experimental"],
    data = piping_suite_srcs,
)

# The main C++ cell plus the dateless opt-in pedantic_wpt flag; probed
# to produce no observable deltas, so the shared modules run unbranched.
wd_test(
    src = "piping-cpp-pedantic.wd-test",
    data = piping_suite_srcs,
)

# Legacy (pre-flag) regression guard, C++ implementation only. The
# @all-compat-flags variant is disabled: at the 2999-12-31 date the
# flags this cell deliberately omits would all turn on.
wd_test(
    src = "piping-cpp-legacy.wd-test",
    data = piping_suite_srcs,
    generate_all_compat_flags_variant = False,
)
