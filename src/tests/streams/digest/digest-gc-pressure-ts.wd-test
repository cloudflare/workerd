using Workerd = import "/workerd/workerd.capnp";

# gcDuringCloseOfDroppedStream (gc-pressure.js) against the TypeScript
# implementation, apart from the main suite because it needs its own V8
# flags: --stress-incremental-marking keeps a major GC's marking in progress
# almost all the time, so allocations inside the sinks often finish it.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-digest-gc-pressure-ts",
      worker = (
        modules = [(name = "main", esModule = embed "gc-pressure.js")],
        compatibilityFlags = ["nodejs_compat", "typescript_implemented_streams", "experimental"],
      )
    ),
  ],
  v8Flags = ["--stress-incremental-marking"],
);
