using Workerd = import "/workerd/workerd.capnp";
using HtmlrewriterModules = import "htmlrewriter-modules.capnp";

# The SAME modules against the C++ streams implementation and the
# TypeScript HTMLRewriter (src/per_isolate/htmlrewriter/, under the
# TS_HTML_REWRITER autogate), under the same flags as htmlrewriter-cpp.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-htmlrewriter-cpp-ts-rewriter",
      worker = (
        modules = HtmlrewriterModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "streams_enable_constructors",
          "transformstream_enable_standard_constructor",
          "fixup-transform-stream-backpressure",
          "html_rewriter_treats_esi_include_as_void_tag",
        ],
        bindings = [
          (name = "USING_TS_REWRITER", json = "true"),
        ],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-html-rewriter"],
);
