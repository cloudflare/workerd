using Workerd = import "/workerd/workerd.capnp";
using WritableModules = import "writable-modules.capnp";

# Runs the writable streams suite against the TypeScript implementation,
# with byte-for-byte the same modules as writable-cpp.wd-test. The flags
# pinned there are deliberately absent: the TypeScript implementation
# hard-codes the modern behaviors, and the `@` / `@all-compat-flags`
# variants verify that indifference with the flags all off and all on.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-writable-ts",
      worker = (
        modules = WritableModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "typescript_implemented_streams",
          "experimental",
          "enable_weak_ref",
        ],
      )
    ),
  ],
  # For gc.js. Maglev tiers up after a few calls, so the sink algorithms
  # run optimized well before gc.js: optimized code must not keep an ended
  # stream's sink reachable (sinkReleasedOnceEnded).
  v8Flags = [
    "--expose-gc",
    "--invocation-count-for-maglev=5",
    "--minimum-invocations-after-ic-update=2",
  ],
);
