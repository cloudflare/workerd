using Workerd = import "/workerd/workerd.capnp";
using IdentityModules = import "identity-modules.capnp";

# Runs the identity streams suite against the legacy C++ implementation.
# identity-ts.wd-test runs the identical modules against the TypeScript
# implementation; sharing the test modules is the point — behavioral drift
# between the two implementations fails one config or the other.
#
# No compatibilityDate is set: the wd_test variants supply the date axis
# (2000-01-01 for `@`, 2999-12-31 for `@all-compat-flags`), and the tests
# must hold at both extremes. The semantics the tests depend on are pinned
# by naming the specific flags instead:
# - streams_byob_reader_detaches_buffer: modern BYOB semantics (the passed
#   buffer is detached; the result view is over the transferred buffer).
# - internal_stream_byob_return_view: a BYOB read at EOF returns a
#   zero-length view rather than undefined.
# - internal_writable_stream_abort_clears_queue: modern abort semantics.
# - workers_api_getters_setters_on_prototype: readable/writable are
#   prototype accessors rather than per-instance own properties.
# - capture_async_api_throws: async APIs return rejected promises rather
#   than throwing synchronously (e.g. writing an invalid chunk type).
# - set_tostring_tag: classes install Symbol.toStringTag, so instances
#   stringify as e.g. [object IdentityTransformStream].
# - enhanced_error_serialization: error tunneling preserves a custom error
#   subclass's name instead of folding it into a plain Error's message
#   (observable in cancel-reason surfacing; see cancel-reason-types.js).
# The TypeScript implementation hard-codes these modern behaviors, so the
# flags also keep the two cells comparable at the oldest compat date.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-identity-cpp",
      worker = (
        # The shared module list: see identity-modules.capnp.
        modules = IdentityModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "streams_byob_reader_detaches_buffer",
          "internal_stream_byob_return_view",
          "internal_writable_stream_abort_clears_queue",
          "workers_api_getters_setters_on_prototype",
          "capture_async_api_throws",
          "set_tostring_tag",
          "enhanced_error_serialization",
        ],
      )
    ),
  ],
  # For gc-interplay.js.
  v8Flags = ["--expose-gc"],
);
