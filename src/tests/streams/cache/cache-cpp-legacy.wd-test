using Workerd = import "/workerd/workerd.capnp";

# C++-only legacy cell: concurrent clone puts run under the original
# TransformStream alias. The BUILD rule disables the @all-compat-flags
# variant because it would enable streams_enable_constructors, allowing the
# modern path selected by transformstream_enable_standard_constructor.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-cache-cpp-legacy",
      worker = (
        modules = [
          (name = "main", esModule = embed "legacy-main.js"),
          (name = "cache-streams", esModule = embed "cache-streams.js"),
        ],
        cacheApiOutbound = "cache-backend",
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
    ( name = "cache-backend",
      worker = (
        modules = [
          (name = "backend", esModule = embed "cache-backend.js"),
        ],
      )
    ),
  ],
);
