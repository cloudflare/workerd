load("//:build/wd_test.bzl", "wd_test")

# The EventTarget suite runs the same test modules under three configs:
# event-target-cpp against the C++ implementation, event-target-cpp-pedantic
# against it with pedantic_wpt, and event-target-ts against the TypeScript
# implementation. event-target-cpp-legacy guards the C++ behaviors without
# the date-gated flags.

event_target_suite_srcs = glob(["*.js"]) + ["event-target-modules.capnp"]

wd_test(
    size = "large",
    src = "event-target-cpp.wd-test",
    data = event_target_suite_srcs,
)

wd_test(
    size = "large",
    src = "event-target-cpp-pedantic.wd-test",
    data = event_target_suite_srcs,
)

wd_test(
    size = "large",
    src = "event-target-ts.wd-test",
    args = ["--experimental"],
    data = event_target_suite_srcs,
)

# Legacy (pre-flag) regression guard, C++ implementation only. The
# @all-compat-flags variant is disabled: at the 2999-12-31 date the flags
# the cell deliberately omits would all turn on.
wd_test(
    size = "large",
    src = "event-target-cpp-legacy.wd-test",
    data = event_target_suite_srcs,
    generate_all_compat_flags_variant = False,
)
