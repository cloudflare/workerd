load("//:build/wd_test.bzl", "wd_test")

# The EventSource suite runs the same test modules under four cells: main
# (reading the C++ streams), main reading the TypeScript streams, opt-in (the
# dateless flags that change the surface) and legacy (the semantic flags
# turned off).

eventsource_suite_srcs = glob(["*.js"]) + ["eventsource-modules.capnp"]

wd_test(
    src = "eventsource.wd-test",
    data = eventsource_suite_srcs,
)

wd_test(
    src = "eventsource-ts-streams.wd-test",
    args = ["--experimental"],
    data = eventsource_suite_srcs,
)

wd_test(
    src = "eventsource-opt-in.wd-test",
    args = ["--experimental"],
    data = eventsource_suite_srcs,
)

wd_test(
    src = "eventsource-legacy.wd-test",
    data = eventsource_suite_srcs,
)
