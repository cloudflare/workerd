using Workerd = import "/workerd/workerd.capnp";
using MessageChannelModules = import "messagechannel-modules.capnp";

# Runs the MessageChannel suite against the C++ implementation
# (api/messagechannel.h); messagechannel-ts.wd-test runs the identical
# modules against the TypeScript one.
#
# No compatibilityDate: the wd_test variants supply the date axis and the
# tests must hold at both extremes. Date-gated semantics are pinned by flag:
# - nodejs_compat: node:assert, node:test and node:util.
# - enable_nodejs_worker_threads_module: node:worker_threads, which must hand
#   out the same classes as the globals.
# - expose_global_message_channel: the classes are globals.
# - set_tostring_tag: [object MessagePort] and [object MessageChannel].
# - spec_compliant_dispatch_exceptions: listener exceptions are reported,
#   and the port dispatches 'messageerror'.

const unitTests :Workerd.Config = (
  services = [
    ( name = "events-messagechannel-cpp",
      worker = (
        modules = MessageChannelModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "enable_nodejs_worker_threads_module",
          "expose_global_message_channel",
          "set_tostring_tag",
          "spec_compliant_dispatch_exceptions",
        ],
        bindings = [(name = "USING_TS_IMPL", json = "false")],
      )
    ),
  ],
  v8Flags = ["--expose-gc"],
);
