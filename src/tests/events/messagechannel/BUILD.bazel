load("//:build/wd_test.bzl", "wd_test")

# The MessageChannel suite runs the same test modules under a C++ and a
# TypeScript cell of each kind: main, opt-in (the dateless flags that change
# the surface) and legacy (the semantic flags turned off).
#
# The C++ cells disable the @all-autogates variant: enabling every autogate
# enables TS_MESSAGE_CHANNEL, which swaps in the TypeScript implementation
# under a cell whose USING_TS_IMPL binding says C++. The TypeScript cells
# keep it.

messagechannel_suite_srcs = glob(["*.js"]) + ["messagechannel-modules.capnp"]

wd_test(
    src = "messagechannel-cpp.wd-test",
    data = messagechannel_suite_srcs,
    generate_all_autogates_variant = False,
)

wd_test(
    src = "messagechannel-ts.wd-test",
    data = messagechannel_suite_srcs,
)

wd_test(
    src = "messagechannel-cpp-opt-in.wd-test",
    args = ["--experimental"],
    data = messagechannel_suite_srcs,
    generate_all_autogates_variant = False,
)

wd_test(
    src = "messagechannel-ts-opt-in.wd-test",
    args = ["--experimental"],
    data = messagechannel_suite_srcs,
)

wd_test(
    src = "messagechannel-cpp-legacy.wd-test",
    data = messagechannel_suite_srcs,
    generate_all_autogates_variant = False,
)

wd_test(
    src = "messagechannel-ts-legacy.wd-test",
    data = messagechannel_suite_srcs,
)
