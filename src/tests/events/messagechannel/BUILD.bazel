load("//:build/wd_test.bzl", "wd_test")

# The MessageChannel suite runs the same test modules under three cells: main,
# opt-in (the dateless flags that change the surface) and legacy (the
# semantic flags turned off).

messagechannel_suite_srcs = glob(["*.js"]) + ["messagechannel-modules.capnp"]

wd_test(
    src = "messagechannel.wd-test",
    data = messagechannel_suite_srcs,
)

wd_test(
    src = "messagechannel-opt-in.wd-test",
    args = ["--experimental"],
    data = messagechannel_suite_srcs,
)

wd_test(
    src = "messagechannel-legacy.wd-test",
    data = messagechannel_suite_srcs,
)
