using Workerd = import "/workerd/workerd.capnp";
using MessageChannelModules = import "messagechannel-modules.capnp";

# Unflagged legacy cell, C++ implementation: without
# expose_global_message_channel the classes are reached through
# node:worker_threads, without set_tostring_tag they are untagged, and
# without spec_compliant_dispatch_exceptions a listener exception is
# redispatched as a 'message'. See legacy-*.js. The three flags
# are pinned off by their disable names, so the cell holds at every date.

const unitTests :Workerd.Config = (
  services = [
    ( name = "events-messagechannel-cpp-legacy",
      worker = (
        modules = MessageChannelModules.legacyModules,
        compatibilityFlags = [
          "nodejs_compat",
          "enable_nodejs_worker_threads_module",
          "no_expose_global_message_channel",
          "do_not_set_tostring_tag",
          "no_spec_compliant_dispatch_exceptions",
        ],
        bindings = [(name = "USING_TS_IMPL", json = "false")],
      )
    ),
  ],
);
