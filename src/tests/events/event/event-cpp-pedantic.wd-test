using Workerd = import "/workerd/workerd.capnp";
using EventModules = import "event-modules.capnp";

# The main C++ cell plus the dateless opt-in pedantic_wpt flag, which makes
# isTrusted an own data property of every event and currentTarget null
# outside dispatch. The shared modules branch on which-impl's pedanticWpt
# where it shows.

const unitTests :Workerd.Config = (
  services = [
    ( name = "events-event-cpp-pedantic",
      worker = (
        modules = EventModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "workers_api_getters_setters_on_prototype",
          "set_tostring_tag",
          "pedantic_wpt",
        ],
      )
    ),
  ],
);
