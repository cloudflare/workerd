using Workerd = import "/workerd/workerd.capnp";
using EventModules = import "event-modules.capnp";

# Runs the Event suite against the C++ implementation; event-ts.wd-test runs
# the identical modules against the TypeScript implementation.
#
# No compatibilityDate: the wd_test variants supply the date axis and the
# tests must hold at both extremes. Date-gated semantics are pinned by flag,
# and event-cpp-legacy.wd-test guards their unflagged sides:
# - nodejs_compat: node:assert and node:util for the tests themselves.
# - workers_api_getters_setters_on_prototype: attributes are prototype
#   accessors (unflagged, they are per-instance data properties, and
#   srcElement reads the current target).
# - set_tostring_tag: Symbol.toStringTag branding.

const unitTests :Workerd.Config = (
  services = [
    ( name = "events-event-cpp",
      worker = (
        modules = EventModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "workers_api_getters_setters_on_prototype",
          "set_tostring_tag",
        ],
      )
    ),
  ],
);
