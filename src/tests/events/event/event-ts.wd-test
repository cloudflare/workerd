using Workerd = import "/workerd/workerd.capnp";
using EventModules = import "event-modules.capnp";

# Runs the Event suite against the TypeScript implementation, with
# byte-for-byte the same modules as event-cpp.wd-test. The flags pinned
# there are deliberately absent: the TypeScript implementation hard-codes
# the modern behaviors, and the `@` / `@all-compat-flags` variants verify
# that indifference with the flags all off and all on.

const unitTests :Workerd.Config = (
  services = [
    ( name = "events-event-ts",
      worker = (
        modules = EventModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "typescript_implemented_events",
          "experimental",
        ],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
