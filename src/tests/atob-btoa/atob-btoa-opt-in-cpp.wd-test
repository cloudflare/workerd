using Workerd = import "/workerd/workerd.capnp";
using AtobBtoaModules = import "atob-btoa-modules.capnp";

# Runs the atob() and btoa() suite against the C++ implementation
# (api/global-scope.c++), with the
# dateless WebIDL opt-in spec_compliant_property_attributes, which is
# experimental, hence --experimental in BUILD.bazel.
#
# No compatibilityDate: the wd_test variants supply the date axis and the
# tests must hold at both extremes. nodejs_compat is for node:assert.

const unitTests :Workerd.Config = (
  services = [
    ( name = "atob-btoa-opt-in-cpp",
      worker = (
        modules = AtobBtoaModules.modules,
        compatibilityFlags = [
          "nodejs_compat",
          "spec_compliant_property_attributes",
        ],
        bindings = [
          (name = "USING_TS_IMPL", json = "false"),
        ],
      )
    ),
  ],
);
