using Workerd = import "/workerd/workerd.capnp";

# Runs the DOMException benchmarks against the TypeScript implementation
# (src/per_isolate/dom-exception.ts, under TS_DOM_EXCEPTION). No
# compatibilityDate, so that the variants supply it.

const unitTests :Workerd.Config = (
  services = [
    ( name = "dom-exception-ts",
      worker = (
        modules = [(name = "worker", esModule = embed "dom-exception.js")],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-dom-exception"],
);
