load("//:build/wd_bench.bzl", "wd_bench")

# The DOMException benchmarks, against the C++ implementation and V8's
# (V8_DOM_EXCEPTION). Enabling every autogate enables V8_DOM_EXCEPTION, so
# the C++ config has no @all-autogates variant; the V8 config enables it
# itself.

wd_bench(
    src = "dom-exception-cpp.wd-bench",
    data = ["dom-exception.js"],
    generate_all_autogates_variant = False,
)

wd_bench(
    src = "dom-exception-v8.wd-bench",
    data = ["dom-exception.js"],
)
