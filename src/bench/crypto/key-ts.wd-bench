using Workerd = import "/workerd/workerd.capnp";

# Runs the CryptoKey benchmarks against the TypeScript implementation
# (src/per_isolate/crypto/key.ts). No compatibilityDate, so
# that the variants supply it.

const unitTests :Workerd.Config = (
  services = [
    ( name = "key-ts",
      worker = (
        modules = [(name = "worker", esModule = embed "key.js")],
        compatibilityFlags = ["nodejs_compat"],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-webcrypto"],
);
