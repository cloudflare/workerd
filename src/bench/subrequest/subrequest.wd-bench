  services = [
    ( name = "subrequest",
      worker = (
        modules = [(name = "worker", esModule = embed "subrequest.js")],
        bindings = [
          (name = "TARGET", service = "target"),
          (name = "TARGET_RPC", service = (name = "target", entrypoint = "Rpc")),
          (name = "COUNTERS", durableObjectNamespace = "Counter"),
          (name = "LOADER", workerLoader = ()),
          (name = "RESTORER", service = (name = "restorer", entrypoint = "Restorer")),
        ],
        durableObjectNamespaces = [
          (className = "Counter", uniqueKey = "subrequest-bench-counter"),
        ],
        durableObjectStorage = (inMemory = void),
