    # Mints the restored stub, which needs `ctx.restore()` and so the flag.
    ( name = "restorer",
      worker = (
        modules = [(name = "worker", esModule = embed "restorer.js")],
        compatibilityFlags = ["allow_irrevocable_stub_storage"],
        bindings = [(name = "TARGET", service = "target")],
      )
    ),
    ( name = "target",
      worker = (
        modules = [(name = "worker", esModule = embed "target.js")],
      )
    ),
  ],
);
