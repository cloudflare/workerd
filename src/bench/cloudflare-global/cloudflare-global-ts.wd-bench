using Workerd = import "/workerd/workerd.capnp";

# Runs the Cloudflare global's benchmarks against the TypeScript
# implementation (src/per_isolate/cloudflare-global.ts, under
# TS_CLOUDFLARE_GLOBAL). No compatibilityDate, so that the variants supply it.

const unitTests :Workerd.Config = (
  services = [
    ( name = "cloudflare-global-ts",
      worker = (
        modules = [(name = "worker", esModule = embed "cloudflare-global.js")],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-cloudflare-global"],
);
