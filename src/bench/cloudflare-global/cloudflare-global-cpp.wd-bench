using Workerd = import "/workerd/workerd.capnp";

# Runs the Cloudflare global's benchmarks against the C++ implementation
# (api/global-scope.h). No compatibilityDate, so that the variants supply it.

const unitTests :Workerd.Config = (
  services = [
    ( name = "cloudflare-global-cpp",
      worker = (
        modules = [(name = "worker", esModule = embed "cloudflare-global.js")],
      )
    ),
  ],
);
