using Workerd = import "/workerd/workerd.capnp";

# Runs the URL benchmarks against the TypeScript implementation
# (src/per_isolate/url/), with its ada backend. No compatibilityDate, so
# that the variants supply it; url_standard is pinned, so every variant
# measures the ada path.

const unitTests :Workerd.Config = (
  services = [
    ( name = "url-ts",
      worker = (
        modules = [(name = "worker", esModule = embed "url.js")],
        compatibilityFlags = ["url_standard"],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-url"],
);
