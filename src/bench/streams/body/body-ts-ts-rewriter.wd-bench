using Workerd = import "/workerd/workerd.capnp";
using BodyModules = import "body-modules.capnp";

# Runs the htmlRewriter group (the filter in BUILD.bazel) against the TypeScript
# streams implementation and the TypeScript HTMLRewriter
# (src/per_isolate/htmlrewriter/), under the TS_HTML_REWRITER autogate
# alone, with the same modules as body-ts.wd-bench, whose htmlRewriter
# cases run the C++ HTMLRewriter.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-body-ts-ts-rewriter",
      worker = (
        modules = BodyModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
        bindings = [
          ( name = "SELF", service = "streams-body-ts-ts-rewriter" ),
        ],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-html-rewriter"],
);
