using Workerd = import "/workerd/workerd.capnp";
using DigestModules = import "digest-modules.capnp";

# Runs the DigestStream benchmarks against the legacy C++ implementation;
# digest-ts.wd-bench runs the identical modules against the TypeScript
# implementation. No compatibilityDate and no flags: see
# src/bench/streams/AGENTS.md.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-digest-cpp",
      worker = (
        modules = DigestModules.modules,
      )
    ),
  ],
);
