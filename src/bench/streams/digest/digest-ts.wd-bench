using Workerd = import "/workerd/workerd.capnp";
using DigestModules = import "digest-modules.capnp";

# Runs the DigestStream benchmarks against the TypeScript implementation
# (typescript_implemented_streams + the per-isolate bootstrap autogate),
# with byte-for-byte the same modules as digest-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-digest-ts",
      worker = (
        modules = DigestModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
