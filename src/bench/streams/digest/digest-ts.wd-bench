using Workerd = import "/workerd/workerd.capnp";
using DigestModules = import "digest-modules.capnp";

# Runs the DigestStream benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# digest-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-digest-ts",
      worker = (
        modules = DigestModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
