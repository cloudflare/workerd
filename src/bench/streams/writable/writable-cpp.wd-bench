using Workerd = import "/workerd/workerd.capnp";
using WritableModules = import "writable-modules.capnp";

# Runs the writable benchmarks against the legacy C++ implementation;
# writable-ts.wd-bench runs the identical modules against the TypeScript
# implementation. No compatibilityDate and no flags: see
# src/bench/streams/AGENTS.md.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-writable-cpp",
      worker = (
        modules = WritableModules.modules,
      )
    ),
  ],
);
