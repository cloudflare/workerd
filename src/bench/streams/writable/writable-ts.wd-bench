using Workerd = import "/workerd/workerd.capnp";
using WritableModules = import "writable-modules.capnp";

# Runs the writable benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# writable-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-writable-ts",
      worker = (
        modules = WritableModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
