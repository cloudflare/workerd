load("//:build/wd_bench.bzl", "wd_bench")

# The byte stream benchmarks run the same modules under two configs:
# readable-byte-cpp against the legacy C++ implementation, readable-byte-ts
# against the TypeScript implementation.

readable_byte_bench_srcs = glob(["*.js"]) + ["readable-byte-modules.capnp"]

wd_bench(
    src = "readable-byte-cpp.wd-bench",
    data = readable_byte_bench_srcs,
)

wd_bench(
    src = "readable-byte-ts.wd-bench",
    args = ["--experimental"],
    data = readable_byte_bench_srcs,
)
