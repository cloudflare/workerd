using Workerd = import "/workerd/workerd.capnp";
using ReadableByteModules = import "readable-byte-modules.capnp";

# Runs the byte stream benchmarks against the TypeScript implementation
# (typescript_implemented_streams + the per-isolate bootstrap autogate),
# with byte-for-byte the same modules as readable-byte-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-readable-byte-ts",
      worker = (
        modules = ReadableByteModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
