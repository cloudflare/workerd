using Workerd = import "/workerd/workerd.capnp";
using EncodingModules = import "encoding-modules.capnp";

# Runs the encoding stream benchmarks against the TypeScript implementation
# (typescript_implemented_streams + the per-isolate bootstrap autogate),
# with byte-for-byte the same modules as encoding-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-encoding-ts",
      worker = (
        modules = EncodingModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
