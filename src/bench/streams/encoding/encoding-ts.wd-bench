using Workerd = import "/workerd/workerd.capnp";
using EncodingModules = import "encoding-modules.capnp";

# Runs the encoding stream benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# encoding-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-encoding-ts",
      worker = (
        modules = EncodingModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
