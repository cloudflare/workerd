load("//:build/wd_bench.bzl", "wd_bench")

# The encoding stream benchmarks run the same modules under two configs:
# encoding-cpp against the legacy C++ implementation, encoding-ts against
# the TypeScript implementation.

encoding_bench_srcs = glob(["*.js"]) + ["encoding-modules.capnp"]

wd_bench(
    src = "encoding-cpp.wd-bench",
    data = encoding_bench_srcs,
)

wd_bench(
    src = "encoding-ts.wd-bench",
    args = ["--experimental"],
    data = encoding_bench_srcs,
)
