using Workerd = import "/workerd/workerd.capnp";
using PipingModules = import "piping-modules.capnp";

# Runs the piping benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# piping-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-piping-ts",
      worker = (
        modules = PipingModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
