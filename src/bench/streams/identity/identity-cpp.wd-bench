using Workerd = import "/workerd/workerd.capnp";
using IdentityModules = import "identity-modules.capnp";

# Runs the identity stream benchmarks against the legacy C++ implementation;
# identity-ts.wd-bench runs the identical modules against the TypeScript
# implementation. No compatibilityDate and no flags: see
# src/bench/streams/AGENTS.md.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-identity-cpp",
      worker = (
        modules = IdentityModules.modules,
      )
    ),
  ],
);
