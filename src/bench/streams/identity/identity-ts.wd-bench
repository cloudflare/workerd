using Workerd = import "/workerd/workerd.capnp";
using IdentityModules = import "identity-modules.capnp";

# Runs the identity stream benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# identity-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-identity-ts",
      worker = (
        modules = IdentityModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
