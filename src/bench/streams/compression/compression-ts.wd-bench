using Workerd = import "/workerd/workerd.capnp";
using CompressionModules = import "compression-modules.capnp";

# Runs the compression stream benchmarks against the TypeScript
# implementation (the TS_WEB_STREAMS autogate), with byte-for-byte the same
# modules as compression-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-compression-ts",
      worker = (
        modules = CompressionModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
