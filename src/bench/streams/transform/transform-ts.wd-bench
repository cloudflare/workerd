using Workerd = import "/workerd/workerd.capnp";
using TransformModules = import "transform-modules.capnp";

# Runs the transform benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# transform-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-transform-ts",
      worker = (
        modules = TransformModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
