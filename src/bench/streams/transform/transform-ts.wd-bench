using Workerd = import "/workerd/workerd.capnp";
using TransformModules = import "transform-modules.capnp";

# Runs the transform benchmarks against the TypeScript implementation
# (typescript_implemented_streams + the per-isolate bootstrap autogate),
# with byte-for-byte the same modules as transform-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-transform-ts",
      worker = (
        modules = TransformModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
