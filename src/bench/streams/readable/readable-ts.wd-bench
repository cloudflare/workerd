using Workerd = import "/workerd/workerd.capnp";
using ReadableModules = import "readable-modules.capnp";

# Runs the readable benchmarks against the TypeScript implementation
# (the TS_WEB_STREAMS autogate), with byte-for-byte the same modules as
# readable-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-readable-ts",
      worker = (
        modules = ReadableModules.modules,
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-web-streams"],
);
