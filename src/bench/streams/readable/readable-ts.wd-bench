using Workerd = import "/workerd/workerd.capnp";
using ReadableModules = import "readable-modules.capnp";

# Runs the readable benchmarks against the TypeScript implementation
# (typescript_implemented_streams + the per-isolate bootstrap autogate),
# with byte-for-byte the same modules as readable-cpp.wd-bench.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-readable-ts",
      worker = (
        modules = ReadableModules.modules,
        compatibilityFlags = ["typescript_implemented_streams"],
      )
    ),
  ],
  autogates = [
    "workerd-autogate-per-isolate-javascript-bootstrap",
  ],
);
