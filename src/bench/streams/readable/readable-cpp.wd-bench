using Workerd = import "/workerd/workerd.capnp";
using ReadableModules = import "readable-modules.capnp";

# Runs the readable benchmarks against the legacy C++ implementation;
# readable-ts.wd-bench runs the identical modules against the TypeScript
# implementation. No compatibilityDate and no flags: see
# src/bench/streams/AGENTS.md.

const unitTests :Workerd.Config = (
  services = [
    ( name = "streams-readable-cpp",
      worker = (
        modules = ReadableModules.modules,
      )
    ),
  ],
);
