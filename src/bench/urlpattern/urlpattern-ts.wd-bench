using Workerd = import "/workerd/workerd.capnp";

# Runs the URLPattern benchmarks against the TypeScript implementation
# (src/per_isolate/urlpattern/, under TS_URL_PATTERN). No compatibilityDate,
# so that the variants supply it; urlpattern_standard is pinned, so every
# variant measures the ada path.

const unitTests :Workerd.Config = (
  services = [
    ( name = "urlpattern-ts",
      worker = (
        modules = [(name = "worker", esModule = embed "urlpattern.js")],
        compatibilityFlags = ["urlpattern_standard"],
      )
    ),
  ],
  autogates = ["workerd-autogate-ts-url-pattern"],
);
