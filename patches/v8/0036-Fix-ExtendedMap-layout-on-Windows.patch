index f351cb0..9795025 100644
--- a/src/objects/js-interceptor-map.tq
+++ b/src/objects/js-interceptor-map.tq
@@ -8,9 +8,6 @@
 @hasSameInstanceTypeAsParent
 @doNotGenerateCast
 extern class JSInterceptorMap extends ExtendedMap {
-  flags: uint8;
-  @ifnot(TAGGED_SIZE_8_BYTES) extended_padding[2]: uint8;
-  @if(TAGGED_SIZE_8_BYTES) extended_padding[6]: uint8;
   named_interceptor: InterceptorInfo;
   indexed_interceptor: InterceptorInfo;
   // This prototype validity cell guards modifications of the interceptor's
diff --git a/src/objects/map.h b/src/objects/map.h
index 594d4c7..1f20233 100644
--- a/src/objects/map.h
+++ b/src/objects/map.h
@@ -1288,7 +1288,15 @@ V8_ABSTRACT_OBJECT class ExtendedMap : public Map {
   static const int kStartOfStrongExtendedFieldsOffset;
 
   std::atomic<uint8_t> bit_field_ex_;
-  // Leaves kTaggedSize-1 unused bytes, they will be used by subclasses.
+  // Scalar storage for subclasses, which must not declare scalar members of
+  // their own: Torque derives a subclass's first field offset from
+  // sizeof(ExtendedMap), and MSVC rounds that up to alignof(ExtendedMap) while
+  // still placing subclass members in the resulting tail padding. Spelling the
+  // padding out keeps sizeof(ExtendedMap) equal to the subclass's first field
+  // offset on every ABI, and keeps that offset equal to
+  // kStartOfStrongExtendedFieldsOffset so the GC scans exactly the tagged
+  // fields.
+  uint8_t extended_padding_[kTaggedSize - 1];
 } V8_OBJECT_END;
 
 constexpr int ExtendedMapSizeForKind(ExtendedMapKind kind);
@@ -1300,6 +1308,17 @@ inline constexpr int ExtendedMap::kMinimumSize =
 inline constexpr int ExtendedMap::kStartOfStrongExtendedFieldsOffset =
     kMinimumSize;
 
+// Map::BodyDescriptor scans a subclass's tagged fields as the half-open range
+// [kStartOfStrongExtendedFieldsOffset, AllocatedSize()), so a subclass's first
+// tagged field has to start exactly at kStartOfStrongExtendedFieldsOffset. If
+// sizeof(ExtendedMap) were rounded up past its declared fields, an ABI that
+// reuses base-class tail padding would place that field earlier and the GC
+// would either scan a scalar word as a tagged pointer or skip a live one.
+static_assert(sizeof(ExtendedMap) ==
+                  ExtendedMap::kStartOfStrongExtendedFieldsOffset,
+              "ExtendedMap's declared fields must exactly fill it, so that "
+              "subclasses start at kStartOfStrongExtendedFieldsOffset");
+
 
 
 // The cache for maps used by normalized (dictionary mode) objects.
diff --git a/src/objects/map.tq b/src/objects/map.tq
index cb85e77..c28d8d1 100644
--- a/src/objects/map.tq
+++ b/src/objects/map.tq
@@ -116,7 +116,9 @@ bitfield struct ExtendedMapBitFields extends uint8 {
 @doNotGenerateCast
 extern class ExtendedMap extends Map {
   bit_field_ex: ExtendedMapBitFields;
-  // Leaves kTaggedSize-1 unused bytes, they will be used by subclasses.
+  // Scalar storage for subclasses; see ExtendedMap in map.h.
+  @ifnot(TAGGED_SIZE_8_BYTES) extended_padding[3]: uint8;
+  @if(TAGGED_SIZE_8_BYTES) extended_padding[7]: uint8;
 }
 
 @export
