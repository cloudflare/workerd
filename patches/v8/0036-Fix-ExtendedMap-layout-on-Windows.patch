From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikhail Aizatsky <maizatskyi@cloudflare.com>
Date: Tue, 16 Jun 2026 22:00:00 +0000
Subject: Fix ExtendedMap layout on Windows

For a class marked @cppObjectLayoutDefinition, Torque emits the first field
offset of a subclass as the literal expression sizeof(Parent) and asserts it
against offsetof of the C++ member. MSVC rounds sizeof(ExtendedMap) up to
alignof(ExtendedMap) yet still places a subclass's members in the resulting
tail padding, so the two disagree: with pointer compression Torque computes
JSInterceptorMap::kFlagsOffset as 44 while offsetof puts flags_ at 41, and
every following field and the class size are off by the same amount.

Spell ExtendedMap's trailing bytes out as an explicit array so its declared
fields exactly fill kTaggedSize. There is then no tail padding for any ABI to
reuse, so sizeof(ExtendedMap) equals the subclass's first field offset
everywhere.

The same tail padding also decides where the GC starts scanning. Map::
BodyDescriptor derives the extended fields' range from
kStartOfStrongExtendedFieldsOffset, which is RoundUp(sizeof(ExtendedMap),
kTaggedSize), not from the subclass's first tagged member. Any ABI that
disagrees about the padding therefore makes the GC scan JSInterceptorMap's
scalar flags word as a tagged pointer, which corrupts the heap rather than
failing to build. Assert both ends of that range so a mismatch is a
compile error instead.
diff --git a/src/codegen/code-stub-assembler.cc b/src/codegen/code-stub-assembler.cc
index 50551c7..42f2a72 100644
--- a/src/codegen/code-stub-assembler.cc
+++ b/src/codegen/code-stub-assembler.cc
@@ -1564,9 +1564,10 @@ void CodeStubAssembler::BranchIfFastIterableToListInterceptor(
 
   CSA_DCHECK(this, IsJSInterceptorMap(map));
 
-  // Check if the interceptor supports fast iterable to list conversion.
-  TNode<Uint8T> flags =
-      LoadObjectField<Uint8T>(map, offsetof(JSInterceptorMap, flags_));
+  // Check if the interceptor supports fast iterable to list conversion. The
+  // flags byte lives in ExtendedMap's scalar storage; see ExtendedMap in map.h.
+  TNode<Uint8T> flags = LoadObjectField<Uint8T>(
+      map, offsetof(ExtendedMap, extended_padding_));
   TNode<BoolT> supports_fast =
       IsSetWord32<JSInterceptorMap::SupportsFastIterableToListBit>(flags);
   GotoIfNot(supports_fast, if_false);
@@ -1609,8 +1610,8 @@ void CodeStubAssembler::BranchIfFastIterableToListInterceptor(
         UpdateWord32<JSInterceptorMap::SupportsFastIterableToListBit>(
             flags, Uint32Constant(0)));
 
-    StoreObjectFieldNoWriteBarrier(map, offsetof(JSInterceptorMap, flags_),
-                                   cleared_flags);
+    StoreObjectFieldNoWriteBarrier(
+        map, offsetof(ExtendedMap, extended_padding_), cleared_flags);
     Goto(if_false);
   }
 }
diff --git a/src/objects/js-interceptor-map-inl.h b/src/objects/js-interceptor-map-inl.h
index e10726e..41b718a 100644
--- a/src/objects/js-interceptor-map-inl.h
+++ b/src/objects/js-interceptor-map-inl.h
@@ -44,14 +44,16 @@ void JSInterceptorMap::set_fast_case_validity_cell(Tagged<Cell> cell,
 }
 
 bool JSInterceptorMap::supports_fast_iterable_to_list() const {
-  return SupportsFastIterableToListBit::decode(flags_);
+  return SupportsFastIterableToListBit::decode(flags());
 }
 void JSInterceptorMap::set_supports_fast_iterable_to_list(bool value) {
-  flags_ = SupportsFastIterableToListBit::update(flags_, value);
+  flags() = SupportsFastIterableToListBit::update(flags(), value);
 }
 
+uint8_t& JSInterceptorMap::flags() { return extended_padding_[0]; }
+uint8_t JSInterceptorMap::flags() const { return extended_padding_[0]; }
+
 void JSInterceptorMap::init_flags_and_clear_extended_padding() {
-  flags_ = 0;
   memset(extended_padding_, 0, sizeof(extended_padding_));
 }
 
diff --git a/src/objects/js-interceptor-map.h b/src/objects/js-interceptor-map.h
index 1bf7735..6d7ee21 100644
--- a/src/objects/js-interceptor-map.h
+++ b/src/objects/js-interceptor-map.h
@@ -39,14 +39,30 @@ V8_OBJECT class JSInterceptorMap : public ExtendedMap {
 
   inline void init_flags_and_clear_extended_padding();
 
+ private:
+  // The flags byte lives in ExtendedMap's scalar storage; see map.h.
+  inline uint8_t& flags();
+  inline uint8_t flags() const;
+
  public:
-  uint8_t flags_;
-  uint8_t extended_padding_[kTaggedSize - 2];
   TaggedMember<InterceptorInfo> named_interceptor_;
   TaggedMember<InterceptorInfo> indexed_interceptor_;
   TaggedMember<Cell> fast_case_validity_cell_;
 } V8_OBJECT_END;
 
+// See the corresponding assert on ExtendedMap in map.h: the GC derives the
+// start of this class's tagged fields from ExtendedMap's size rather than from
+// named_interceptor_, so the two have to agree.
+static_assert(offsetof(JSInterceptorMap, named_interceptor_) ==
+                  ExtendedMap::kStartOfStrongExtendedFieldsOffset,
+              "JSInterceptorMap's first tagged field must start where "
+              "Map::BodyDescriptor begins scanning extended map fields");
+static_assert(offsetof(JSInterceptorMap, fast_case_validity_cell_) +
+                      kTaggedSize ==
+                  sizeof(JSInterceptorMap),
+              "JSInterceptorMap must have no tail padding, so that the range "
+              "Map::BodyDescriptor scans ends on its last tagged field");
+
 }  // namespace v8::internal
 
 #include "src/objects/object-macros-undef.h"
