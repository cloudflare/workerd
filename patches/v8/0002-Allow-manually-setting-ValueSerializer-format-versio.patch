From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James M Snell <jasnell@gmail.com>
Date: Wed, 16 Mar 2022 08:59:21 -0700
Subject: Allow manually setting ValueSerializer format version

Refs: https://bitbucket.cfdata.org/projects/MIRRORS/repos/v8/pull-requests/2/overview
Signed-off-by: James M Snell <jsnell@cloudflare.com>

diff --git a/include/v8-value-serializer.h b/include/v8-value-serializer.h
index 923a13a76f5220cbb106447f84c279b9a1df3079..240fd2da3b1eb2c7858b026525a963402bcb5c62 100644
--- a/include/v8-value-serializer.h
+++ b/include/v8-value-serializer.h
@@ -166,6 +166,11 @@ class V8_EXPORT ValueSerializer {
                       SharedImmutableArrayBufferMode::kDisabled);
   ~ValueSerializer();
 
+  /**
+   * Instruct the ValueSerializer to write at a specific serializer version.
+   */
+  Maybe<bool> SetWriteVersion(uint32_t version);
+
   /**
    * Writes out a header, which includes the format version.
    */
diff --git a/src/api/api.cc b/src/api/api.cc
index b0f6f545065a910fd64494c2856a61916f228fc8..d6c78ff4d47f5c5326c8f1c56c95c3f071941909 100644
--- a/src/api/api.cc
+++ b/src/api/api.cc
@@ -3727,6 +3727,10 @@ ValueSerializer::ValueSerializer(
 
 ValueSerializer::~ValueSerializer() { delete private_; }
 
+Maybe<bool> ValueSerializer::SetWriteVersion(uint32_t version) {
+  return private_->serializer.SetWriteVersion(version);
+}
+
 void ValueSerializer::WriteHeader() { private_->serializer.WriteHeader(); }
 
 void ValueSerializer::SetTreatArrayBufferViewsAsHostObjects(bool mode) {
diff --git a/src/objects/value-serializer.cc b/src/objects/value-serializer.cc
index 5c42c3ac3fa93cf10ca25c1b4518c7e052ebc79e..d41af9c888b7b658f5b5f7daa6f5dd97a4e16507 100644
--- a/src/objects/value-serializer.cc
+++ b/src/objects/value-serializer.cc
@@ -311,6 +311,7 @@ ValueSerializer::ValueSerializer(
     : isolate_(isolate),
       delegate_(delegate),
       zone_(isolate->allocator(), ZONE_NAME),
+      version_(kLatestVersion),
       id_map_(isolate->heap(), ZoneAllocationPolicy(&zone_)),
       array_buffer_transfer_map_(isolate->heap(), ZoneAllocationPolicy(&zone_)),
       share_immutable_array_buffer_(share_immutable_array_buffer) {
@@ -336,9 +337,17 @@ ValueSerializer::~ValueSerializer() {
   }
 }
 
+Maybe<bool> ValueSerializer::SetWriteVersion(uint32_t version) {
+  if (version < 13 || version > kLatestVersion) {
+    return ThrowDataCloneError(MessageTemplate::kDataCloneError);
+  }
+  version_ = version;
+  return Just(true);
+}
+
 void ValueSerializer::WriteHeader() {
   WriteTag(SerializationTag::kVersion);
-  WriteVarint(kLatestVersion);
+  WriteVarint(version_);
 }
 
 void ValueSerializer::SetTreatArrayBufferViewsAsHostObjects(bool mode) {
@@ -1142,10 +1151,12 @@ Maybe<bool> ValueSerializer::WriteJSArrayBufferView(
   WriteVarint(static_cast<uint8_t>(tag));
   WriteVarint<size_t>(view->byte_offset());
   WriteVarint<size_t>(view->byte_length());
-  uint32_t flags =
-      JSArrayBufferViewIsLengthTracking::encode(view->is_length_tracking()) |
-      JSArrayBufferViewIsBackedByRab::encode(view->is_backed_by_rab());
-  WriteVarint(flags);
+  if (version_ >= 14) {
+    uint32_t flags =
+        JSArrayBufferViewIsLengthTracking::encode(view->is_length_tracking()) |
+        JSArrayBufferViewIsBackedByRab::encode(view->is_backed_by_rab());
+    WriteVarint(flags);
+  }
   return ThrowIfOutOfMemory();
 }
 
