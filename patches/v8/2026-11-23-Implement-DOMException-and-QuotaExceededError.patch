+MaybeHandle<JSObject> ErrorUtils::ConstructQuotaExceededError(
+    Isolate* isolate, DirectHandle<JSFunction> target,
+    DirectHandle<Object> new_target, DirectHandle<String> message,
+    DirectHandle<Object> quota, DirectHandle<Object> requested,
+    FrameSkipMode mode, DirectHandle<Object> caller,
+    MaybeDirectHandle<String> stack) {
+  DCHECK(IsNull(*quota) || IsNumber(*quota));
+  DCHECK(IsNull(*requested) || IsNumber(*requested));
+  Factory* factory = isolate->factory();
+  // The object is created before the constructor steps check the amounts.
+  Handle<JSObject> error;
+  ASSIGN_RETURN_ON_EXCEPTION(
+      isolate, error, NewDOMExceptionObject(isolate, target, new_target));
