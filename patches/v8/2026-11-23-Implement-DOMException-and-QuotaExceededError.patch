+    THROW_NEW_ERROR(
+        isolate,
+        NewRangeError(MessageTemplate::kQuotaExceededErrorNegativeQuota));
+  }
+  if (IsNumber(*requested) && Object::NumberValue(*requested) < 0) {
+    THROW_NEW_ERROR(
+        isolate,
+        NewRangeError(MessageTemplate::kQuotaExceededErrorNegativeRequested));
+  }
+  if (IsNumber(*quota) && IsNumber(*requested) &&
+      Object::NumberValue(*requested) < Object::NumberValue(*quota)) {
+    THROW_NEW_ERROR(
+        isolate,
