+namespace {
+
+// How a DOMException constructor's stack skips frames: those up to new.target,
+// so that a subclass's constructor is left out, as for subclasses of Error.
+FrameSkipMode DOMExceptionFrameSkipMode(DirectHandle<Object> new_target) {
+  return IsJSFunction(*new_target) ? SKIP_UNTIL_SEEN : SKIP_FIRST;
+}
+
+// Converts an optional DOMString argument, which is `default_value` if absent.
+MaybeDirectHandle<String> ToDOMString(Isolate* isolate,
+                                      DirectHandle<Object> value,
+                                      DirectHandle<String> default_value) {
+  if (IsUndefined(*value)) return default_value;
+  return Object::ToString(isolate, value);
+}
+
+// The QuotaExceededErrorOptions member `key` of `options`, converted to a
+// WebIDL double, or null if it is not present.
+MaybeDirectHandle<Object> GetQuotaExceededErrorAmount(
+    Isolate* isolate, DirectHandle<JSReceiver> options, const char* key) {
+  DirectHandle<String> key_string =
+      isolate->factory()->InternalizeUtf8String(key);
+  DirectHandle<Object> value;
+  ASSIGN_RETURN_ON_EXCEPTION(
+      isolate, value, JSReceiver::GetProperty(isolate, options, key_string));
+  if (IsUndefined(*value)) return isolate->factory()->null_value();
+  ASSIGN_RETURN_ON_EXCEPTION(isolate, value, Object::ToNumber(isolate, value));
+  if (!std::isfinite(Object::NumberValue(*value))) {
+    THROW_NEW_ERROR(isolate,
+                    NewTypeError(MessageTemplate::kQuotaExceededErrorNonFinite,
+                                 key_string));
+  }
+  return value;
+}
+
+}  // namespace
+
+// https://webidl.spec.whatwg.org/#dom-domexception-domexception
+BUILTIN(DOMExceptionConstructor) {
+  HandleScope scope(isolate);
+  Factory* factory = isolate->factory();
+  DirectHandle<Object> new_target = args.new_target();
+  if (IsUndefined(*new_target)) {
+    THROW_NEW_ERROR_RETURN_FAILURE(
+        isolate,
+        NewTypeError(MessageTemplate::kConstructorNonCallable,
+                     direct_handle(args.target()->shared()->Name(), isolate)));
+  }
+  // The arguments are converted in order, before the object is created.
+  DirectHandle<String> message;
+  ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+      isolate, message,
+      ToDOMString(isolate, args.atOrUndefined(isolate, 1),
+                  factory->empty_string()));
+  DirectHandle<String> name;
+  ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+      isolate, name,
+      ToDOMString(isolate, args.atOrUndefined(isolate, 2),
+                  factory->Error_string()));
+  RETURN_RESULT_OR_FAILURE(
+      isolate, ErrorUtils::ConstructDOMException(
+                   isolate, args.target(), new_target, message, name,
+                   DOMExceptionFrameSkipMode(new_target), new_target));
+}
+
+// https://webidl.spec.whatwg.org/#dom-quotaexceedederror-quotaexceedederror
+BUILTIN(QuotaExceededErrorConstructor) {
+  HandleScope scope(isolate);
+  Factory* factory = isolate->factory();
+  DirectHandle<Object> new_target = args.new_target();
+  if (IsUndefined(*new_target)) {
+    THROW_NEW_ERROR_RETURN_FAILURE(
+        isolate,
+        NewTypeError(MessageTemplate::kConstructorNonCallable,
+                     direct_handle(args.target()->shared()->Name(), isolate)));
+  }
+  // The arguments are converted in order, the dictionary's members in
+  // lexicographic order, before the object is created.
+  DirectHandle<String> message;
+  ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+      isolate, message,
+      ToDOMString(isolate, args.atOrUndefined(isolate, 1),
+                  factory->empty_string()));
+  DirectHandle<Object> options = args.atOrUndefined(isolate, 2);
+  DirectHandle<Object> quota = factory->null_value();
+  DirectHandle<Object> requested = factory->null_value();
+  if (!IsNullOrUndefined(*options)) {
+    if (!IsJSReceiver(*options)) {
+      THROW_NEW_ERROR_RETURN_FAILURE(
+          isolate,
+          NewTypeError(MessageTemplate::kQuotaExceededErrorOptionsNotObject));
+    }
+    ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+        isolate, quota,
+        GetQuotaExceededErrorAmount(isolate, Cast<JSReceiver>(options),
+                                    "quota"));
+    ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+        isolate, requested,
+        GetQuotaExceededErrorAmount(isolate, Cast<JSReceiver>(options),
+                                    "requested"));
+  }
+  RETURN_RESULT_OR_FAILURE(
+      isolate,
+      ErrorUtils::ConstructQuotaExceededError(
+          isolate, args.target(), new_target, message, quota, requested,
+          DOMExceptionFrameSkipMode(new_target), new_target));
+}
