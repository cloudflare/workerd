+DirectHandle<Object> ErrorUtils::GetDOMExceptionSlot(
+    Isolate* isolate, DirectHandle<Object> object, DirectHandle<Symbol> slot) {
+  if (!IsJSReceiver(*object)) return isolate->factory()->undefined_value();
+  return JSReceiver::GetDataProperty(isolate, Cast<JSReceiver>(object), slot);
