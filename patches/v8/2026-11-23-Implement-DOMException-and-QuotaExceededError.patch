+namespace {
+
+// The stack an API caller gave a DOMException, if any.
+i::MaybeDirectHandle<i::String> ToDOMExceptionStack(Local<String> raw_stack) {
+  if (raw_stack.IsEmpty()) return {};
+  return Utils::OpenDirectHandle(*raw_stack);
+}
+
+}  // namespace
+
+Local<Value> Exception::DOMException(Local<String> raw_message,
+                                     Local<String> raw_name,
+                                     Local<String> raw_stack) {
+  i::Isolate* i_isolate = i::Isolate::Current();
+  ApiRuntimeCallStatsScope rcs_scope(i_isolate, RCCId::kAPI_DOMException_New);
+  EnterV8NoScriptNoExceptionScope api_scope(i_isolate);
+  i::Tagged<i::Object> error;
+  {
+    i::HandleScope scope(i_isolate);
+    i::DirectHandle<i::JSFunction> constructor =
+        i_isolate->dom_exception_function();
+    i::DirectHandle<i::Object> no_caller;
+    error = *i::ErrorUtils::ConstructDOMException(
+                 i_isolate, constructor, constructor,
+                 Utils::OpenDirectHandle(*raw_message),
+                 Utils::OpenDirectHandle(*raw_name), i::SKIP_NONE, no_caller,
+                 ToDOMExceptionStack(raw_stack))
+                 .ToHandleChecked();
+  }
+  return Utils::ToLocal(i::direct_handle(error, i_isolate));
+}
+
+Local<Value> Exception::QuotaExceededError(Local<String> raw_message,
+                                           std::optional<double> quota,
+                                           std::optional<double> requested,
+                                           Local<String> raw_stack) {
+  auto is_valid_amount = [](std::optional<double> amount) {
+    return !amount || (std::isfinite(*amount) && *amount >= 0);
+  };
+  Utils::ApiCheck(is_valid_amount(quota) && is_valid_amount(requested) &&
+                      !(quota && requested && *requested < *quota),
+                  "v8::Exception::QuotaExceededError()",
+                  "Invalid quota or requested amount");
+  i::Isolate* i_isolate = i::Isolate::Current();
+  ApiRuntimeCallStatsScope rcs_scope(i_isolate,
+                                     RCCId::kAPI_QuotaExceededError_New);
+  EnterV8NoScriptNoExceptionScope api_scope(i_isolate);
+  i::Tagged<i::Object> error;
+  {
+    i::HandleScope scope(i_isolate);
+    i::Factory* factory = i_isolate->factory();
+    auto to_amount =
+        [&](std::optional<double> amount) -> i::DirectHandle<i::Object> {
+      if (amount) return factory->NewNumber(*amount);
+      return factory->null_value();
+    };
+    i::DirectHandle<i::JSFunction> constructor =
+        i_isolate->quota_exceeded_error_function();
+    i::DirectHandle<i::Object> no_caller;
+    error = *i::ErrorUtils::ConstructQuotaExceededError(
+                 i_isolate, constructor, constructor,
+                 Utils::OpenDirectHandle(*raw_message), to_amount(quota),
+                 to_amount(requested), i::SKIP_NONE, no_caller,
+                 ToDOMExceptionStack(raw_stack))
+                 .ToHandleChecked();
+  }
+  return Utils::ToLocal(i::direct_handle(error, i_isolate));
+}
+
+namespace {
+
+// What a DOMException holds under one of the private symbols ErrorUtils
+// describes, chosen by `slot`.
+template <typename SlotGetter>
+i::DirectHandle<i::Object> GetDOMExceptionSlot(
+    i::DirectHandle<i::JSObject> self, SlotGetter slot) {
+  i::Isolate* i_isolate = i::Isolate::Current();
+  return i::ErrorUtils::GetDOMExceptionSlot(i_isolate, self,
+                                            slot(i_isolate->factory()));
+}
+
+std::optional<double> ToAmount(i::DirectHandle<i::Object> value) {
+  if (i::IsNull(*value)) return std::nullopt;
+  return i::Object::NumberValue(*value);
+}
+
+}  // namespace
+
+Local<String> v8::DOMException::Name() const {
+  return Utils::ToLocal(i::Cast<i::String>(GetDOMExceptionSlot(
+      Utils::OpenDirectHandle(this),
+      [](i::Factory* f) { return f->dom_exception_name_symbol(); })));
+}
+
+Local<String> v8::DOMException::Message() const {
+  return Utils::ToLocal(i::Cast<i::String>(GetDOMExceptionSlot(
+      Utils::OpenDirectHandle(this),
+      [](i::Factory* f) { return f->dom_exception_message_symbol(); })));
+}
+
+uint16_t v8::DOMException::Code() const {
+  i::HandleScope scope(i::Isolate::Current());
+  return i::Smi::ToInt(*GetDOMExceptionSlot(
+      Utils::OpenDirectHandle(this),
+      [](i::Factory* f) { return f->dom_exception_code_symbol(); }));
+}
+
+std::optional<double> v8::QuotaExceededError::Quota() const {
+  i::HandleScope scope(i::Isolate::Current());
+  return ToAmount(GetDOMExceptionSlot(
+      Utils::OpenDirectHandle(this),
+      [](i::Factory* f) { return f->quota_exceeded_error_quota_symbol(); }));
+}
+
+std::optional<double> v8::QuotaExceededError::Requested() const {
+  i::HandleScope scope(i::Isolate::Current());
+  return ToAmount(
+      GetDOMExceptionSlot(Utils::OpenDirectHandle(this), [](i::Factory* f) {
+        return f->quota_exceeded_error_requested_symbol();
+      }));
+}
