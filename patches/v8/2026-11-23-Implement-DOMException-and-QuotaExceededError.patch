+#include "src/builtins/builtins-utils-gen.h"
+#include "src/builtins/builtins.h"
+#include "src/codegen/code-stub-assembler-inl.h"
+
+namespace v8 {
+namespace internal {
+
+#include "src/codegen/define-code-stub-assembler-macros.inc"
+
+// The attributes of DOMException and QuotaExceededError (WebIDL), which read
+// what an instance holds under one of the private symbols ErrorUtils
+// describes.
+class DOMExceptionBuiltinsAssembler : public CodeStubAssembler {
+ public:
+  explicit DOMExceptionBuiltinsAssembler(compiler::CodeAssemblerState* state)
+      : CodeStubAssembler(state) {}
+
+  // Returns what `receiver` holds under the root `slot`, or throws the
+  // TypeError for a receiver that is not an instance of the interface.
+  void ReturnSlotOrThrow(TNode<Context> context, TNode<Object> receiver,
+                         RootIndex slot) {
+    Label if_found(this), if_not_found(this, Label::kDeferred),
+        if_bailout(this, Label::kDeferred);
+    TVARIABLE(Object, var_value);
+    TVARIABLE(Uint32T, var_details);
+    // A mutable root, so loaded rather than embedded as a constant.
+    TNode<Symbol> name = CAST(CodeAssembler::LoadRoot(slot));
+
+    GotoIf(TaggedIsSmi(receiver), &if_not_found);
+    TNode<Map> map = LoadMap(CAST(receiver));
+    TNode<Uint16T> instance_type = LoadMapInstanceType(map);
+    GotoIfNot(IsJSReceiverInstanceType(instance_type), &if_not_found);
+    // The slots are data properties, so no getter is called, which keeps
+    // these builtins free of side effects for the debugger.
+    TryGetOwnProperty(context, CAST(receiver), CAST(receiver), map,
+                      instance_type, name, &if_found, &var_value, &var_details,
+                      nullptr, &if_not_found, &if_bailout, kReturnAccessorPair);
+
+    BIND(&if_found);
+    GotoIf(IsUndefined(var_value.value()), &if_not_found);
+    Return(var_value.value());
+
+    // A receiver the fast lookup does not handle, such as a proxy.
+    BIND(&if_bailout);
+    {
+      TNode<Object> value =
+          CallRuntime(Runtime::kGetProperty, context, receiver, name);
+      GotoIf(IsUndefined(value), &if_not_found);
+      Return(value);
+    }
+
+    BIND(&if_not_found);
+    ThrowTypeError(context, MessageTemplate::kIllegalInvocation);
+  }
+};
+
+TF_BUILTIN(DOMExceptionPrototypeGetName, DOMExceptionBuiltinsAssembler) {
+  ReturnSlotOrThrow(Parameter<Context>(Descriptor::kContext),
+                    Parameter<Object>(Descriptor::kReceiver),
+                    RootIndex::kDOMExceptionNameSymbol);
+}
+
+TF_BUILTIN(DOMExceptionPrototypeGetMessage, DOMExceptionBuiltinsAssembler) {
+  ReturnSlotOrThrow(Parameter<Context>(Descriptor::kContext),
+                    Parameter<Object>(Descriptor::kReceiver),
+                    RootIndex::kDOMExceptionMessageSymbol);
+}
+
+TF_BUILTIN(DOMExceptionPrototypeGetCode, DOMExceptionBuiltinsAssembler) {
+  ReturnSlotOrThrow(Parameter<Context>(Descriptor::kContext),
+                    Parameter<Object>(Descriptor::kReceiver),
+                    RootIndex::kDOMExceptionCodeSymbol);
+}
+
+TF_BUILTIN(QuotaExceededErrorPrototypeGetQuota, DOMExceptionBuiltinsAssembler) {
+  ReturnSlotOrThrow(Parameter<Context>(Descriptor::kContext),
+                    Parameter<Object>(Descriptor::kReceiver),
+                    RootIndex::kQuotaExceededErrorQuotaSymbol);
+}
+
+TF_BUILTIN(QuotaExceededErrorPrototypeGetRequested,
+           DOMExceptionBuiltinsAssembler) {
+  ReturnSlotOrThrow(Parameter<Context>(Descriptor::kContext),
+                    Parameter<Object>(Descriptor::kReceiver),
+                    RootIndex::kQuotaExceededErrorRequestedSymbol);
+}
