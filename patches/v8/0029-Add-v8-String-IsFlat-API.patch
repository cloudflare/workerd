   struct WriteFlags {
     enum {
       kNone = 0,
diff --git a/src/api/api.cc b/src/api/api.cc
index 7e1ad61fbc8e33159e00274849dc34c11840d14f..3e4625eee03185190d7cf51fc113f9e48aebc638 100644
