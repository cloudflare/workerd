+  heap()->set_promise_context_tag(*tag);
+}
+
+void Isolate::set_promise_cross_context_callback(
+    PromiseCrossContextCallback callback) {
+  promise_cross_context_callback_ = callback;
+  // Optimized code allocates promises inline as long as the PromiseHook
+  // protector holds, since inline allocation skips init hooks. It also leaves
+  // the promise untagged, so that its reactions would run in whichever context
+  // settles it. Context tagging is an init hook, so invalidate the protector
+  // to keep promise allocation in builtins and the runtime, which tag it.
+  if (callback != nullptr) UpdatePromiseHookProtector();
+}
