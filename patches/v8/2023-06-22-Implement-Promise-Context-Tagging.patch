+#include "test/unittests/test-utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace v8 {
+namespace {
+
+// Once optimized, each of these allocates the promise it returns inline, unless
+// promise allocation is kept out of optimized code.
+constexpr const char* kDerivers[] = {
+    "(base) => base.then((value) => value)",
+    "(base) => base.catch(() => {})",
+    "(base) => base.finally(() => {})",
+    "(base) => Promise.all([base]).then(([value]) => value)",
+    "async (base) => { await base; }",
+    "(base) => new Promise((resolve) => { base.then(resolve); })",
+};
+
+// Stores the tag of the promise being followed in the global `followedTag`.
+MaybeLocal<Promise> RecordFollowedTag(Local<Context> context,
+                                      Local<Promise> promise,
+                                      Local<Object> tag) {
+  Isolate* isolate = Isolate::GetCurrent();
+  CHECK(context->Global()
+            ->Set(context, String::NewFromUtf8Literal(isolate, "followedTag"),
+                  tag)
+            .FromJust());
+  return promise;
+}
+
+class PromiseContextTagTest : public TestWithContext {
+ protected:
+  // Optimizes each deriver with the natives syntax function `optimize`, derives
+  // a promise from a pending one under one context tag, and follows the derived
+  // promise under another. The follow must see the first tag, as it does when
+  // the deriver is not optimized.
+  void ExpectOptimizedDerivedPromisesTagged(const std::string& optimize,
+                                            const std::string& active_tier) {
+    i::FlagScope<bool> natives_syntax(&i::v8_flags.allow_natives_syntax, true);
+    isolate()->SetPromiseCrossContextCallback(RecordFollowedTag);
+
+    for (const char* deriver : kDerivers) {
+      SCOPED_TRACE(deriver);
+      SetGlobalProperty("derive", RunJS(deriver));
+      RunJS(("%PrepareFunctionForOptimization(derive);"
+             "derive(Promise.resolve());"
+             "derive(Promise.resolve());"
+             "%" +
+             optimize + "(derive);")
+                .c_str());
+
+      Local<Object> creating_tag = Object::New(isolate());
+      {
+        Isolate::PromiseContextScope scope(isolate(), creating_tag);
+        RunJS("var derived = derive(new Promise(() => {}));");
+      }
+      // The deriver must have run optimized for the check below to mean
+      // anything.
+      ASSERT_TRUE(RunJS(("%" + active_tier + "(derive)").c_str())->IsTrue());
+
+      RunJS("var followedTag = undefined;");
+      {
+        Isolate::PromiseContextScope scope(isolate(), Object::New(isolate()));
+        RunJS("derived.then(() => {});");
+      }
+      EXPECT_TRUE(RunJS("followedTag")->StrictEquals(creating_tag));
+    }
+  }
+};
+
+TEST_F(PromiseContextTagTest, MaglevTagsPromises) {
+  if (!i::v8_flags.maglev) GTEST_SKIP() << "Maglev is disabled";
+  ExpectOptimizedDerivedPromisesTagged("OptimizeMaglevOnNextCall",
+                                       "ActiveTierIsMaglev");
+}
+
+TEST_F(PromiseContextTagTest, TurbofanTagsPromises) {
+  if (!i::v8_flags.turbofan) GTEST_SKIP() << "TurboFan is disabled";
+  ExpectOptimizedDerivedPromisesTagged("OptimizeFunctionOnNextCall",
+                                       "ActiveTierIsTurbofan");
+}
