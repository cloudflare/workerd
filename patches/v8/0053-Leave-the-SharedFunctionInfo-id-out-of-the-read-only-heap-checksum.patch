+namespace {
+// The checksum of the read-only heap image a read-only snapshot holds: its payload without the
+// leading SharedFunctionInfo id, which is the serializing isolate's and not heap content.
+uint32_t ReadOnlyHeapImageChecksum(SnapshotData* read_only_snapshot_data) {
+  base::Vector<const uint8_t> payload = read_only_snapshot_data->Payload();
+  CHECK_GE(payload.size(), ReadOnlyArtifacts::kNextUniqueSfiIdSize);
+  return Checksum(
+      payload.SubVector(ReadOnlyArtifacts::kNextUniqueSfiIdSize, payload.size()));
+}
+}  // namespace
+
+// static
+uint32_t ReadOnlyArtifacts::NextUniqueSfiIdOf(
+    SnapshotData* read_only_snapshot_data) {
+  base::Vector<const uint8_t> payload = read_only_snapshot_data->Payload();
+  CHECK_GE(payload.size(), kNextUniqueSfiIdSize);
+  uint32_t id;
+  memcpy(&id, payload.begin(), kNextUniqueSfiIdSize);
+  return id;
+}
+
 void ReadOnlyArtifacts::InitializeChecksum(
     SnapshotData* read_only_snapshot_data) {
 #ifdef DEBUG
-  read_only_blob_checksum_ = Checksum(read_only_snapshot_data->Payload());
+  read_only_blob_checksum_ = ReadOnlyHeapImageChecksum(read_only_snapshot_data);
 #endif  // DEBUG
 }
 
