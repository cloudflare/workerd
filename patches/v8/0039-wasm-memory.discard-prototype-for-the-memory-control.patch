+int32_t memory_discard_wrapper(Address trusted_data_addr, uint32_t mem_index,
+                               uintptr_t dst, uintptr_t size) {
+  DisallowGarbageCollection no_gc;
+
+  Tagged<WasmTrustedInstanceData> trusted_data =
+      TrustedCast<WasmTrustedInstanceData>(Tagged<Object>{trusted_data_addr});
+
+  static_assert(kMemoryDiscardSuccess == kMemOpSuccess);
+  static_assert(kMemoryDiscardOutOfBounds == kOutOfBounds);
+  if ((dst | size) % kWasmPageSize != 0) return kMemoryDiscardUnaligned;
+  uint64_t mem_size = trusted_data->memory_size(mem_index);
+  if (!base::IsInBounds<uint64_t>(dst, size, mem_size)) {
+    return kMemoryDiscardOutOfBounds;
+  }
+  if (size == 0) return kMemoryDiscardSuccess;
+
+  // Funnel through the BackingStore member so all discard paths (JS API,
+  // jitted opcode, interpreter) share a single point.
+  trusted_data->memory_object(mem_index)->backing_store()->DiscardWasmMemory(
+      Isolate::Current(), static_cast<size_t>(dst), static_cast<size_t>(size));
+  return kMemoryDiscardSuccess;
+}
