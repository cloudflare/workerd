+bool WasmJs::InstallMemoryDiscard(Isolate* isolate,
+                                  DirectHandle<NativeContext> context,
+                                  DirectHandle<JSObject> webassembly) {
+  DCHECK(webassembly->map()->is_extensible());
+
+  // Install WebAssembly.Memory.prototype.discard().
+  DirectHandle<JSFunction> memory_constructor(
+      Cast<JSFunction>(context->wasm_memory_constructor()), isolate);
+  DirectHandle<JSObject> memory_proto(
+      Cast<JSObject>(memory_constructor->instance_prototype()), isolate);
+  DirectHandle<String> discard_string = v8_str(isolate, "discard");
+  if (JSObject::HasRealNamedProperty(isolate, memory_proto, discard_string)
+          .FromMaybe(true)) {
+    return false;
+  }
+  InstallFunc(isolate, memory_proto, "discard", wasm::WebAssemblyMemoryDiscard,
+              2);
+  return true;
+}
