index 6241b08aef54512e14ae407ea71af1afd4006e24..3dca7c846836e479b0ecb92124aedc7783843903 100644
--- a/include/v8-callbacks.h
+++ b/include/v8-callbacks.h
@@ -338,6 +338,21 @@ using WasmLoadSourceMapCallback = Local<String> (*)(Isolate* isolate,
 // --- Callback for checking if WebAssembly Custom Descriptors are enabled ---
 using WasmCustomDescriptorsEnabledCallback = bool (*)(Local<Context> context);
 
+// --- Callback for checking if WebAssembly memory.discard is enabled ---
+using WasmMemoryDiscardEnabledCallback = bool (*)(Local<Context> context);
+
+// --- Callback before memory.discard releases physical pages to the OS ---
+// Returning false declines the release: the range is zeroed instead, which
+// still satisfies memory.discard semantics, since returning pages to the OS
+// is advisory and reading back as zeroes is the only guarantee. This lets an
+// embedder rate limit the page-table work (TLB shootdowns) that a release
+// costs the process.
+//
+// Called with no GC allowed, possibly from jitted code: implementations must
+// not allocate on the V8 heap, enter JavaScript, or trigger a GC.
+using BeforeWasmMemoryDiscardCallback = bool (*)(Isolate* isolate,
+                                                 size_t bytes);
+
 // --- Callback for checking if the SharedArrayBuffer constructor is enabled ---
 using SharedArrayBufferConstructorEnabledCallback =
     bool (*)(Local<Context> context);
