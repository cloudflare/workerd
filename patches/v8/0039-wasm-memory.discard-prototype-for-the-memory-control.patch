+void BackingStore::DiscardWasmMemory(Isolate* isolate, size_t offset,
+                                     size_t size) {
+  DCHECK(is_wasm_memory());
+  DCHECK(!is_shared());
+  DCHECK_EQ(0, offset % wasm::kWasmPageSize);
+  DCHECK_EQ(0, size % wasm::kWasmPageSize);
+  DCHECK(base::IsInBounds<size_t>(offset, size, byte_length()));
+  if (size == 0) return;
+
+  void* address = reinterpret_cast<uint8_t*>(buffer_start_) + offset;
+
+  // Let the embedder decline the physical release, which is what costs the
+  // page-table work. Zeroing alone is still a conforming discard.
+  v8::BeforeWasmMemoryDiscardCallback callback =
+      isolate->before_wasm_memory_discard_callback();
+  if (callback != nullptr &&
+      !callback(reinterpret_cast<v8::Isolate*>(isolate), size)) {
+    memset(address, 0, size);
+    return;
+  }
+
+  DiscardWasmMemoryPages(address, size);
+}
+
+// static
+void BackingStore::DiscardWasmMemoryPages(void* address, size_t size) {
+  auto* page_allocator = GetPlatformPageAllocator();
+  DCHECK_EQ(0, reinterpret_cast<uintptr_t>(address) %
+                   page_allocator->CommitPageSize());
+  DCHECK_EQ(0, size % page_allocator->CommitPageSize());
+#if V8_OS_LINUX
+  // On Linux, madvise(MADV_DONTNEED) on a private anonymous mapping releases
+  // the physical pages and guarantees zero-fill-on-demand on the next access,
+  // without any window where the pages are inaccessible.
+  CHECK(page_allocator->DiscardSystemPages(address, size));
+#else
+  // Elsewhere, decommit and recommit: this guarantees the region reads back
+  // as zeroes (DiscardSystemPages does not, e.g. MADV_FREE_REUSABLE on macOS
+  // and DiscardVirtualMemory on Windows preserve contents until reclaim).
+  // The pages are briefly inaccessible, which is fine as non-shared wasm
+  // memory is only accessed by the owning thread.
+  CHECK(page_allocator->DecommitPages(address, size));
+  CHECK(
+      SetPermissions(page_allocator, address, size, PageAllocator::kReadWrite));
+#endif
+}
