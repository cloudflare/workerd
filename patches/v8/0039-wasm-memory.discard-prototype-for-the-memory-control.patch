+TEST_F(ApiWasmTest, WasmEnableDisableMemoryDiscard) {
+  HandleScope scope(isolate());
+  Local<Context> context_local = Context::New(isolate());
+  Context::Scope context_scope(context_local);
+  i::DirectHandle<i::NativeContext> context =
+      v8::Utils::OpenDirectHandle(*context_local);
+
+  EXPECT_FALSE(i_isolate()->IsWasmMemoryDiscardEnabled(context));
+  {
+    // Test enabling via flag.
+    i::FlagScope<bool> flag(&i::v8_flags.wasm_memory_discard, true);
+    EXPECT_TRUE(i_isolate()->IsWasmMemoryDiscardEnabled(context));
+  }
+
+  // Not installed at context creation without the flag.
+  EXPECT_TRUE(RunJS("typeof WebAssembly.Memory.prototype.discard")
+                  ->StrictEquals(NewString("undefined")));
+
+  // Test enabling via callback.
+  isolate()->SetWasmMemoryDiscardEnabledCallback([](auto) { return true; });
+  EXPECT_TRUE(i_isolate()->IsWasmMemoryDiscardEnabled(context));
+  EXPECT_TRUE(i::wasm::WasmEnabledFeatures::FromIsolate(i_isolate())
+                  .has_memory_discard());
+
+  // Per-context install through InstallConditionalFeatures.
+  isolate()->InstallConditionalFeatures(context_local);
+  EXPECT_TRUE(RunJS("typeof WebAssembly.Memory.prototype.discard")
+                  ->StrictEquals(NewString("function")));
+  // Re-running is idempotent.
+  isolate()->InstallConditionalFeatures(context_local);
+  RunJS("new WebAssembly.Memory({initial: 1}).discard(0, 65536)");
+
+  isolate()->SetWasmMemoryDiscardEnabledCallback([](auto) { return false; });
+  EXPECT_FALSE(i_isolate()->IsWasmMemoryDiscardEnabled(context));
+  EXPECT_FALSE(i::wasm::WasmEnabledFeatures::FromIsolate(i_isolate())
+                   .has_memory_discard());
+}
