+(function TestMemoryDiscardJSApiMemory64() {
+  print(arguments.callee.name);
+  const memory = new WebAssembly.Memory({initial: 3n, address: 'i64'});
+  fillMemory(memory, 0, 3 * kPageSize, 0x42);
+  memory.discard(BigInt(kPageSize), BigInt(kPageSize));
+  checkMemory(memory, 0, kPageSize, 0x42);
+  checkMemory(memory, kPageSize, kPageSize, 0);
+  checkMemory(memory, 2 * kPageSize, kPageSize, 0x42);
+  // Number arguments are rejected for memory64.
+  assertThrows(() => memory.discard(0, kPageSize), TypeError);
+  assertThrows(() => memory.discard(0n, BigInt(4 * kPageSize)), RangeError,
+               /exceeds memory bounds/);
+  // Aligned offset + size that overflows uint64 must be out of bounds, not
+  // wrap.
+  assertThrows(
+      () => memory.discard(2n ** 64n - BigInt(kPageSize),
+                           BigInt(2 * kPageSize)),
+      RangeError, /exceeds memory bounds/);
+})();
+
+function buildDiscardModule(is_memory64) {
+  const builder = new WasmModuleBuilder();
+  const sig = is_memory64 ? makeSig([kWasmI64, kWasmI64], []) : kSig_v_ii;
+  if (is_memory64) {
+    builder.addMemory64(4, 4);
+  } else {
+    builder.addMemory(4, 4);
+  }
+  builder.exportMemoryAs('memory', 0);
+  builder.addFunction('discard', sig)
+      .addBody([
+        kExprLocalGet, 0,  // offset
+        kExprLocalGet, 1,  // size
+        kNumericPrefix, kExprMemoryDiscard, 0
+      ])
+      .exportFunc();
+  return builder.instantiate();
+}
+
+function testDiscardInstruction(is_memory64) {
+  const instance = buildDiscardModule(is_memory64);
+  const memory = instance.exports.memory;
+  const idx = is_memory64 ? (v) => BigInt(v) : (v) => v;
+
+  for (let tier_up of [false, true]) {
+    // No Liftoff code to tier up under --wasm-jitless.
+    if (tier_up && % IsLiftoffFunction(instance.exports.discard)) {
+      % WasmTierUpFunction(instance.exports.discard);
+    }
+
+    fillMemory(memory, 0, 4 * kPageSize, 0x7f);
+    instance.exports.discard(idx(kPageSize), idx(2 * kPageSize));
+    checkMemory(memory, 0, kPageSize, 0x7f);
+    checkMemory(memory, kPageSize, 2 * kPageSize, 0);
+    checkMemory(memory, 3 * kPageSize, kPageSize, 0x7f);
+
+    // Zero-size discards are no-ops, also at the memory boundary.
+    instance.exports.discard(idx(0), idx(0));
+    instance.exports.discard(idx(4 * kPageSize), idx(0));
+    checkMemory(memory, 0, kPageSize, 0x7f);
+
+    // Unaligned offset or size traps.
+    assertTraps(kTrapUnalignedAccess,
+                () => instance.exports.discard(idx(1), idx(kPageSize)));
+    assertTraps(kTrapUnalignedAccess,
+                () => instance.exports.discard(idx(0), idx(kPageSize + 1)));
+    // Out-of-bounds traps.
+    assertTraps(kTrapMemOutOfBounds,
+                () => instance.exports.discard(idx(0), idx(5 * kPageSize)));
+    assertTraps(kTrapMemOutOfBounds,
+                () => instance.exports.discard(idx(4 * kPageSize),
+                                               idx(kPageSize)));
+    assertTraps(kTrapMemOutOfBounds,
+                () => instance.exports.discard(idx(5 * kPageSize), idx(0)));
+    // Unaligned and out-of-bounds: the alignment check comes first.
+    assertTraps(kTrapUnalignedAccess,
+                () => instance.exports.discard(idx(5 * kPageSize), idx(1)));
+    // Aligned offset + size overflowing the address type must trap out of
+    // bounds, not wrap.
+    const kMaxAddress = is_memory64 ? 2n ** 64n : 2 ** 32;
+    assertTraps(kTrapMemOutOfBounds,
+                () => instance.exports.discard(
+                    idx(kMaxAddress - idx(kPageSize)), idx(2 * kPageSize)));
+    // Memory is unchanged by trapped discards.
+    checkMemory(memory, 0, kPageSize, 0x7f);
+  }
+}
+
+(function TestMemoryDiscardInstruction() {
+  print(arguments.callee.name);
+  testDiscardInstruction(false);
+})();
