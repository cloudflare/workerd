+namespace {
+size_t before_discard_bytes = 0;
+int before_discard_calls = 0;
+bool before_discard_result = true;
+bool BeforeDiscardCallback(Isolate*, size_t bytes) {
+  before_discard_calls++;
+  before_discard_bytes = bytes;
+  return before_discard_result;
+}
+}  // namespace
+
+TEST_F(ApiWasmTest, BeforeWasmMemoryDiscardCallback) {
+  i::FlagScope<bool> flag(&i::v8_flags.wasm_memory_discard, true);
+  HandleScope scope(isolate());
+  Local<Context> context = Context::New(isolate());
+  Context::Scope context_scope(context);
+
+  isolate()->SetBeforeWasmMemoryDiscardCallback(BeforeDiscardCallback);
+
+  RunJS(
+      "globalThis.mem = new WebAssembly.Memory({initial: 2});"
+      "globalThis.view = new Uint8Array(mem.buffer);"
+      "view.fill(0xab);");
+
+  // Accepted discard: callback consulted, region zeroed.
+  before_discard_result = true;
+  RunJS("mem.discard(0, 65536)");
+  EXPECT_EQ(1, before_discard_calls);
+  EXPECT_EQ(65536u, before_discard_bytes);
+  EXPECT_TRUE(
+      RunJS("view[0] === 0 && view[65535] === 0 && view[65536] === 0xab")
+          ->IsTrue());
+
+  // Declined discard: the region is still zeroed, just not released.
+  RunJS("view.fill(0xcd);");
+  before_discard_result = false;
+  RunJS("mem.discard(65536, 65536)");
+  EXPECT_EQ(2, before_discard_calls);
+  EXPECT_EQ(65536u, before_discard_bytes);
+  EXPECT_TRUE(
+      RunJS("view[0] === 0xcd && view[65536] === 0 && view[131071] === 0")
+          ->IsTrue());
+
+  // Zero-size discards do not consult the callback.
+  RunJS("mem.discard(0, 0)");
+  EXPECT_EQ(2, before_discard_calls);
+
+  isolate()->SetBeforeWasmMemoryDiscardCallback(nullptr);
+}
