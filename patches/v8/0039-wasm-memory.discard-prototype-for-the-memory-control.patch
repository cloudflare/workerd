diff --git a/test/mjsunit/wasm/memory-discard-rss.js b/test/mjsunit/wasm/memory-discard-rss.js
new file mode 100644
index 0000000000000000000000000000000000000000..c884bf35cc64b9dd06a6a87c968e307b1e7115de
--- /dev/null
+++ b/test/mjsunit/wasm/memory-discard-rss.js
@@ -0,0 +1,49 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --experimental-wasm-memory-discard --enable-os-system
+
+// Verifies that discarding actually releases physical pages back to the
+// operating system, which is the entire point of memory.discard. Skips on
+// platforms without procfs.
+
+function rssBytes() {
+  // /proc/self inside the spawned shell is the shell itself; $PPID is d8.
+  const statm = os.system('sh', ['-c', 'cat /proc/$PPID/statm 2>/dev/null']);
+  const fields = statm.split(' ');
+  if (fields.length < 2) return -1;
+  return parseInt(fields[1]) * 4096;
+}
+
+const kPageSize = 65536;
+const kPages = 1024;  // 64 MB
+const kTotalBytes = kPages * kPageSize;
+
+let canMeasure = true;
+try {
+  if (rssBytes() <= 0) canMeasure = false;
+} catch (e) {
+  canMeasure = false;
+}
+
+if (!canMeasure) {
+  print('Skipped: cannot measure RSS on this platform');
+} else {
+  const memory = new WebAssembly.Memory({initial: kPages});
+  const view = new Uint8Array(memory.buffer);
+  const before = rssBytes();
+  view.fill(0x55);
+  const touched = rssBytes() - before;
+  memory.discard(0, kTotalBytes);
+  const released = before + touched - rssBytes();
+  print(`touched: ${touched} bytes, released: ${released} bytes`);
+  // Filling must have made the pages resident, and discarding must have
+  // released the physical pages (allow slack for unrelated allocations).
+  assertTrue(touched >= 0.75 * kTotalBytes, 'pages became resident');
+  assertTrue(released >= 0.75 * kTotalBytes, 'pages were released');
+  // The memory reads back as zeroes and is still writable.
+  assertEquals(0, view[kTotalBytes - 1]);
+  view[0] = 1;
+  assertEquals(1, view[0]);
+}
