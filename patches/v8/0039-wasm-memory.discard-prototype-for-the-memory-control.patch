+// WebAssembly.Memory.discard(byteOffset, byteLength) -> undefined
+// Zeroes the given region of memory and releases its physical pages back to
+// the operating system. Offset and length must be wasm-page aligned.
+void WebAssemblyMemoryDiscardImpl(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  WasmJSApiScope js_api_scope{info, "WebAssembly.Memory.discard()"};
+  auto [isolate, i_isolate, thrower] = js_api_scope.isolates_and_thrower();
+  Local<Context> context = isolate->GetCurrentContext();
+  EXTRACT_THIS(receiver, WasmMemoryObject);
+
+  std::optional<uint64_t> maybe_offset = AddressValueToU64(
+      &thrower, context, info[0], "Argument 0", receiver->address_type());
+  if (!maybe_offset) return js_api_scope.AssertException();
+  uint64_t offset = *maybe_offset;
+  std::optional<uint64_t> maybe_size = AddressValueToU64(
+      &thrower, context, info[1], "Argument 1", receiver->address_type());
+  if (!maybe_size) return js_api_scope.AssertException();
+  uint64_t size = *maybe_size;
+
+  i::Managed<i::BackingStore>::Ptr backing_store = receiver->backing_store();
+
+  if (!backing_store->is_wasm_memory()) {
+    thrower.TypeError("Cannot discard asm.js memory");
+    return;
+  }
+  if (backing_store->is_shared()) {
+    thrower.TypeError("Cannot discard shared memory");
+    return;
+  }
+  if ((offset | size) % i::wasm::kWasmPageSize != 0) {
+    thrower.RangeError(
+        "Offset and length must be multiples of the memory page size");
+    return;
+  }
+  uint64_t byte_length = backing_store->byte_length();
+  if (!base::IsInBounds<uint64_t>(offset, size, byte_length)) {
+    thrower.RangeError("Discarded region exceeds memory bounds");
+    return;
+  }
+
+  backing_store->DiscardWasmMemory(i_isolate, static_cast<size_t>(offset),
+                                   static_cast<size_t>(size));
+}
