@@ -0,0 +1,294 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --experimental-wasm-memory-discard --allow-natives-syntax
+
+d8.file.execute("test/mjsunit/wasm/wasm-module-builder.js");
+
+// kPageSize (64k) is provided by wasm-module-builder.js.
+
+function fillMemory(memory, offset, size, value) {
+  new Uint8Array(memory.buffer, offset, size).fill(value);
+}
+
+function checkMemory(memory, offset, size, value) {
+  const view = new Uint8Array(memory.buffer, offset, size);
+  for (let i = 0; i < size; i += 4243) {
+    assertEquals(value, view[i], `byte at ${offset + i}`);
+  }
+  assertEquals(value, view[size - 1], `byte at ${offset + size - 1}`);
+}
+
+(function TestMemoryDiscardJSApi() {
+  print(arguments.callee.name);
+  const memory = new WebAssembly.Memory({initial: 4});
+  assertEquals('function', typeof memory.discard);
+
+  fillMemory(memory, 0, 4 * kPageSize, 0xab);
+  assertEquals(undefined, memory.discard(kPageSize, 2 * kPageSize));
+  checkMemory(memory, 0, kPageSize, 0xab);
+  checkMemory(memory, kPageSize, 2 * kPageSize, 0);
+  checkMemory(memory, 3 * kPageSize, kPageSize, 0xab);
+
+  // Zero-sized discards, including at the end of memory, are no-ops.
+  memory.discard(0, 0);
+  memory.discard(4 * kPageSize, 0);
+  checkMemory(memory, 0, kPageSize, 0xab);
+
+  // Discarding the whole memory works.
+  memory.discard(0, 4 * kPageSize);
+  checkMemory(memory, 0, 4 * kPageSize, 0);
+})();
+
+(function TestMemoryDiscardJSApiErrors() {
+  print(arguments.callee.name);
+  const memory = new WebAssembly.Memory({initial: 2});
+  // Unaligned offset / size.
+  assertThrows(() => memory.discard(1, kPageSize), RangeError,
+               /multiples of the memory page size/);
+  assertThrows(() => memory.discard(0, kPageSize + 1), RangeError,
+               /multiples of the memory page size/);
+  // Out of bounds.
+  assertThrows(() => memory.discard(0, 3 * kPageSize), RangeError,
+               /exceeds memory bounds/);
+  assertThrows(() => memory.discard(2 * kPageSize, kPageSize), RangeError,
+               /exceeds memory bounds/);
+  assertThrows(() => memory.discard(3 * kPageSize, 0), RangeError,
+               /exceeds memory bounds/);
