+bool WasmInterpreterRuntime::MemoryDiscard(const uint8_t*& current_code,
+                                           uint32_t memory_index, uint64_t dst,
+                                           uint64_t size) {
+  if ((dst | size) % kWasmPageSize != 0) {
+    SetTrap(MessageTemplate::kWasmTrapUnalignedAccess, current_code);
+    return false;
+  }
+  uint64_t mem_size = GetMemorySize(memory_index);
+  if (!base::IsInBounds<uint64_t>(dst, size, mem_size)) {
+    SetTrap(MessageTemplate::kWasmTrapMemOutOfBounds, current_code);
+    return false;
+  }
+  if (size == 0) return true;
+
+  wasm_trusted_instance_data()
+      ->memory_object(memory_index)
+      ->backing_store()
+      ->DiscardWasmMemory(isolate_, static_cast<size_t>(dst),
+                          static_cast<size_t>(size));
+  return true;
+}
