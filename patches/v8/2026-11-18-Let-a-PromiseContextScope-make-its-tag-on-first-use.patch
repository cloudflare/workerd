diff --git a/src/heap/factory.cc b/src/heap/factory.cc
index 055690fc81af503d60661a3fb10c9e85b6abc7a1..4ba5bf5e529fd4047e8f8c8c9da05c9a92605674 100644
--- a/src/heap/factory.cc
