diff --git a/include/v8-isolate.h b/include/v8-isolate.h
index 30a70b49587be3f9dba70ea87ba5f44b98680ca0..1d0630cfd9102115bb0f94f9715b884a7ef7ad18 100644
--- a/include/v8-isolate.h
+++ b/include/v8-isolate.h
@@ -2011,6 +2011,17 @@ MaybeLocal<T> Isolate::GetDataFromSnapshotOnce(size_t index) {
 class Isolate::PromiseContextScope {
  public:
   PromiseContextScope(Isolate* isolate, v8::Local<v8::Object> tag);
+
+  /**
+   * Makes the tag only when the first promise is created in this scope, by
+   * calling `factory(isolate, data)`, which must return a non-empty object and
+   * must not run JavaScript. That tag then serves every promise created later
+   * in the scope. Until then, a promise from any other scope is treated as
+   * coming from another context. For a scope in which no promise may be
+   * created, this saves making a tag at all.
+   */
+  using TagFactory = Local<Object> (*)(Isolate* isolate, void* data);
+  PromiseContextScope(Isolate* isolate, TagFactory factory, void* data);
   ~PromiseContextScope();
   PromiseContextScope(const PromiseContextScope&) = delete;
   PromiseContextScope(PromiseContextScope&&) = delete;
diff --git a/src/api/api.cc b/src/api/api.cc
index b65302af06294fb1e45baea617f4f0df0c1c08a0..b43757e1848e86647b7ec1517240111f33f95c5a 100644
--- a/src/api/api.cc
+++ b/src/api/api.cc
@@ -12890,6 +12890,15 @@ Isolate::PromiseContextScope::PromiseContextScope(Isolate* isolate,
   isolate_->set_promise_context_tag(handle);
 }
 
+Isolate::PromiseContextScope::PromiseContextScope(Isolate* isolate,
+                                                  TagFactory factory,
+                                                  void* data)
+    : isolate_(reinterpret_cast<i::Isolate*>(isolate)) {
+  DCHECK(!isolate_->has_promise_context_tag());
+  DCHECK_NOT_NULL(factory);
+  isolate_->set_deferred_promise_context_tag(factory, data);
+}
+
 Isolate::PromiseContextScope::~PromiseContextScope() {
   isolate_->clear_promise_context_tag();
 }
