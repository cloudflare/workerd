diff --git a/src/builtins/promise-misc.tq b/src/builtins/promise-misc.tq
index b0b4a18e00faffe2efb7ce807e7ab609adc1ff1d..4365be87c224ae21f51c275b8f0e7a3d3765a755 100644
--- a/src/builtins/promise-misc.tq
+++ b/src/builtins/promise-misc.tq
@@ -31,6 +31,21 @@ extern macro PromiseBuiltinsAssembler::IsIsolatePromiseHookEnabled(uint32):
 extern macro PromiseBuiltinsAssembler::PromiseHookFlags(): uint32;
 extern macro LoadPromiseContextTag(): Object;
 
+namespace runtime {
+extern runtime PromiseContextTagMake(implicit context: Context)(): Object;
+}
+
+// The tag a promise made now gets. A PromiseContextScope that defers its tag
+// holds undefined until its first promise, so this makes the tag then. Since
+// that allocates, call this before allocating the promise.
+macro GetOrMakePromiseContextTag(implicit context: Context)(): Object {
+  const tag = LoadPromiseContextTag();
+  if (TaggedEqual(tag, Undefined)) {
+    return runtime::PromiseContextTagMake();
+  }
+  return tag;
+}
+
 // Whether following or settling {promise} has to go through the embedder.
 macro NeedsPromiseContextSwitch(promise: JSPromise): bool {
   const tag = promise.context_tag;
@@ -62,11 +77,15 @@ macro PromiseInit(promise: JSPromise): void {
     is_silent: false,
     async_task_id: kInvalidAsyncTaskId
   });
-  promise.context_tag = LoadPromiseContextTag();
+  // A deferred tag was made before the promise was allocated.
+  const tag = LoadPromiseContextTag();
+  dcheck(!TaggedEqual(tag, Undefined));
+  promise.context_tag = tag;
   promise_internal::ZeroOutEmbedderOffsets(promise);
 }
 
 macro InnerNewJSPromise(implicit context: Context)(): JSPromise {
+  const contextTag = GetOrMakePromiseContextTag();
   const promiseFun = *NativeContextSlot(ContextSlot::PROMISE_FUNCTION_INDEX);
   dcheck(Is<JSFunctionWithPrototype>(promiseFun));
   const promiseMap = UnsafeCast<Map>(promiseFun.prototype_or_initial_map);
@@ -83,7 +102,7 @@ macro InnerNewJSPromise(implicit context: Context)(): JSPromise {
     is_silent: false,
     async_task_id: kInvalidAsyncTaskId
   });
-  promise.context_tag = LoadPromiseContextTag();
+  promise.context_tag = contextTag;
   return promise;
 }
 
