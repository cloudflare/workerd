 }
 
 Handle<JSPromise> Factory::NewJSPromiseWithoutHook() {
+  // Made before the promise, since making a deferred tag may allocate.
+  DirectHandle<Object> context_tag = isolate()->GetOrMakePromiseContextTag();
   Handle<JSPromise> promise =
       Cast<JSPromise>(NewJSObject(isolate()->promise_function()));
   DisallowGarbageCollection no_gc;
   Tagged<JSPromise> raw = *promise;
   raw->set_reactions_or_result(Smi::zero(), SKIP_WRITE_BARRIER);
-  raw->set_context_tag(isolate()->heap()->promise_context_tag());
+  raw->set_context_tag(*context_tag);
   raw->set_flags(JSPromise::Flags());
   // TODO(v8) remove once embedder data slots are always zero-initialized.
   InitEmbedderFields(*promise, Smi::zero());
