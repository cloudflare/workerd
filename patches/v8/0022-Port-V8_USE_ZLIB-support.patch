     },
     defines = [
         "GOOGLE3",
@@ -5017,6 +5023,8 @@ v8_library(
         "@highway//:hwy",
         "@fast_float",
         "@simdutf",
+        "@zlib",
+        "@zlib//:compression_utils_portable",
     ],
 )
 
