diff --git a/BUILD.bazel b/BUILD.bazel
index f95c164c629b8c9a9077b2821d14afe2920e8015..e68c2f7dbe04c4934f88187a1914f9b259df99d0 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
