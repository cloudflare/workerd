diff --git a/BUILD.bazel b/BUILD.bazel
index 214bcd2dc166b04fc3ab8d3a034f7a5b8d40714a..a714df90df89e4932f2620ab6afeb60f0d6e5e57 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -170,6 +170,11 @@ v8_flag(name = "v8_enable_verify_predictable")
 
 v8_flag(name = "v8_enable_test_features")
 
+v8_flag(
+    name = "v8_use_zlib",
+    default = True,
+)
+
 v8_flag(name = "v8_wasm_random_fuzzers")
 
 v8_flag(
@@ -551,6 +556,7 @@ v8_config(
         "v8_enable_vtunejit": "ENABLE_VTUNE_JIT_INTERFACE",
         "v8_enable_undefined_double": "V8_ENABLE_UNDEFINED_DOUBLE",
         "v8_use_host_cpu_arm_features": "V8_USE_HOST_CPU_ARM_FEATURES",
+        "v8_use_zlib": "V8_USE_ZLIB",
     },
     defines = [
         "GOOGLE3",
@@ -4948,6 +4954,8 @@ v8_library(
         "@highway//:hwy",
         "@fast_float",
         "@simdutf",
+        "@zlib",
+        "@zlib//:compression_utils_portable",
     ],
 )
 
diff --git a/src/snapshot/snapshot-utils.cc b/src/snapshot/snapshot-utils.cc
