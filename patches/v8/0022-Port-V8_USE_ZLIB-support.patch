diff --git a/BUILD.bazel b/BUILD.bazel
index 364c1237ef4424f41dadd60dc20c123d04bd56bd..1ef24b49b7e116e3acac66e6bb8ad9e7dbf2c23e 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -169,6 +169,11 @@ v8_flag(name = "v8_enable_verify_predictable")
 
