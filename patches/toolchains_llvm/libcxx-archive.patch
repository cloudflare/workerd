diff --git a/toolchain/cc_toolchain_config.bzl b/toolchain/cc_toolchain_config.bzl
index 9cfb012..f72cdad 100644
--- a/toolchain/cc_toolchain_config.bzl
+++ b/toolchain/cc_toolchain_config.bzl
@@ -444,8 +444,12 @@ def cc_toolchain_config(
         print("WARNING: Using libc++ for host architecture while cross compiling, this is " +
               "probably not what you want. Explicitly set standard_libraries to libc++ to silence.")
 
+    # A libc++ archive built for the target (see the libcxx_archive attribute) leaves the
+    # distribution only libc++'s headers, which serve every target.
+    libcxx_archive = compiler_configuration.get("libcxx_archive")
+
     # Darwin has a universal sysroot so the builtin can compile cross-arch.
-    if stdlib == "builtin-libc++" and is_xcompile and not is_darwin_exec_and_target:
+    if stdlib == "builtin-libc++" and is_xcompile and not is_darwin_exec_and_target and not libcxx_archive:
         stdlib = "stdc++"
 
     # "dynamic-stdc++"[-<ver>] is libstdc++ linked dynamically rather than
@@ -509,14 +513,15 @@ def cc_toolchain_config(
             ])
         else:
             # For single-platform builds, we can statically link the bundled
-            # libraries.
-            stdlib_link_libs.extend([
-                "-l:libc++.a",
-                "-l:libc++abi.a",
-            ])
+            # libraries. The libcxx_archive replaces all three; it is linked
+            # by the <name>_nomsan_stdlib feature below.
+            if not libcxx_archive:
+                stdlib_link_libs.extend([
+                    "-l:libc++.a",
+                    "-l:libc++abi.a",
+                ])
             compiler_rt_link_flags = ["-rtlib=compiler-rt"]
-            libunwind_link_flags = [
-                "-l:libunwind.a",
+            libunwind_link_flags = ([] if libcxx_archive else ["-l:libunwind.a"]) + [
                 # To support libunwind.
                 "-lpthread",
                 "-ldl",
@@ -874,11 +879,16 @@ def cc_toolchain_config(
             )
             nomsan_args.append(":" + name + "_nomsan_cxx_args")
         nomsan_link_flags = default_link_search_flags + stdlib_link_libs
+        libcxx_archive_link = stdlib == "builtin-libc++" and libcxx_archive
+        if libcxx_archive_link:
+            nomsan_link_flags = nomsan_link_flags + ["{libcxx_archive}"]
         if nomsan_link_flags:
             cc_args(
                 name = name + "_nomsan_link_args",
                 actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
                 args = nomsan_link_flags,
+                data = [libcxx_archive] if libcxx_archive_link else [],
+                format = {"libcxx_archive": libcxx_archive} if libcxx_archive_link else {},
                 requires_any_of = [":" + name + "_not_msan"],
             )
             nomsan_args.append(":" + name + "_nomsan_link_args")
