diff --git a/src/proto/h1/conn.rs b/src/proto/h1/conn.rs
--- a/src/proto/h1/conn.rs
+++ b/src/proto/h1/conn.rs
@@ -821,11 +821,25 @@
             if self.has_h2_prefix() {
                 return Err(crate::Error::new_version_h2());
             }
-            if let Some(msg) = T::on_error(&err) {
+            if let Some(mut msg) = T::on_error(&err) {
                 // Drop the cached headers so as to not trigger a debug
                 // assert in `write_head`...
                 self.state.cached_headers.take();
-                self.write_head(msg, None);
+                // workerd: the response says what was wrong in a text/plain body (RFC 9110
+                // section 15.5), as kj's HttpServer does: hyper's own description of the error,
+                // which depends only on its kind. `B` is generic, so the text follows the head
+                // in the head buffer rather than going through `write_body`. The head leaves a
+                // body to write unless the request line named HEAD.
+                let explanation = err.to_string();
+                msg.headers.insert(
+                    http::header::CONTENT_TYPE,
+                    HeaderValue::from_static("text/plain"),
+                );
+                self.write_head(msg, Some(BodyLength::Known(explanation.len() as u64)));
+                if let Writing::Body(_) = self.state.writing {
+                    self.io.headers_buf().extend_from_slice(explanation.as_bytes());
+                    self.state.writing = Writing::Closed;
+                }
                 self.state.error = Some(err);
                 return Ok(());
             }
