+
+/// workerd: records the spelling of a header about to be appended to `headers`, for
+/// `preserve_header_case`, unless it is the lowercase name and none of the name's earlier values
+/// has a spelling. The map pairs a name's spellings with its values in order, and a value past
+/// the last spelling of its name is read as spelled as the lowercase name, so a name with a
+/// spelling for any of its values has one for each, and a head whose names are all lowercase, as
+/// many clients send them, carries no map.
+#[cfg(any(feature = "client", feature = "server"))]
+fn record_header_case(
+    map: &mut Option<HeaderCaseMap>,
+    headers: &HeaderMap,
+    name: &HeaderName,
+    slice: &Bytes,
+    (start, end): (usize, usize),
+) {
+    let spelled = map
+        .as_ref()
+        .map_or(0, |map| map.get_all_internal(name).count());
+    if spelled == 0 && slice[start..end] == *name.as_str().as_bytes() {
+        return;
+    }
+    let map = map.get_or_insert_with(HeaderCaseMap::default);
+    for _ in spelled..headers.get_all(name).iter().count() {
+        map.append(name, Bytes::copy_from_slice(name.as_str().as_bytes()));
+    }
+    map.append(name, slice.slice(start..end));
+}
