+                preserve_header_order: false,
+                h09_responses: false,
+                #[cfg(feature = "client")]
+                on_informational: &mut None,
+            };
+            Server::parse(&mut raw, ctx).unwrap().unwrap().head.extensions
+        };
+        let extensions = parse("GET / HTTP/1.1\r\nhost: hyper.rs\r\nx-bread: baguette\r\n\r\n");
+        assert!(extensions.get::<HeaderCaseMap>().is_none());
+
+        let extensions = parse(
+            "GET / HTTP/1.1\r\nhost: hyper.rs\r\nx-bread: a\r\nx-bread: b\r\nX-Bread: c\r\nx-bread: d\r\n\r\n",
+        );
+        let orig_headers = extensions.get::<HeaderCaseMap>().unwrap();
+        assert_eq!(
+            orig_headers
