 pub(crate) const DEFAULT_MAX_HEADERS: usize = 100;
+
+/// workerd: the limit to parse a head with first. A limit above the default would otherwise be
+/// allocated whole for every head, a large allocation for a large limit, so a head is parsed
+/// against the default on the stack first, and against the configured limit only when it has
+/// more headers than that.
+fn first_max_headers(max_headers: Option<usize>) -> Option<usize> {
+    match max_headers {
+        Some(cap) if cap > DEFAULT_MAX_HEADERS => None,
+        max_headers => max_headers,
+    }
+}
