load("@rules_python//python:defs.bzl", "py_test")

# Not small: under load, starting Python alone can exceed the 3 s that .bazelrc gives small tests.
py_test(
    name = "flaky_tests_test",
    srcs = [
        "flaky_tests.py",
        "flaky_tests_test.py",
    ],
    # The test imports flaky_tests.py as a top-level module.
    imports = ["."],
    main = "flaky_tests_test.py",
)

py_test(
    name = "v8_update_test",
    size = "small",
    srcs = [
        "v8_update.py",
        "v8_update_test.py",
    ],
    # The test imports v8_update.py as a top-level module.
    imports = ["."],
    main = "v8_update_test.py",
    # Not run by default: `bazel test //ci:v8_update_test`.
    tags = ["manual"],
    deps = ["//build/deps:jsonc"],
)
