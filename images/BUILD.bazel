load("@rules_multirun//:defs.bzl", "command", "multirun")

# Loading an image runs where the container engine is, as building one does.
_TAGS = [
    "no-remote-exec",
    "requires-container-engine",
]

IMAGES = {
    "container-client-test": "//images/container-client-test:load",
    "proxy-everything": "//images/container-client-test:load-proxy-everything",
}

[
    command(
        name = name,
        command = target,
        tags = _TAGS,
    )
    for (name, target) in IMAGES.items()
]

multirun(
    name = "load_all",
    commands = IMAGES.keys(),
    tags = _TAGS,
)
