"""Declares a base platform with a conditional parent.

The parent is bazelflare's platform if WORKERD_BAZELFLARE is set (by --config=bazelflare), and the
local host platform otherwise. The sanitizer platforms inherit from it, so that the sanitizer
configs combine with --config=bazelflare in either order.
"""

# Set by --config=bazelflare (.bazelrc).
_BAZELFLARE_ENV = "WORKERD_BAZELFLARE"

_LOCAL = str(Label("@platforms//host"))
_BAZELFLARE = str(Label("//build/bazelflare:linux_x86_64"))

def _on_bazelflare(repository_ctx):
    return repository_ctx.getenv(_BAZELFLARE_ENV) == "1"

def _base_target_platform_impl(repository_ctx):
    parent = _BAZELFLARE if _on_bazelflare(repository_ctx) else _LOCAL
    repository_ctx.file("BUILD.bazel", """\
# Generated by //build/bazelflare:base_target_platform.bzl.
platform(
    name = "platform",
    parents = ["{parent}"],
    visibility = ["//visibility:public"],
)
""".format(parent = parent))

    # Its one file depends on the environment, so it isn't worth keeping in a repository cache.
    return repository_ctx.repo_metadata(reproducible = False)

base_target_platform = repository_rule(
    implementation = _base_target_platform_impl,
)
