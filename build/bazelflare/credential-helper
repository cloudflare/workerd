#!/usr/bin/env bash
# Bazel's credential helper for bazelflare (see the bazelflare block in .bazelrc). In a GitHub
# Actions job allowed `id-token: write` it sends the job's OIDC token; anywhere else, the Cloudflare
# Access token for bazelflare's Access application, logging in first if cloudflared has none saved.
# bazelflare verifies either itself. Bazel caches what it prints until the token expires.
set -euo pipefail

# TODO(soon): move with the deployment to a production account.
ACCESS_APP=https://bazelflare-workerd.runtime-playground.workers.dev
OIDC_AUDIENCE=bazelflare-workerd

[[ ${1:-} == get ]] || { echo "usage: $0 get" >&2; exit 2; }
cat >/dev/null # The request names the URI; every bazelflare URI takes the same credentials.

if [[ -n ${ACTIONS_ID_TOKEN_REQUEST_URL:-} ]]; then
  token=$(curl -fsS --retry 3 -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
    "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$OIDC_AUDIENCE" | sed -n 's/.*"value" *: *"\([^"]*\)".*/\1/p')
  header=authorization value="Bearer $token"
else
  command -v cloudflared >/dev/null || {
    echo "bazelflare needs cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/" >&2
    exit 1
  }
  # Without a saved token, log in: cloudflared opens a browser, or prints a URL on a headless
  # machine, and waits for approval (see --credential_helper_timeout in .bazelrc).
  token=$(cloudflared access token -app="$ACCESS_APP" 2>/dev/null) ||
    token=$(cloudflared access login --auto-close --no-verbose "$ACCESS_APP" </dev/null) || {
      echo "Log in to bazelflare first: cloudflared access login $ACCESS_APP" >&2
      exit 1
    }
  header=cf-access-token value=$token
fi
[[ -n $token ]] || { echo "no bazelflare token" >&2; exit 1; }

# The token's exp claim, less a minute, so that Bazel asks again before it lapses.
payload=$(cut -d. -f2 <<<"$token" | tr '_-' '/+')
while ((${#payload} % 4)); do payload+='='; done
exp=$(base64 -d <<<"$payload" 2>/dev/null | sed -n 's/.*"exp" *: *\([0-9]*\).*/\1/p')
expires=$((${exp:-$(($(date +%s) + 300))} - 60))
expires=$(date -u -d "@$expires" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$expires" +%Y-%m-%dT%H:%M:%SZ)

printf '{"headers":{"%s":["%s"]},"expires":"%s"}\n' "$header" "$value" "$expires"
