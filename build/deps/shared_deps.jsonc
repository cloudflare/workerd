{
  "$schema": "deps.schema.json",
  "repositories": [
    //buildifier
    // Version is frozen to avoid to keep formatting consistent.
    {
      "name": "buildifier-linux-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-linux-amd64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-linux-arm64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-linux-arm64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-darwin-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-darwin-amd64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-darwin-arm64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-darwin-arm64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-windows-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-windows-amd64.exe$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    //ruff
    // Version is frozen to keep formatting consistent.
    {
      "name": "ruff-darwin-arm64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-aarch64-apple-darwin.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    {
      "name": "ruff-linux-arm64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-aarch64-unknown-linux-gnu.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    {
      "name": "ruff-linux-amd64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-x86_64-unknown-linux-gnu.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    //clang-format
    // Version is frozen to keep formatting consistent.
    {
      "name": "clang-format-linux-amd64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-linux-amd64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "clang-format-linux-arm64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-linux-arm64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "clang-format-darwin-arm64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-darwin-arm64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "wpt",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "wpt-.*.tar.gz",
      "build_file": "@workerd//:build/BUILD.wpt",
      "freeze_version": "wpt-2e4dc257c",
      "patches": [
        "@workerd//:patches/wpt/0001-disable-virtualenv-for-serve-command.patch"
      ]
    },
    //sqlite
    // Version and hash are frozen because SQLite releases can change behavior that Workers depend
    // on, and the patches usually need rebasing. See patches/sqlite/README.md for how to upgrade.
    {
      "name": "sqlite3",
      "type": "sqlite",
      "build_file": "@workerd//:build/BUILD.sqlite3",
      "freeze_version": "3.54.1",
      "freeze_year": "2026",
      "freeze_sha256": "387e7f6cad4797b17848c07d453dc6606917bb356a6cfe5a3abafd38c240c71b",
      "patches": [
        "@workerd//:patches/sqlite/0001-row-counts-plain.patch",
        "@workerd//:patches/sqlite/0002-macOS-missing-PATH-fix.patch",
        "@workerd//:patches/sqlite/0003-sqlite-complete-early-exit.patch",
        "@workerd//:patches/sqlite/0004-authorizer-rename-to-destination-name.patch",
        "@workerd//:patches/sqlite/0005-legacy-subquery-subtypes.patch"
      ],
      // Before Bazel 9.4.0, Bazel's built-in patcher can't apply multi-file patches that have no
      // `diff` line before each file, such as 0003 and 0004.
      "patch_tool": "patch"
    }
  ]
}
