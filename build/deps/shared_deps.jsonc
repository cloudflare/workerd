{
  "$schema": "deps.schema.json",
  "repositories": [
    // Independent test-only API copies, outside pnpm's optional-peer resolution. These must be
    // shared so embedders that include the generated fragment also get the test repositories.
    {
      "name": "otel_api_1_9",
      "type": "http_archive",
      "url": "https://registry.npmjs.org/@opentelemetry/api/-/api-1.9.0.tgz",
      "integrity": "sha512-3giAOQvZiH5F9bMlMiv8+GSPMeqg0dbaeo58/0SlA9sxSqZhnUtxzX9/2FzyhS9sWQf5S0GJE0AKBrFqjpeYcg==",
      "strip_prefix": "package",
      "build_file": "@workerd//:build/BUILD.opentelemetry-api"
    },
    {
      "name": "otel_api_1_10",
      "type": "http_archive",
      "url": "https://registry.npmjs.org/@opentelemetry/api/-/api-1.10.0.tgz",
      "integrity": "sha512-lMkyes8iHrG+mk6WH7X70MdCLI2RS0FwNBY1PyQ8UemaijE2m5mv5A0Niy3HtbYTFrgkUEQjFMXmSAk2hQDuPQ==",
      "strip_prefix": "package",
      "build_file": "@workerd//:build/BUILD.opentelemetry-api"
    },
    //buildifier
    // Version is frozen to avoid to keep formatting consistent.
    {
      "name": "buildifier-linux-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-linux-amd64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-linux-arm64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-linux-arm64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-darwin-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-darwin-amd64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-darwin-arm64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-darwin-arm64$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    {
      "name": "buildifier-windows-amd64",
      "type": "github_release",
      "owner": "bazelbuild",
      "repo": "buildtools",
      "file_regex": "^buildifier-windows-amd64.exe$",
      "file_type": "executable",
      "freeze_version": "v10.1.0"
    },
    //ruff
    // Version is frozen to keep formatting consistent.
    {
      "name": "ruff-darwin-arm64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-aarch64-apple-darwin.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    {
      "name": "ruff-linux-arm64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-aarch64-unknown-linux-gnu.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    {
      "name": "ruff-linux-amd64",
      "type": "github_release",
      "owner": "astral-sh",
      "repo": "ruff",
      "file_regex": "^ruff-x86_64-unknown-linux-gnu.tar.gz$",
      "build_file_content": "filegroup(name='file', srcs=['ruff'], visibility=['//visibility:public'])",
      "freeze_version": "0.12.1"
    },
    //clang-format
    // Version is frozen to keep formatting consistent.
    {
      "name": "clang-format-linux-amd64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-linux-amd64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "clang-format-linux-arm64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-linux-arm64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "clang-format-darwin-arm64",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "llvm-.*-darwin-arm64-clang-format",
      "file_type": "executable",
      "freeze_version": "llvm-18.1.8"
    },
    {
      "name": "wpt",
      "type": "github_release",
      "owner": "cloudflare",
      "repo": "workerd-tools",
      "file_regex": "wpt-.*.tar.gz",
      "build_file": "@workerd//:build/BUILD.wpt",
      "freeze_version": "wpt-2f17dec1f",
      "patches": [
        "@workerd//:patches/wpt/0001-disable-virtualenv-for-serve-command.patch"
      ]
    }
  ]
}
