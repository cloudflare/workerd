load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

# The sanitizer that instruments the build, set by --config=asan and --config=tsan (.bazelrc). It
# is a flag rather than a constraint of the target platform so that it composes with configs that
# choose the platform, such as bazelflare's. The exec configuration resets it, as it would a
# platform constraint: host tools stay uninstrumented.
string_flag(
    name = "sanitizer",
    build_setting_default = "none",
    scope = "target",
    values = [
        "none",
        "address",
        "thread",
    ],
)

config_setting(
    name = "sanitizer_address",
    flag_values = {":sanitizer": "address"},
)

config_setting(
    name = "sanitizer_thread",
    flag_values = {":sanitizer": "thread"},
)

config_setting(
    name = "sanitizer_thread_linux",
    constraint_values = ["@platforms//os:linux"],
    flag_values = {":sanitizer": "thread"},
)
