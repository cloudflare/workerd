package(default_visibility = ["//visibility:public"])

constraint_setting(name = "sanitizer")

constraint_value(
    name = "sanitizer_address",
    constraint_setting = ":sanitizer",
)

constraint_value(
    name = "sanitizer_thread",
    constraint_setting = ":sanitizer",
)

config_setting(
    name = "sanitizer_thread_linux",
    constraint_values = [
        ":sanitizer_thread",
        "@platforms//os:linux",
    ],
)

# The sanitizer configs' target platforms (.bazelrc). They inherit the cpu and os of the machines
# that run the tests, the client or, with --config=bazelflare, bazelflare's executors, along with
# bazelflare's constraint (see //build/bazelflare:base_target_platform.bzl): the sanitizer Rust
# toolchains in //build/rust are defined per host (Linux x86_64 and aarch64, macOS arm64) and
# selected by toolchain resolution.
platform(
    name = "sanitizer_address_platform",
    constraint_values = [":sanitizer_address"],
    parents = ["@base_target_platform//:platform"],
)

platform(
    name = "sanitizer_thread_platform",
    constraint_values = [":sanitizer_thread"],
    parents = ["@base_target_platform//:platform"],
)
