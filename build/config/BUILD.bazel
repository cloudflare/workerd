load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "repeatable_string_flag", "string_flag")

bool_flag(
    name = "python_snapshots",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "python_snapshots_disabled",
    flag_values = {":python_snapshots": "false"},
    visibility = ["//visibility:public"],
)

# Similar to --run_under flag to be able to run cross-compiled target binaries.
string_flag(
    name = "target_run_under",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

# Dummy config settings for when workerd is built standalone
# These always return false since we don't want prebuilt behavior in standalone workerd
config_setting(
    name = "no_build",
    values = {"define": "never_match=true"},  # This will never match
    visibility = ["//visibility:public"],
)

config_setting(
    name = "prebuilt_binaries_arm64",
    values = {"define": "never_match=true"},  # This will never match
    visibility = ["//visibility:public"],
)

# V8 flags to pass to gen-compile-cache when producing the compile caches
# embedded in the builtin bundles (//src/node, //src/per_isolate, ...).
# Must match the flags used by the consumer when compiling, otherwise flag
# hash will mismatch and it'll be rejected.
repeatable_string_flag(
    name = "compile_cache_v8_flags",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)
