load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "repeatable_string_flag", "string_flag")

bool_flag(
    name = "python_snapshots",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "python_snapshots_disabled",
    flag_values = {":python_snapshots": "false"},
    visibility = ["//visibility:public"],
)

# V8 flags to pass to gen-compile-cache when producing the compile caches
# embedded in the builtin bundles (//src/node, //src/per_isolate, ...).
# Must match the flags used by the consumer when compiling, otherwise flag
# hash will mismatch and it'll be rejected.
repeatable_string_flag(
    name = "compile_cache_v8_flags",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)
