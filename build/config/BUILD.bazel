load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "repeatable_string_flag", "string_flag")

bool_flag(
    name = "python_snapshots",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "python_snapshots_disabled",
    flag_values = {":python_snapshots": "false"},
    visibility = ["//visibility:public"],
)

# Whether the container tests get their images (see //images/container-client-test:images.bzl).
bool_flag(
    name = "container_test_images",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "container_test_images_enabled",
    flag_values = {":container_test_images": "true"},
    visibility = ["//visibility:public"],
)

# Whether the machine that runs the tests has a container engine, for those tagged
# requires-container-engine (see build/test_attrs.bzl). bazelflare's executors have one for
# them, so they are compatible there without this flag.
bool_flag(
    name = "has_container_engine",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "has_container_engine_set",
    flag_values = {":has_container_engine": "true"},
)

selects.config_setting_group(
    name = "container_engine_available",
    match_any = [
        ":has_container_engine_set",
        "//build/bazelflare:on_bazelflare",
    ],
    visibility = ["//visibility:public"],
)

# No platform has this constraint value, so Bazel's error for a requested test that needs a
# container engine where there is none names it (see build/test_attrs.bzl).
constraint_setting(name = "container_engine_requirement")

constraint_value(
    name = "requires_container_engine",
    constraint_setting = ":container_engine_requirement",
    visibility = ["//visibility:public"],
)

# V8 flags to pass to gen-compile-cache when producing the compile caches
# embedded in the builtin bundles (//src/node, //src/per_isolate, ...).
# Must match the flags used by the consumer when compiling, otherwise flag
# hash will mismatch and it'll be rejected.
repeatable_string_flag(
    name = "compile_cache_v8_flags",
    build_setting_default = [],
    visibility = ["//visibility:public"],
)

# The remote executor of the build, if it has larger runners for the links of select binaries (see
# link_exec_properties in //build/bazelflare:exec_properties.bzl).
string_flag(
    name = "link_executor",
    build_setting_default = "",
    values = [
        "",
        "bazelflare",
        "bazelflare-internal",
        "internal-rbe",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "link_on_bazelflare",
    flag_values = {":link_executor": "bazelflare"},
)

config_setting(
    name = "link_on_bazelflare_internal",
    flag_values = {":link_executor": "bazelflare-internal"},
)

config_setting(
    name = "link_on_rbe_ci",
    flag_values = {":link_executor": "internal-rbe"},
)
