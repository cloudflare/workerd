load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

_CACHE_ENTRIES = {
    "LIBCXX_ENABLE_ABI_LINKER_SCRIPT": "OFF",
    "LIBCXX_ENABLE_SHARED": "OFF",
    "LIBCXX_ENABLE_STATIC": "ON",
    "LIBCXX_INCLUDE_BENCHMARKS": "OFF",
    "LIBCXX_INCLUDE_TESTS": "OFF",
    "LIBCXX_INSTALL_HEADERS": "OFF",
    "LIBCXXABI_ENABLE_SHARED": "OFF",
    "LIBCXXABI_ENABLE_STATIC": "ON",
    "LIBCXXABI_INCLUDE_TESTS": "OFF",
    # The shared unwinder does not link the TSan runtime and therefore cannot contain TSan hooks.
    "LIBUNWIND_ADDITIONAL_COMPILE_FLAGS": "-fno-sanitize=thread",
    "LIBUNWIND_ENABLE_SHARED": "ON",
    "LIBUNWIND_ENABLE_STATIC": "OFF",
    "LIBUNWIND_INCLUDE_TESTS": "OFF",
    "LLVM_ENABLE_RUNTIMES": "libcxx;libcxxabi;libunwind",
    "LLVM_INCLUDE_TESTS": "OFF",
}

cmake(
    name = "libcxx",
    cache_entries = select({
        # TSan must observe synchronization in out-of-line libc++ functions such as shared_ptr's
        # weak-count release.
        "@workerd//build/platforms:sanitizer_thread": dict(
            _CACHE_ENTRIES,
            LLVM_USE_SANITIZER = "Thread",
        ),
        "//conditions:default": _CACHE_ENTRIES,
    }),
    env = {
        "CFLAGS": "-Wno-error",
        "CXXFLAGS": "-Wno-error",
    },
    lib_source = ":srcs",
    out_shared_libs = ["libunwind.so.1"],
    out_static_libs = [
        "libc++.a",
        "libc++abi.a",
    ],
    targets = [
        "cxx_experimental",
        "cxx_static",
        "cxxabi_static",
        "unwind_shared",
    ],
    working_directory = "runtimes",
)

cc_library(
    name = "runtimes",
    # A statically-linked unwinder in each shared library cannot propagate exceptions across DSOs.
    deps = [":libcxx"],
)
