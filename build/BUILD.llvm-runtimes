# libc++, libc++abi and libunwind's sources, which //build/toolchain:libcxx compiles into the
# library the Linux toolchain links. The lists follow each library's CMakeLists.txt for Linux, with
# threads, filesystem, localization and the random device enabled, as in LLVM's release builds.

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "libcxx_srcs",
    srcs = ["libcxx/src/" + src for src in [
        "algorithm.cpp",
        "any.cpp",
        "atomic.cpp",
        "barrier.cpp",
        "bind.cpp",
        "call_once.cpp",
        "charconv.cpp",
        "chrono.cpp",
        "condition_variable.cpp",
        "condition_variable_destructor.cpp",
        "error_category.cpp",
        "exception.cpp",
        "expected.cpp",
        "filesystem/directory_entry.cpp",
        "filesystem/directory_iterator.cpp",
        "filesystem/filesystem_clock.cpp",
        "filesystem/filesystem_error.cpp",
        "filesystem/operations.cpp",
        "filesystem/path.cpp",
        "fstream.cpp",
        "functional.cpp",
        "future.cpp",
        "hash.cpp",
        "ios.cpp",
        "ios.instantiations.cpp",
        "iostream.cpp",
        "locale.cpp",
        "memory.cpp",
        "memory_resource.cpp",
        "mutex.cpp",
        "mutex_destructor.cpp",
        "new_handler.cpp",
        "new_helpers.cpp",
        "optional.cpp",
        "ostream.cpp",
        "print.cpp",
        "random.cpp",
        "random_shuffle.cpp",
        "regex.cpp",
        "ryu/d2fixed.cpp",
        "ryu/d2s.cpp",
        "ryu/f2s.cpp",
        "shared_mutex.cpp",
        "stdexcept.cpp",
        "string.cpp",
        "strstream.cpp",
        "system_error.cpp",
        "text_encoding.cpp",
        "thread.cpp",
        "typeinfo.cpp",
        "valarray.cpp",
        "variant.cpp",
        "vector.cpp",
        "verbose_abort.cpp",
    ]],
)

# libc++abi defines operator new and delete, so libc++'s new.cpp is left out, as by default.
filegroup(
    name = "libcxxabi_srcs",
    srcs = ["libcxxabi/src/" + src for src in [
        "abort_message.cpp",
        "cxa_aux_runtime.cpp",
        "cxa_default_handlers.cpp",
        "cxa_demangle.cpp",
        "cxa_exception.cpp",
        "cxa_exception_storage.cpp",
        "cxa_guard.cpp",
        "cxa_handlers.cpp",
        "cxa_personality.cpp",
        "cxa_thread_atexit.cpp",
        "cxa_vector.cpp",
        "cxa_virtual.cpp",
        "fallback_malloc.cpp",
        "private_typeinfo.cpp",
        "stdlib_exception.cpp",
        "stdlib_new_delete.cpp",
        "stdlib_stdexcept.cpp",
        "stdlib_typeinfo.cpp",
    ]],
)

filegroup(
    name = "libunwind_srcs",
    srcs = ["libunwind/src/" + src for src in [
        "Unwind-EHABI.cpp",
        "Unwind-seh.cpp",
        "Unwind-sjlj.c",
        "Unwind-wasm.c",
        "UnwindLevel1-gcc-ext.c",
        "UnwindLevel1.c",
        "UnwindRegistersRestore.S",
        "UnwindRegistersSave.S",
        "libunwind.cpp",
    ]],
)

# What the sources include from their own trees and from LLVM's libc, whose shared utilities
# libc++ uses to parse floating-point numbers.
filegroup(
    name = "hdrs",
    srcs = glob([
        "libc/hdr/**",
        "libc/include/**",
        "libc/shared/**",
        "libc/src/__support/**",
        "libcxx/src/**",
        "libcxxabi/include/**",
        "libcxxabi/src/**",
        "libunwind/include/**",
        "libunwind/src/**",
    ]),
)
