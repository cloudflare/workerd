load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

_CACHE_ENTRIES = {
    # The toolchain's static libunwind is off (see features below), so CMake's test programs, which
    # link the TSan runtime, take GCC's shared unwinder from the sysroot instead.
    "CMAKE_EXE_LINKER_FLAGS": "-unwindlib=libgcc",
    "CMAKE_SHARED_LINKER_FLAGS": "-unwindlib=libgcc",
    "LIBCXX_ENABLE_ABI_LINKER_SCRIPT": "OFF",
    "LIBCXX_ENABLE_SHARED": "OFF",
    "LIBCXX_ENABLE_STATIC": "ON",
    "LIBCXX_INCLUDE_BENCHMARKS": "OFF",
    "LIBCXX_INCLUDE_TESTS": "OFF",
    "LIBCXX_INSTALL_HEADERS": "OFF",
    "LIBCXXABI_ENABLE_SHARED": "OFF",
    "LIBCXXABI_ENABLE_STATIC": "ON",
    "LIBCXXABI_INCLUDE_TESTS": "OFF",
    # The shared unwinder does not link the TSan runtime and therefore cannot contain TSan hooks.
    "LIBUNWIND_ADDITIONAL_COMPILE_FLAGS": "-fno-sanitize=thread",
    "LIBUNWIND_ENABLE_SHARED": "ON",
    "LIBUNWIND_ENABLE_STATIC": "OFF",
    "LIBUNWIND_INCLUDE_TESTS": "OFF",
    "LLVM_ENABLE_RUNTIMES": "libcxx;libcxxabi;libunwind",
    "LLVM_INCLUDE_TESTS": "OFF",
    "Python3_EXECUTABLE": "$(execpath @workerd//build/tools/python:python3)",
}

cmake(
    name = "libcxx",
    # The runtimes' build requires Python, which the action takes from the Python toolchain rather
    # than the host.
    build_data = ["@workerd//build/tools/python:python3"],
    cache_entries = select({
        # TSan must observe synchronization in out-of-line libc++ functions such as shared_ptr's
        # weak-count release.
        "@workerd//build/platforms:sanitizer_thread": dict(
            _CACHE_ENTRIES,
            LLVM_USE_SANITIZER = "Thread",
        ),
        "//conditions:default": _CACHE_ENTRIES,
    }),
    env = {
        "CFLAGS": "-Wno-error",
        "CXXFLAGS": "-Wno-error",
    },
    # Without the C++ toolchain's own runtimes: its libc++ (its <config>_nomsan_stdlib feature),
    # whose headers would otherwise come before those of the libc++ being built, and the libraries
    # it links into everything (default_link_libs), whose static libunwind clashes with the shared
    # one built here.
    features = [
        "-default_link_libs",
        "-local-aarch64-linux_nomsan_stdlib",
        "-local-x86_64-linux_nomsan_stdlib",
    ],
    lib_source = ":srcs",
    out_shared_libs = ["libunwind.so.1"],
    out_static_libs = [
        "libc++.a",
        "libc++abi.a",
    ],
    targets = [
        "cxx_experimental",
        "cxx_static",
        "cxxabi_static",
        "unwind_shared",
    ],
    working_directory = "runtimes",
)

cc_library(
    name = "runtimes",
    # A statically-linked unwinder in each shared library cannot propagate exceptions across DSOs.
    deps = [":libcxx"],
)
