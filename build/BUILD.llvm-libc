load("@rules_cc//cc:cc_library.bzl", "cc_library")

# V8 includes llvm-libc's shared math library as third_party/llvm-libc/src/shared/math.h, and that
# reaches the rest of the headers here from the repository root, so only the shared headers take
# the prefix. Every compile in V8's base library takes these headers as inputs, so they're limited
# to what the shared headers can include.
cc_library(
    name = "llvm-libc",
    hdrs = glob(["shared/**/*.h"]),
    include_prefix = "third_party/llvm-libc/src",
    visibility = ["//visibility:public"],
    deps = [":internal"],
)

cc_library(
    name = "internal",
    hdrs = glob([
        "hdr/**/*.h",
        "include/llvm-libc-macros/**/*.h",
        "include/llvm-libc-types/**/*.h",
        "src/__support/**/*.h",
    ]),
)
