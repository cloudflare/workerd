"""wd_rust_serde_capnp_library definition"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@capnp-cpp//src/capnp:capnp_gen.bzl", "capnp_gen")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:build/wd_rust_crate.bzl", "rust_cxx_bridge", "rust_cxx_include_prefix")

def _output(src):
    # Mirrors output_path() in //src/rust/capnp-serde/capnpc-rust-serde:codegen.rs.
    dir, sep, base = src.rpartition("/")
    return dir + sep + base.removesuffix(".capnp").replace("-", "_") + "_serde.rs"

def _ffi_output(src):
    # Mirrors output_path() in //src/rust/capnp-serde/capnpc-rust-serde:ffi.rs.
    return _output(src).removesuffix(".rs") + "_ffi.rs"

def wd_rust_serde_capnp_library(
        name,
        srcs,
        crate_name = None,
        deps = [],
        ffi = False,
        visibility = None,
        tags = [],
        testonly = False,
        target_compatible_with = None):
    """Rust types with serde derives for the structs, enums and unions of Cap'n Proto schemas.

    The types' JSON is that of the C++ capnp::JsonCodec with handleByAnnotation() (see
    //src/rust/capnp-serde), so Rust can exchange JSON with C++ code that uses that codec, and with
    the services it talks to. Imports of /capnp/c++.capnp and /capnp/compat/json.capnp need no
    deps.

    Args:
        name: target name.
        srcs: .capnp files, which may import those of `deps`.
        crate_name: crate name; defaults to `name` with dashes replaced by underscores.
        deps: wd_rust_serde_capnp_library targets for imported schemas, with default crate names.
        ffi: whether to generate a cxx bridge per schema, through which C++ parses JSON into the
            types and reads them in place (see //src/rust/capnp-serde/capnpc-rust-serde:ffi.rs).
            For foo.capnp, C++ includes <pkg>/foo_serde_ffi.rs.h, where <pkg> is the package's
            C++ include path, and depends on the library. The bridge of foo.capnp is module
            `foo_serde_ffi` of the crate.
        visibility: target visibility.
        tags: target tags.
        testonly: whether only tests may depend on the library.
        target_compatible_with: platform constraints.
    """
    outs = [_output(src) for src in srcs]
    ffi_outs = [_ffi_output(src) for src in srcs] if ffi else []
    if crate_name == None:
        crate_name = name.replace("-", "_")

    capnp_gen(
        name = name + "_gen",
        srcs = srcs,
        deps = [dep + "_gen" for dep in deps],
        outs = outs + ffi_outs,
        capnpc_plugin = "//src/rust/capnp-serde/capnpc-rust-serde:capnpc-rust-serde" + ("-ffi" if ffi else ""),
        src_prefix = "src",
        visibility = visibility,
        tags = tags,
        testonly = testonly,
        target_compatible_with = target_compatible_with,
    )

    lib_rs = name + "_lib.rs"
    write_file(
        name = name + "_lib_rs",
        out = lib_rs,
        content = [_lib_rs_content(name, deps, outs, ffi_outs)],
        tags = tags,
        testonly = testonly,
    )

    cxx_deps = [
        "//src/rust/cxx/kj-rs",
        "//src/rust/cxx:cxx",
    ] if ffi_outs else []
    for ffi_out in ffi_outs:
        rust_cxx_bridge(
            name = ffi_out + "@cxx",
            src = ffi_out,
            include_prefix = rust_cxx_include_prefix(),
            strip_include_prefix = "",
            # A C++ library that includes the header needs the crate too, so it depends on that.
            visibility = ["//visibility:private"],
            deps = cxx_deps,
            tags = tags,
            testonly = testonly,
        )

    rust_library(
        name = name,
        srcs = outs + ffi_outs + [lib_rs],
        crate_name = crate_name,
        crate_root = lib_rs,
        deps = deps + cxx_deps + [
            "//src/rust/capnp-serde",
            "@crates_vendor//:serde",
            "@crates_vendor//:serde_json",
        ],
        link_deps = [ffi_out + "@cxx" for ffi_out in ffi_outs],
        # Generated code: rustc's lints only.
        tags = tags + ["no-clippy"],
        testonly = testonly,
        visibility = visibility,
        target_compatible_with = target_compatible_with,
    )

def _lib_rs_content(name, deps, outs, ffi_outs):
    lines = [
        "//! Generated by wd_rust_serde_capnp_library(name = \"{}\"). DO NOT EDIT.".format(name),
        "#![allow(clippy::all, unused_imports, reason = \"generated code\")]",
    ]

    # Types of imported schemas are named as if they were in this crate.
    for dep in deps:
        lines.append("use ::{}::*;".format(_crate_name_of(dep)))
    for out in outs:
        lines.append("include!(\"{}\");".format(out))

    # cxx reads each bridge from its own file, so they are modules rather than included.
    for ffi_out in ffi_outs:
        lines.append("#[path = \"{}\"]".format(ffi_out))
        lines.append("pub mod {};".format(ffi_out.rpartition("/")[2].removesuffix(".rs")))
    return "\n".join(lines) + "\n"

def _crate_name_of(dep):
    # A macro cannot read a dep's crate name, so deps must have the default one.
    return dep.rpartition(":")[2].replace("-", "_")
