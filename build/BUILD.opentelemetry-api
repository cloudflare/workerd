load("@aspect_rules_js//npm:defs.bzl", "npm_package")

# The unmodified package payload, including its license and both module formats. No install
# scripts run. The consuming test package supplies a local alias and the pinned version.
npm_package(
    name = "pkg",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    include_external_repositories = ["**"],
    publishable = False,
    tags = ["no-downstream"],
    visibility = ["//visibility:public"],
)
